<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<image class="nav-icon-image" src="/static/moments/icon-back.png" mode="aspectFit"></image>
				</view>
				<text class="nav-title">我的动态</text>
				<view class="publish-button" @click="publishMoment">
					<image class="publish-plus-image" src="/static/moments/icon-plus.png" mode="aspectFit"></image>
					<text class="publish-text">发布动态</text>
				</view>
			</view>

			<view class="stats-card">
				<view class="stat-item">
					<text class="stat-value stat-highlight">{{ items.length }}</text>
					<text class="stat-label">已发布</text>
				</view>
				<view class="stat-item">
					<text class="stat-value">{{ likeTotal }}</text>
					<text class="stat-label">获赞</text>
				</view>
				<view class="stat-item">
					<text class="stat-value">{{ commentTotal }}</text>
					<text class="stat-label">评论</text>
				</view>
			</view>

			<view class="section-head">
				<text class="section-title">生活里的小美好</text>
				<text class="section-meta">{{ items.length == 0 ? '0 条动态' : '最新发布' }}</text>
			</view>

			<view v-if="items.length == 0" class="empty-state">
				<image class="empty-image" src="/static/moments/empty.png" mode="aspectFit"></image>
				<text class="empty-title">还没有发布动态</text>
				<text class="empty-desc">练球的进步、咖啡的香气、漫步的风景，</text>
				<text class="empty-desc">把值得记住的日常，留在这里。</text>
				<view class="publish-empty-button" @click="publishMoment">
					<image class="publish-empty-plus-image" src="/static/moments/icon-plus.png" mode="aspectFit"></image>
					<text class="publish-empty-text">发布第一条动态</text>
				</view>
				<text class="empty-tip">用图文或视频，记录你的第一份美好</text>
			</view>

			<view v-else class="moment-grid">
				<view v-for="(item, index) in items" :key="item.id" class="moment-card" :class="index % 2 == 1 ? 'moment-card-right' : ''" @click="openMoment(item.id)">
					<view class="cover-wrap">
						<image class="moment-cover" :src="item.coverImage" mode="aspectFill"></image>
						<view class="media-badge">
							<image class="media-icon-image" :src="item.mediaType == 'video' ? '/static/moments/icon-video.png' : '/static/moments/icon-images.png'" mode="aspectFit"></image>
							<text class="media-label">{{ item.mediaLabel }}</text>
						</view>
					</view>
					<text class="moment-title">{{ item.title }}</text>
					<text class="moment-time">{{ item.publishedAt }}</text>
					<view class="moment-stats">
						<view class="stat-action">
							<image class="stat-icon-image" :src="index == 0 ? '/static/moments/icon-heart-filled.png' : '/static/moments/icon-heart-outline.png'" mode="aspectFit"></image>
							<text class="stat-text">{{ item.likeCount }}</text>
						</view>
						<view class="stat-action">
							<image class="stat-icon-image comment-icon-image" src="/static/moments/icon-comment.png" mode="aspectFit"></image>
							<text class="stat-text">{{ item.commentCount }}</text>
						</view>
					</view>
				</view>
			</view>

			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getMyMomentItems } from '../../services/service-container.uts'
	import type { MyMomentItem } from '../../types/models.uts'

	const items = ref<MyMomentItem[]>(getMyMomentItems(false))
	const likeTotal = ref(0)
	const commentTotal = ref(0)

	function refreshStats() {
		let likes = 0
		let comments = 0
		for (let i = 0; i < items.value.length; i++) {
			likes += items.value[i].likeCount
			comments += items.value[i].commentCount
		}
		likeTotal.value = likes
		commentTotal.value = comments
	}

	refreshStats()

	onLoad((options) => {
		const emptyValue = options['empty'] as string
		items.value = getMyMomentItems(emptyValue == '1' || emptyValue == 'true')
		refreshStats()
	})

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function publishMoment() {
		uni.navigateTo({
			url: '/pages/moment/publish'
		})
	}

	function openMoment(id: string) {
		uni.navigateTo({
			url: '/pages/moment/detail?momentId=' + encodeURIComponent(id.replace('my-moment-', 'moment-'))
		})
	}
</script>

