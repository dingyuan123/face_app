		font-size: 18px;
		font-weight: 600;
		color: $facetof-color-ink;
	}

	.input {
		height: 48px;
		margin-top: 14px;
		padding: 0 14px;
		font-size: 15px;
		color: $facetof-color-ink;
		background-color: $facetof-color-warm-background;
		border: 1px solid $facetof-color-border;
		border-radius: $facetof-radius-control;
	}

	.placeholder {
		color: #B5AAA5;
	}

	.code-row {
		flex-direction: row;
		align-items: center;
	}

	.code-input {
		flex: 1;
	}

	.code-button {
		height: 48px;
		margin-top: 14px;
		margin-left: 10px;
		padding: 0 14px;
		align-items: center;
		justify-content: center;
		background-color: $facetof-color-warm-background;
		border: 1px solid $facetof-color-border;
		border-radius: $facetof-radius-control;
	}

	.code-button-text {
		font-size: 13px;
		color: $facetof-color-primary;
	}

	.agreement {
		flex-direction: row;
		align-items: center;
		margin: 18px 0;
	}

	.checkbox {
		width: 20px;
		height: 20px;
		align-items: center;
		justify-content: center;
		font-size: 13px;
		color: #FFFFFF;
		background-color: $facetof-color-primary;
		border-radius: 6px;
	}

	.agreement-text {
		margin-left: 8px;
		font-size: 12px;
		color: $facetof-color-secondary-text;
	}

	.divider {
		flex-direction: row;
		align-items: center;
		margin: 22px 0 16px;
	}

	.divider-line {
		flex: 1;
		height: 1px;
		background-color: $facetof-color-border;
	}

	.divider-text {
		margin: 0 12px;
		font-size: 12px;
		color: $facetof-color-secondary-text;
	}

	.social-row {
		flex-direction: row;
	}

	.social-button {
		flex: 1;
		height: 46px;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		background-color: $facetof-color-warm-background;
		border: 1px solid $facetof-color-border;
		border-radius: $facetof-radius-control;
	}

	.social-button-secondary {
		margin-left: 10px;
