		line-height: 18px;
		color: $facetof-color-secondary-text;
	}

	.test-grid {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 12px;
	}

	.test-button {
		width: 48%;
		margin: 1% 1% 0 0;
		padding: 12px;
