		flex: 1;
		padding: 32px $facetof-space-page 40px;
		background-color: $facetof-color-warm-background;
	}

	.hero {
		align-items: center;
		margin: 12px 0 28px;
	}

	.logo {
		width: 72px;
		height: 72px;
	}

	.brand {
		margin-top: 10px;
		font-size: 28px;
		font-weight: 700;
		color: $facetof-color-ink;
	}

	.slogan {
		margin-top: 6px;
		font-size: 14px;
		color: $facetof-color-secondary-text;
	}

	.form-card,
	.dev-card {
		padding: $facetof-space-card;
