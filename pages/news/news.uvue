	}

	.tab-indicator {
		position: absolute;
		bottom: 1px;
		width: 24px;
		height: 3px;
		background-image: linear-gradient(to right, #FD5A6B, #FCAE59);
		border-radius: 999px;
	}

	.content-scroll {
		flex: 1;
	}

	.content {
		padding: 12px $facetof-space-page 84px;
	}

	.featured-card {
		position: relative;
		height: 210px;
		margin-bottom: 12px;
		border-radius: $facetof-radius-card;
		overflow: hidden;
	}

	.featured-image {
		width: 100%;
		height: 210px;
	}

	.featured-mask {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 130px;
		background-image: linear-gradient(to bottom, rgba(31, 26, 23, 0), rgba(31, 26, 23, 0.72));
	}

