<template>
	<view class="page">
		<view class="page-head">
			<view>
				<text class="page-title">资讯</text>
				<text class="page-subtitle">发现同城热点与安心指南</text>
			</view>
			<view class="search-button" @click="showSearchTip">
				<text class="search-icon">⌕</text>
			</view>
		</view>

		<segment-tabs
			:items="tabs"
			:active="selectedTab"
			variant="underline"
			@change="changeTab"
		></segment-tabs>

		<scroll-view class="content-scroll" direction="vertical" :show-scrollbar="false">
			<view class="content">
				<view v-if="selectedTab == '推荐' && articles.length > 0" class="featured-card" @click="openArticle(articles[0].id)">
					<image class="featured-image" :src="articles[0].coverImage" mode="aspectFill"></image>
					<view class="featured-mask"></view>
					<view class="featured-copy">
						<status-pill label="今日推荐" tone="warning"></status-pill>
						<text class="featured-title">{{ articles[0].title }}</text>
						<text class="featured-meta">{{ articles[0].readCount }} 人已读 · {{ articles[0].publishedAt }}</text>
					</view>
				</view>

				<view v-if="articles.length == 0" class="empty-state">
					<text class="empty-title">暂时没有相关资讯</text>
					<text class="empty-desc">换一个分类看看吧</text>
				</view>

				<view v-for="article in listArticles" :key="article.id" class="article-card" @click="openArticle(article.id)">
					<view class="article-main">
						<view class="article-head">
							<view class="category-tag">
								<text class="category-text">{{ article.category }}</text>
							</view>
							<text v-if="article.isVideo" class="video-label">视频</text>
						</view>
						<text class="article-title">{{ article.title }}</text>
						<text class="article-summary">{{ article.summary }}</text>
						<text class="article-meta">{{ article.readCount }} 人已读 · {{ article.publishedAt }}</text>
					</view>
					<image class="article-image" :src="article.coverImage" mode="aspectFill"></image>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

	</view>
</template>

<script setup lang="uts">
		import StatusPill from '../../components/status-pill.uvue'
	import { getNewsFeed } from '../../services/service-container.uts'
	import type { NewsArticle } from '../../types/models.uts'

	const tabs = ['推荐', '同城', '安全', '活动']
	const selectedTab = ref('推荐')
	const articles = ref<NewsArticle[]>([])

	function refreshArticles() {
		articles.value = getNewsFeed(selectedTab.value)
	}

	onShow(() => {
		refreshArticles()
	})

	const listArticles = computed(() : Array<NewsArticle> => {
		if (selectedTab.value == '推荐' && articles.value.length > 1) {
			return articles.value.slice(1)
		}
		return articles.value
	})

	function changeTab(tab: string) {
		selectedTab.value = tab
		refreshArticles()
	}

	function showSearchTip() {
		uni.showToast({
			title: '资讯搜索将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openArticle(id: string) {
		uni.showToast({
			title: '资讯详情页将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

</script>

<style lang="scss">
