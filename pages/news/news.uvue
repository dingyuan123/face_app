		position: absolute;
		left: 15px;
		right: 15px;
		bottom: 14px;
	}

	.featured-title {
		margin-top: 8px;
		font-size: 18px;
		font-weight: 700;
		line-height: 25px;
		color: #FFFFFF;
	}

	.featured-meta {
		margin-top: 5px;
		font-size: 10px;
		color: rgba(255, 255, 255, 0.82);
	}

	.article-card {
		flex-direction: row;
		margin-bottom: 11px;
		padding: 13px;
		background-color: $facetof-color-background;
		border: 1px solid $facetof-color-border;
		border-radius: $facetof-radius-card;
	}

	.article-main {
		flex: 1;
		margin-right: 12px;
	}

	.article-head {
		flex-direction: row;
		align-items: center;
	}

	.category-tag {
		padding: 3px 8px;
		background-color: rgba(253, 90, 107, 0.1);
		border-radius: 999px;
	}

	.category-text {
		font-size: 10px;
		color: $facetof-color-primary;
	}

