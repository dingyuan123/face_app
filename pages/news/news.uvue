		padding: 18px $facetof-space-page 12px;
		background-color: $facetof-color-background;
	}

	.page-title {
		font-size: 25px;
		font-weight: 700;
		color: $facetof-color-ink;
	}

	.page-subtitle {
		margin-top: 3px;
		font-size: 11px;
		color: $facetof-color-secondary-text;
	}

	.search-button {
		width: 40px;
		height: 40px;
		align-items: center;
		justify-content: center;
		background-color: $facetof-color-warm-background;
		border: 1px solid $facetof-color-border;
		border-radius: 50%;
	}

	.search-icon {
		font-size: 20px;
		color: $facetof-color-ink;
	}

	.tab-row {
