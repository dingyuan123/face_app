<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">资讯详情</text>
					<view class="nav-button" @click="openMore">
						<text class="nav-icon">···</text>
					</view>
				</view>

				<view class="hero">
					<text class="hero-title">{{ news.title }}</text>
					<text class="hero-subtitle">{{ news.subtitle }}</text>
					<view class="hero-line"></view>
				</view>

				<view class="article-content">
					<text class="category-text">{{ news.category }}</text>

					<view class="author-row">
						<image class="author-avatar" :src="news.authorAvatar" mode="aspectFill"></image>
						<view class="author-main">
							<view class="author-name-row">
								<text class="author-name">{{ news.author }}</text>
								<view v-if="news.verified" class="verified-pill">
									<text class="verified-text">✓ 官方认证</text>
								</view>
							</view>
							<text class="article-meta">{{ news.publishedAt }} · {{ news.readTime }}</text>
						</view>
					</view>

					<view class="article-divider"></view>
					<text class="article-intro">{{ news.intro }}</text>
					<text class="article-section-title">{{ news.sectionTitle }}</text>
					<text class="article-paragraph">{{ news.sectionDescription }}</text>

					<view class="recommend-card" @click="openService">
						<view class="recommend-icon">
							<text class="recommend-icon-text">☕</text>
						</view>
						<view class="recommend-main">
							<text class="recommend-subtitle">{{ news.recommendation.subtitle }}</text>
							<text class="recommend-title">{{ news.recommendation.title }}</text>
							<text class="recommend-price">{{ news.recommendation.price }}</text>
						</view>
						<view class="recommend-arrow">
							<text class="recommend-arrow-text">→</text>
						</view>
					</view>

					<text class="article-paragraph">{{ news.outro }}</text>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="action-bar">
			<view class="comment-box">
				<text class="comment-icon">◌</text>
				<input
					class="comment-input"
					:value="comment"
					placeholder="聊聊你的看法…"
					placeholder-class="comment-placeholder"
					@input="onCommentInput"
				/>
			</view>
			<view class="action-item" @click="toggleLike">
				<text class="action-icon">♡</text>
				<text class="action-count">1.2k</text>
			</view>
			<view class="action-item" @click="toggleFavorite">
				<text class="action-icon">♧</text>
				<text class="action-label">收藏</text>
			</view>
			<view class="action-item" @click="shareArticle">
				<text class="action-icon">↑</text>
				<text class="action-label">分享</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getNewsDetail } from '../../services/service-container.uts'
	import type { NewsDetail } from '../../types/models.uts'

	const news = ref<NewsDetail>(getNewsDetail('news-001'))
	const comment = ref('')
	const liked = ref(false)
	const favorited = ref(false)

	onLoad((options) => {
		const id = options['newsId'] as string
		news.value = getNewsDetail(id != null && id.length > 0 ? decodeURIComponent(id) : 'news-001')
	})

	function onCommentInput(event: InputEvent) {
		comment.value = event.detail.value
	}

	function toggleLike() {
		liked.value = !liked.value
		uni.showToast({
			title: liked.value ? '已点赞' : '已取消点赞',
			position: 'bottom',
			icon: 'success'
		})
	}

	function toggleFavorite() {
		favorited.value = !favorited.value
		uni.showToast({
			title: favorited.value ? '已收藏' : '已取消收藏',
			position: 'bottom',
			icon: 'success'
		})
	}

	function shareArticle() {
		uni.showToast({
			title: '分享能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openService() {
		uni.navigateTo({
			url: '/pages/service/detail?serviceId=' + encodeURIComponent(news.value.recommendation.serviceId)
		})
	}

	function openMore() {
		uni.showToast({
			title: '更多操作将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/news/news'
				})
			}
		})
	}
</script>

