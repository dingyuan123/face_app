<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="profile-hero">
					<view class="hero-top">
						<text class="hero-title">我的</text>
						<view class="settings-button" @click="showSettingTip">
							<text class="settings-icon">⚙</text>
						</view>
					</view>

					<view v-if="profile != null" class="profile-card">
						<image class="profile-avatar" :src="profile.avatar" mode="aspectFill"></image>
						<view class="profile-copy">
							<text class="profile-name">{{ profile.displayName }}</text>
							<text class="profile-meta">{{ profile.city }} · {{ profile.level }}</text>
							<view class="identity-pill">
								<text class="identity-pill-text">{{ identityLabel }}</text>
							</view>
						</view>
						<view class="edit-button" @click="showEditTip">
							<text class="edit-text">编辑资料</text>
						</view>
					</view>

					<view v-else class="guest-card">
						<view class="guest-avatar">
							<text class="guest-avatar-text">Hi</text>
						</view>
						<view class="guest-copy">
							<text class="guest-title">登录后管理你的资料</text>
							<text class="guest-desc">查看订单、收藏、消息和服务者进度</text>
						</view>
						<view class="guest-login" @click="loginForProfile">
							<text class="guest-login-text">登录</text>
						</view>
					</view>
				</view>

				<view v-if="profile != null" class="stats-card">
					<view class="stat-item">
						<text class="stat-value">{{ profile.orderCount }}</text>
						<text class="stat-label">我的订单</text>
					</view>
					<view class="stat-line"></view>
					<view class="stat-item">
						<text class="stat-value">{{ profile.favoriteCount }}</text>
						<text class="stat-label">我的收藏</text>
					</view>
					<view class="stat-line"></view>
					<view class="stat-item">
						<text class="stat-value">{{ profile.followingCount }}</text>
						<text class="stat-label">我的关注</text>
					</view>
				</view>

				<view v-if="profile != null && sessionState.identity == 'user' && sessionState.applicationStatus == 'none'" class="become-provider-card">
					<view class="become-provider-icon">P</view>
					<view class="become-provider-copy">
						<text class="become-provider-title">成为服务者</text>
						<text class="become-provider-desc">提交服务者申请，开启服务者测试流程</text>
					</view>
					<view class="become-provider-button" @click="openProviderApply">
						<text class="become-provider-button-text">去申请</text>
					</view>
				</view>

				<view v-if="sessionState.applicationStatus != 'none'" class="provider-card">
					<view class="provider-card-head">
						<text class="section-title">服务者中心</text>
						<status-pill :label="applicationLabel" :tone="applicationTone"></status-pill>
					</view>
					<text v-if="sessionState.applicationStatus == 'pending'" class="provider-tip">资料已提交，平台正在审核。</text>
					<text v-if="sessionState.applicationStatus == 'rejected'" class="provider-tip reject">审核未通过：{{ sessionState.rejectionReason }}</text>
					<text v-if="sessionState.applicationStatus == 'approved'" class="provider-tip">审核已通过，可进入服务者工作台。</text>
					<view class="provider-action" @click="openProviderCenter">
						<text class="provider-action-text">{{ providerActionLabel }}</text>
						<text class="entry-arrow">›</text>
					</view>
				</view>

				<view class="section-block">
					<text class="section-title">常用功能</text>
					<view class="quick-grid">
						<view v-for="item in quickItems" :key="item.name" class="quick-item" @click="openQuickItem(item.name)">
							<view class="quick-icon" :class="item.tone">
								<text class="quick-icon-text">{{ item.icon }}</text>
							</view>
							<text class="quick-name">{{ item.name }}</text>
						</view>
					</view>
				</view>

				<view class="section-block menu-block">
					<text class="section-title">服务与设置</text>
					<view class="menu-list">
						<view v-for="(item, index) in menuItems" :key="item" :class="index == menuItems.length - 1 ? 'menu-item menu-item-last' : 'menu-item'" @click="openQuickItem(item)">
							<text class="menu-name">{{ item }}</text>
							<text class="entry-arrow">›</text>
						</view>
					</view>
				</view>

				<view v-if="profile != null" class="logout-card" @click="logoutFromProfile">
					<text class="logout-text">退出登录</text>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

	</view>
</template>

<script setup lang="uts">
		import StatusPill from '../../components/status-pill.uvue'
	import { getApplicationHistory, getProfileSummary } from '../../services/service-container.uts'
	import type { ProfileSummary } from '../../types/models.uts'
	import { logout, sessionState } from '../../state/session-state.uts'
	import { openLogin, openProviderApply, PROFILE_ROUTE, ORDER_LIST_ROUTE, FAVORITES_ROUTE, FOLLOWING_ROUTE, SETTINGS_ROUTE, MY_MOMENTS_ROUTE, WALLET_ROUTE, COUPONS_ROUTE, MEMBERSHIP_ROUTE, ID_VERIFY_ROUTE, PROFILE_EDIT_ROUTE, MY_REVIEWS_ROUTE, ABOUT_ROUTE, HELP_ROUTE, PROVIDER_DASHBOARD_ROUTE } from '../../router/route-guard.uts'

	const profile = ref<ProfileSummary | null>(null)

	type QuickItem = {
		name: string,
		icon: string,
		tone: string
	}

	const quickItems: Array<QuickItem> = [
		{ name: '我的订单', icon: '单', tone: 'tone-brand' },
		{ name: '我的收藏', icon: '♡', tone: 'tone-warm' },
		{ name: '我的关注', icon: '＋', tone: 'tone-brand' },
		{ name: '钱包', icon: '¥', tone: 'tone-warm' },
		{ name: '优惠券', icon: '券', tone: 'tone-brand' },
		{ name: '会员中心', icon: 'V', tone: 'tone-warm' }
	]

	const menuItems = ['实名认证', '安全中心', '我的动态', '我的评价', '客服帮助', '关于我们']

	onShow(() => {
		profile.value = getProfileSummary()
	})

	const identityLabel = computed(() : string => {
		if (sessionState.identity == 'provider') {
			return '服务者身份'
		}
		if (sessionState.identity == 'user') {
			return '普通用户'
		}
		return '未选择身份'
	})

	const applicationLabel = computed(() : string => {
		if (sessionState.applicationStatus == 'approved') {
			return '审核通过'
		}
		if (sessionState.applicationStatus == 'pending') {
			return '审核中'
		}
		if (sessionState.applicationStatus == 'rejected') {
			return '审核拒绝'
		}
		return '未申请'
	})

	const applicationTone = computed(() : string => {
		if (sessionState.applicationStatus == 'approved') {
			return 'success'
		}
		if (sessionState.applicationStatus == 'pending') {
			return 'warning'
		}
		if (sessionState.applicationStatus == 'rejected') {
			return 'danger'
		}
		return 'neutral'
	})

	const providerActionLabel = computed(() : string => {
		if (sessionState.applicationStatus == 'approved') {
			return '进入服务者工作台'
		}
		if (sessionState.applicationStatus == 'rejected') {
			return '修改并重新提交'
		}
		if (sessionState.applicationStatus == 'pending') {
			return '查看申请进度'
		}
		return '成为服务者'
	})

	function loginForProfile() {
		openLogin('view-profile', PROFILE_ROUTE, '')
	}

	function showSettingTip() {
		uni.navigateTo({
			url: SETTINGS_ROUTE
		})
	}

	function showEditTip() {
		uni.navigateTo({
			url: PROFILE_EDIT_ROUTE
		})
	}

	function openQuickItem(name: string) {
		if (name == '我的订单') {
			uni.navigateTo({
				url: ORDER_LIST_ROUTE
			})
			return
		}
		if (name == '我的收藏') {
			uni.navigateTo({
				url: FAVORITES_ROUTE
			})
			return
		}
		if (name == '我的关注') {
			uni.navigateTo({
				url: FOLLOWING_ROUTE
			})
			return
		}
		if (name == '我的动态') {
			uni.navigateTo({
				url: MY_MOMENTS_ROUTE
			})
			return
		}
		if (name == '钱包') {
			uni.navigateTo({
				url: WALLET_ROUTE
			})
			return
		}
		if (name == '优惠券') {
			uni.navigateTo({
				url: COUPONS_ROUTE
			})
			return
		}
		if (name == '会员中心') {
			uni.navigateTo({
				url: MEMBERSHIP_ROUTE
			})
			return
		}
		if (name == '实名认证') {
			uni.navigateTo({
				url: ID_VERIFY_ROUTE
			})
			return
		}
		if (name == '我的评价') {
			uni.navigateTo({
				url: MY_REVIEWS_ROUTE
			})
			return
		}
		if (name == '客服帮助') {
			uni.navigateTo({
				url: HELP_ROUTE
			})
			return
		}
		if (name == '关于我们') {
			uni.navigateTo({
				url: ABOUT_ROUTE
			})
			return
		}
		openFeature(name)
	}

	function openFeature(name: string) {
		if (name == '我的订单') {
			if (!sessionState.loggedIn) {
				openLogin(name, PROFILE_ROUTE, '')
				return
			}
			uni.navigateTo({
				url: '/pages/order/list'
			})
			return
		}
		if (!sessionState.loggedIn && name != '关于我们' && name != '客服帮助') {
			openLogin(name, PROFILE_ROUTE, '')
			return
		}
		uni.showToast({
			title: name + '将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openProviderCenter() {
		if (sessionState.applicationStatus == 'approved') {
			uni.navigateTo({
				url: PROVIDER_DASHBOARD_ROUTE
			})
			return
		}
		openProviderApply()
	}

	function logoutFromProfile() {
		logout()
		profile.value = null
		uni.showToast({
			title: '已退出登录，身份选择已保留',
			position: 'bottom',
			icon: 'success'
		})
	}

</script>

