<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">编辑资料</text>
				<view class="save-button" @click="save">
					<text class="save-text">保存</text>
				</view>
			</view>

			<view class="avatar-card">
				<view class="avatar-wrap">
					<image class="avatar" :src="avatar" mode="aspectFill"></image>
				</view>
				<view class="avatar-copy">
					<text class="avatar-title">更换头像</text>
					<text class="avatar-desc">上传真实清晰的本人照片</text>
					<view class="choose-button" @click="chooseAvatar">
						<text class="choose-plus">＋</text>
						<text class="choose-text">选择照片</text>
					</view>
				</view>
			</view>

			<view class="form-card">
				<text class="field-label">昵称</text>
				<input
					class="field-input"
					:value="nickname"
					maxlength="20"
					placeholder="请输入昵称"
					placeholder-class="field-placeholder"
					@input="onNicknameInput"
				/>

				<text class="field-label">性别</text>
				<view class="select-field" @click="chooseGender">
					<text class="select-text">{{ gender }}</text>
					<text class="select-arrow">⌄</text>
				</view>

				<text class="field-label">年龄</text>
				<view class="select-field" @click="chooseAge">
					<text class="select-text">{{ age }}</text>
					<text class="select-arrow">⌄</text>
				</view>

				<text class="field-label">所在城市</text>
				<view class="select-field" @click="chooseCity">
					<text class="select-text">{{ city }}</text>
					<text class="select-arrow">⌄</text>
				</view>

				<text class="field-label">个性签名</text>
				<input
					class="field-input"
					:value="bio"
					maxlength="60"
					placeholder="介绍一下自己吧"
					placeholder-class="field-placeholder"
					@input="onBioInput"
				/>
			</view>

			<view class="tag-card">
				<text class="tag-title">兴趣标签</text>
				<text class="tag-desc">选择兴趣，让同城玩伴更了解你</text>

				<view v-for="group in tagGroups" :key="group.category" class="tag-group">
					<text class="group-label">{{ group.category }}</text>
					<view class="tag-list">
						<view
							v-for="tag in group.tags"
							:key="tag.code"
							class="tag-button"
							:class="isTagSelected(tag.code) ? 'tag-button-active' : ''"
							@click="toggleTag(tag.code)"
						>
							<text class="tag-text" :class="isTagSelected(tag.code) ? 'tag-text-active' : ''">{{ tag.name }}</text>
						</view>
					</view>
				</view>
			</view>
			<view class="privacy-row">
				<view class="privacy-check">✓</view>
				<text class="privacy-text">资料仅用于完善个人主页，放心填写</text>
			</view>
			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import {
		getProfileCities,
		getProfileInterestTags,
		getUserProfile,
		updateUserProfile
	} from '../../services/service-container.uts'
	import type {
		ProfileCityOption,
		ProfileInterestTag,
		UserProfileUpdateDraft
	} from '../../types/models.uts'
	import { sessionState } from '../../state/session-state.uts'
	import { openLogin } from '../../router/route-guard.uts'

	type TagGroup = {
		category: string,
		tags: ProfileInterestTag[]
	}

	const avatar = ref('')
	const avatarChanged = ref(false)
	const nickname = ref('')
	const gender = ref('未填写')
	const genderCode = ref('')
	const age = ref(0)
	const cityCode = ref('')
	const city = ref('请选择城市')
	const bio = ref('')
	const selectedTagCodes = ref<string[]>([])
	const cities = ref<ProfileCityOption[]>([])
	const interestTags = ref<ProfileInterestTag[]>([])
	const tagGroups = ref<TagGroup[]>([])
	const profileVersion = ref(0)
	const saving = ref(false)

	function mapGenderLabel(code: string): string {
		if (code == 'MALE') {
			return '男'
		}
		if (code == 'FEMALE') {
			return '女'
		}
		return '未填写'
	}

	function buildTagGroups(items: ProfileInterestTag[]) {
		const groups: TagGroup[] = []
		for (let i = 0; i < items.length; i++) {
			const item = items[i]
			let groupIndex = -1
			for (let j = 0; j < groups.length; j++) {
				if (groups[j].category == item.category) {
					groupIndex = j
					break
				}
			}
			if (groupIndex < 0) {
				groups.push({
					category: item.category,
					tags: [item]
				})
			} else {
				groups[groupIndex].tags.push(item)
			}
		}
		tagGroups.value = groups
	}

	function isTagSelected(code: string): boolean {
		for (let i = 0; i < selectedTagCodes.value.length; i++) {
			if (selectedTagCodes.value[i] == code) {
				return true
			}
		}
		return false
	}

	function toggleTag(code: string) {
		const next: string[] = []
		let exists = false
		for (let i = 0; i < selectedTagCodes.value.length; i++) {
			if (selectedTagCodes.value[i] == code) {
				exists = true
			} else {
				next.push(selectedTagCodes.value[i])
			}
		}
		if (!exists) {
			if (next.length >= 5) {
				uni.showToast({
					title: '最多选择 5 个兴趣标签',
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			next.push(code)
		}
		selectedTagCodes.value = next
	}

	function loadOptions() {
		getProfileInterestTags().then((result) => {
			if (!result.ok) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			interestTags.value = result.items
			buildTagGroups(result.items)
		})
		getProfileCities().then((result) => {
			if (!result.ok) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			cities.value = result.items
		})
	}

	function loadProfile() {
		getUserProfile().then((result) => {
			if (!result.ok || result.profile == null) {
				if (!result.ok) {
					uni.showToast({
						title: result.message,
						position: 'bottom',
						icon: 'error'
					})
				}
				return
			}
			const profile = result.profile
			profileVersion.value = profile.version
			nickname.value = profile.nickname
			avatar.value = profile.avatarUrl
			avatarChanged.value = false
			genderCode.value = profile.gender
			gender.value = mapGenderLabel(profile.gender)
			age.value = profile.age
			cityCode.value = profile.cityCode
			city.value = profile.cityName.length > 0 ? profile.cityName : '请选择城市'
			bio.value = profile.signature
			const codes: string[] = []
			for (let i = 0; i < profile.interestTags.length; i++) {
				codes.push(profile.interestTags[i].code)
			}
			selectedTagCodes.value = codes
		})
	}

	onShow(() => {
		if (!sessionState.loggedIn) {
			openLogin('edit-profile', '/pages/profile/edit', '')
			return
		}
		loadProfile()
		loadOptions()
	})

	function onNicknameInput(event: InputEvent) {
		nickname.value = event.detail.value
	}

	function onBioInput(event: InputEvent) {
		bio.value = event.detail.value
	}

	function chooseAvatar() {
		uni.chooseImage({
			count: 1,
			success: (result) => {
				if (result.tempFilePaths.length > 0) {
					avatar.value = result.tempFilePaths[0]
					avatarChanged.value = true
				}
			}
		})
	}

	function chooseGender() {
		const options = ['男', '女']
		uni.showActionSheet({
			itemList: options,
			success: (result) => {
				gender.value = options[result.tapIndex]
				genderCode.value = options[result.tapIndex] == '男' ? 'MALE' : 'FEMALE'
			}
		})
	}

	function chooseAge() {
		const options: string[] = []
		for (let i = 18; i <= 40; i++) {
			options.push(i.toString() + ' 岁')
		}
		uni.showActionSheet({
			itemList: options,
			success: (result) => {
				age.value = 18 + result.tapIndex
			}
		})
	}

	function chooseCity() {
		if (cities.value.length == 0) {
			uni.showToast({
				title: '城市选项加载中',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		const options: string[] = []
		for (let i = 0; i < cities.value.length; i++) {
			options.push(cities.value[i].name)
		}
		uni.showActionSheet({
			itemList: options,
			success: (result) => {
				const selected = cities.value[result.tapIndex]
				cityCode.value = selected.code
				city.value = selected.name
			}
		})
	}

	function save() {
		if (saving.value) {
			return
		}
		saving.value = true
		const draft: UserProfileUpdateDraft = {
			expectedVersion: profileVersion.value,
			nickname: nickname.value,
			avatarMediaId: '',
			gender: genderCode.value,
			age: age.value,
			cityCode: cityCode.value,
			signature: bio.value,
			interestTagCodes: selectedTagCodes.value
		}
		updateUserProfile(draft, avatarChanged.value ? avatar.value : '').then((result) => {
			saving.value = false
			uni.showToast({
				title: result.message,
				position: 'bottom',
				icon: result.ok ? 'success' : 'error'
			})
			if (result.ok && result.profile != null) {
				profileVersion.value = result.profile.version
				avatar.value = result.profile.avatarUrl
				avatarChanged.value = false
			}
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}
</script>

