<template>
	<view class="page">
		<view class="chat-header">
			<view class="header-button" @click="goBack">
				<text class="header-icon">‹</text>
			</view>
			<image class="header-avatar" src="/static/following/avatar-linchuan.png" mode="aspectFill"></image>
			<view class="header-copy">
				<text class="header-name">林晴</text>
				<view class="header-status-row">
					<view class="online-dot"></view>
					<text class="header-status">在线 · 实名认证</text>
				</view>
			</view>
			<view class="alert-button" @click="openAlert">
				<text class="alert-icon">!</text>
				<text class="alert-text">一键报警</text>
			</view>
		</view>

		<view class="order-card">
			<view class="order-head">
				<text class="order-icon">↗</text>
				<text class="order-title">订单信息</text>
				<view class="order-status">
					<text class="order-status-text">已确认</text>
				</view>
			</view>
			<text class="order-service">台球助教 · 新手体验</text>
			<view class="order-info-row">
				<text class="order-info-icon">◷</text>
				<text class="order-info-text">今天 14:30-15:30</text>
			</view>
			<view class="order-info-row">
				<text class="order-info-icon">⌖</text>
				<text class="order-info-text">泸州 · 江阳区星光台球俱乐部</text>
			</view>
		</view>

		<scroll-view class="chat-scroll" direction="vertical" :show-scrollbar="false">
			<view class="chat-content">
				<view class="time-divider">
					<text class="time-text">今天 14:02</text>
				</view>

				<view v-for="message in messages" :key="message.id" class="message-row" :class="message.isSelf ? 'message-row-self' : 'message-row-other'">
					<image v-if="!message.isSelf" class="message-avatar" src="/static/following/avatar-linchuan.png" mode="aspectFill"></image>

					<view class="message-main" :class="message.isSelf ? 'message-main-self' : ''">
						<view v-if="message.type == 'text'" class="message-bubble" :class="message.isSelf ? 'bubble-self' : 'bubble-other'">
							<text class="message-text">{{ message.content }}</text>
						</view>

						<view v-else-if="message.type == 'image'" class="image-message">
							<image class="message-image" :src="message.image" mode="aspectFill"></image>
							<text class="image-caption">{{ message.content }}</text>
						</view>

						<view v-else-if="message.type == 'voice'" class="voice-bubble" @click="playVoice">
							<text class="voice-icon">▥</text>
							<text class="voice-text">{{ message.content }}</text>
						</view>

						<view v-else class="location-bubble" @click="openLocation">
							<text class="location-icon">⌖</text>
							<text class="location-text">{{ message.content }}</text>
						</view>

						<view class="message-meta" :class="message.isSelf ? 'meta-self' : 'meta-other'">
							<text class="message-time">{{ message.time }}</text>
							<text v-if="message.isSelf && message.read" class="read-text">已读</text>
						</view>
					</view>
				</view>
			</view>
		</scroll-view>

		<view class="composer">
			<scroll-view class="quick-scroll" direction="horizontal" :show-scrollbar="false">
				<view class="quick-row">
					<view v-for="phrase in quickPhrases" :key="phrase" class="quick-chip" @click="useQuickPhrase(phrase)">
						<text class="quick-text">{{ phrase }}</text>
					</view>
				</view>
			</scroll-view>

			<view class="input-row">
				<input
					class="message-input"
					:value="draft"
					placeholder="输入消息…"
					placeholder-class="message-placeholder"
					@input="onDraftInput"
					@confirm="sendMessage"
				/>
			</view>

			<view class="tool-row">
				<view class="tool-button" @click="chooseImage">
					<text class="tool-icon">▧</text>
				</view>
				<view class="tool-button" @click="takePhoto">
					<text class="tool-icon">◫</text>
				</view>
				<view class="tool-button" @click="recordVoice">
					<text class="tool-icon">♩</text>
				</view>
				<view class="tool-button" @click="sendLocation">
					<text class="tool-icon">⌖</text>
				</view>
				<view class="send-button" @click="sendMessage">
					<text class="send-text">发送</text>
				</view>
			</view>
			<text class="composer-tip">见面聊，安心见 · 请在平台内沟通与确认订单</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getChatMessages } from '../../services/service-container.uts'
	import type { ChatMessage } from '../../types/models.uts'

	const messages = ref<ChatMessage[]>(getChatMessages())
	const draft = ref('')
	const quickPhrases = ['我已到达', '还有 5 分钟到', '发个位置']

	function onDraftInput(event: InputEvent) {
		draft.value = event.detail.value
	}

	function useQuickPhrase(phrase: string) {
		draft.value = phrase
	}

	function sendMessage() {
		const content = draft.value.trim()
		if (content.length == 0) {
			return
		}
		const next: Array<ChatMessage> = []
		for (let i = 0; i < messages.value.length; i++) {
			next.push(messages.value[i])
		}
		next.push({
			id: 'chat-local-' + Date.now().toString(),
			type: 'text',
			content: content,
			image: '',
			time: '刚刚',
			isSelf: true,
			read: false
		})
		messages.value = next
		draft.value = ''
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/messages/messages'
				})
			}
		})
	}

	function openAlert() {
		uni.showToast({
			title: '一键报警将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function playVoice() {
		uni.showToast({
			title: '语音播放将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openLocation() {
		uni.showToast({
			title: '地图查看将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function chooseImage() {
		uni.showToast({
			title: '图片发送将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function takePhoto() {
		uni.showToast({
			title: '拍照发送将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function recordVoice() {
		uni.showToast({
			title: '语音消息将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function sendLocation() {
		uni.showToast({
			title: '位置发送将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

<style lang="scss">
