<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">客服帮助</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="search-box">
				<image class="search-icon" src="/static/search/search.png" mode="aspectFit"></image>
				<input
					class="search-input"
					:value="keyword"
					placeholder="搜索帮助内容"
					placeholder-class="search-placeholder"
					@input="onKeywordInput"
				/>
			</view>

			<view class="intro-card">
				<text class="intro-title">需要帮助吗？</text>
				<text class="intro-desc">选择下方分类，快速找到答案</text>
			</view>

			<view class="faq-grid">
				<view v-for="item in faqItems" :key="item.title" class="faq-card" @click="openFaq(item.title)">
					<view class="faq-icon" :class="item.tone">
						<text class="faq-icon-text">{{ item.icon }}</text>
					</view>
					<view class="faq-copy">
						<text class="faq-title">{{ item.title }}</text>
						<text class="faq-desc">{{ item.desc }}</text>
					</view>
					<text class="faq-arrow">›</text>
				</view>
			</view>

			<view class="support-card">
				<view class="support-head">
					<text class="support-title">联系客服</text>
					<text class="support-desc">工作日 09:00 - 22:00</text>
				</view>
				<view class="support-actions">
					<view class="support-button primary" @click="openService">
						<text class="support-button-text">在线客服</text>
					</view>
					<view class="support-button secondary support-button-second" @click="openFeedback">
						<text class="support-button-text secondary-text">意见反馈</text>
					</view>
				</view>
			</view>

			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	const keyword = ref('')
	const faqItems = [
		{ title: '订单问题', desc: '预约、取消、退款与订单状态', icon: '单', tone: 'tone-brand' },
		{ title: '支付问题', desc: '支付方式、余额与发票相关', icon: '¥', tone: 'tone-warm' },
		{ title: '安全问题', desc: '见面安全、认证与平台保障', icon: '♢', tone: 'tone-brand' },
		{ title: '账号问题', desc: '登录、资料、隐私与账号安全', icon: '♙', tone: 'tone-warm' }
	]

	function onKeywordInput(event: InputEvent) {
		keyword.value = event.detail.value
	}

	function openFaq(title: string) {
		uni.showToast({
			title: title + '帮助内容将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openService() {
		uni.showToast({
			title: '在线客服将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openFeedback() {
		uni.showToast({
			title: '意见反馈将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}
</script>

