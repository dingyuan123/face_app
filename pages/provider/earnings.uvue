<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">收入提现</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="balance-card">
				<text class="balance-label">可提现余额</text>
				<text class="balance-value">{{ summary.withdrawableAmount }}</text>
				<view class="balance-meta">
					<view class="meta-item">
						<text class="meta-label">累计收入</text>
						<text class="meta-value">{{ summary.totalIncome }}</text>
					</view>
					<view class="meta-line"></view>
					<view class="meta-item">
						<text class="meta-label">提现处理中</text>
						<text class="meta-value">{{ summary.pendingWithdrawal }}</text>
					</view>
				</view>
				<view class="withdraw-button" @click="openWithdrawal">
					<text class="withdraw-text">申请提现</text>
				</view>
			</view>

			<view class="notice-card">
				<text class="notice-icon">i</text>
				<text class="notice-text">提现将原路退回或转入已绑定账户，具体到账时间以支付渠道为准。</text>
			</view>

			<view class="section-head">
				<text class="section-title">收支明细</text>
				<text class="section-subtitle">订单收入与提现记录</text>
			</view>

			<view class="transaction-list">
				<view v-for="item in summary.transactions" :key="item.id" class="transaction-item">
					<view class="transaction-icon" :class="item.type == 'income' ? 'transaction-icon-income' : 'transaction-icon-withdrawal'">
						<text class="transaction-icon-text">{{ item.type == 'income' ? '收' : '提' }}</text>
					</view>
					<view class="transaction-main">
						<text class="transaction-title">{{ item.title }}</text>
						<text class="transaction-meta">{{ item.time }} · {{ item.status }}</text>
					</view>
					<text class="transaction-amount" :class="item.type == 'income' ? 'amount-income' : 'amount-withdrawal'">{{ item.amount }}</text>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProviderEarnings } from '../../services/service-container.uts'
	import type { ProviderEarningsSummary } from '../../types/models.uts'

	const summary = ref<ProviderEarningsSummary>(getProviderEarnings())

	onShow(() => {
		summary.value = getProviderEarnings()
	})

	function openWithdrawal() {
		uni.navigateTo({
			url: '/pages/provider/withdrawal'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

