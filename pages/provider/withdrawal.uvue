<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">申请提现</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="balance-card">
					<text class="balance-label">可提现余额</text>
					<text class="balance-value">{{ summary.withdrawableAmount }}</text>
					<text class="balance-desc">预计 1-3 个工作日到账</text>
				</view>

				<view class="section-card">
					<text class="section-title">提现金额</text>
					<view class="amount-input-wrap">
						<text class="amount-symbol">¥</text>
						<input
							class="amount-input"
							:value="amount"
							type="digit"
							maxlength="10"
							placeholder="请输入提现金额"
							placeholder-class="amount-placeholder"
							@input="onAmountInput"
						/>
					</view>
					<view class="amount-actions">
						<text class="amount-tip">单笔最低提现 ¥10.00</text>
						<view class="all-button" @click="withdrawAll">
							<text class="all-text">全部提现</text>
						</view>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">到账方式</text>
					<view class="method-list">
						<view class="method-item" :class="selectedMethod == '银行卡' ? 'method-active' : ''" @click="selectedMethod = '银行卡'">
							<view class="method-icon method-icon-bank">
								<text class="method-icon-text">卡</text>
							</view>
							<view class="method-main">
								<text class="method-name">银行卡</text>
								<text class="method-desc">招商银行 · 尾号 2688</text>
							</view>
							<view class="radio" :class="selectedMethod == '银行卡' ? 'radio-active' : ''"></view>
						</view>
						<view class="method-item" :class="selectedMethod == '支付宝' ? 'method-active' : ''" @click="selectedMethod = '支付宝'">
							<view class="method-icon method-icon-alipay">
								<text class="method-icon-text">支</text>
							</view>
							<view class="method-main">
								<text class="method-name">支付宝</text>
								<text class="method-desc">138****2688</text>
							</view>
							<view class="radio" :class="selectedMethod == '支付宝' ? 'radio-active' : ''"></view>
						</view>
						<view class="method-item" :class="selectedMethod == '微信' ? 'method-active' : ''" @click="selectedMethod = '微信'">
							<view class="method-icon method-icon-wechat">
								<text class="method-icon-text">微</text>
							</view>
							<view class="method-main">
								<text class="method-name">微信</text>
								<text class="method-desc">已绑定微信账户</text>
							</view>
							<view class="radio" :class="selectedMethod == '微信' ? 'radio-active' : ''"></view>
						</view>
					</view>
				</view>

				<view class="notice-card">
					<text class="notice-icon">i</text>
					<view class="notice-copy">
						<text class="notice-title">到账说明</text>
						<text class="notice-text">当前开发 Mock 不产生真实资金流转。正式提现需接入支付渠道、风控和身份核验。</text>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="action-bar">
			<view class="submit-button" @click="submit">
				<text class="submit-text">确认提现</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getProviderEarnings, submitProviderWithdrawal } from '../../services/service-container.uts'
	import type { ProviderEarningsSummary } from '../../types/models.uts'

	const summary = ref<ProviderEarningsSummary>(getProviderEarnings())
	const amount = ref('')
	const selectedMethod = ref('银行卡')

	function onAmountInput(event: InputEvent) {
		amount.value = event.detail.value
	}

	function withdrawAll() {
		amount.value = summary.value.withdrawableAmount.replace('¥', '')
	}

	function submit() {
		const result = submitProviderWithdrawal(amount.value, selectedMethod.value)
		if (result.ok) {
			summary.value = getProviderEarnings()
			amount.value = ''
			uni.showToast({
				title: result.message,
				position: 'bottom',
				icon: 'success'
			})
			setTimeout(() => {
				uni.navigateBack({
					delta: 1
				})
			}, 800)
			return
		}
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: 'error'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/earnings'
				})
			}
		})
	}
</script>

