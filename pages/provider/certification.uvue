<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">认证中心</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="summary-card">
				<view class="summary-icon">
					<text class="summary-icon-text">✓</text>
				</view>
				<view class="summary-copy">
					<text class="summary-title">认证状态良好</text>
					<text class="summary-desc">完成认证可以提高用户信任和服务曝光</text>
				</view>
				<view class="summary-pill">
					<text class="summary-pill-text">3/4 已通过</text>
				</view>
			</view>

			<view class="notice-card">
				<text class="notice-icon">i</text>
				<text class="notice-text">认证材料仅用于身份和服务能力核验，平台会按隐私规范妥善保护。</text>
			</view>

			<view class="cert-list">
				<view v-for="item in certifications" :key="item.id" class="cert-card">
					<view class="cert-icon" :class="certIconClass(item.status)">
						<text class="cert-icon-text">{{ certIcon(item.status) }}</text>
					</view>
					<view class="cert-main">
						<view class="cert-title-row">
							<text class="cert-title">{{ item.title }}</text>
							<view class="cert-status" :class="certStatusClass(item.status)">
								<text class="cert-status-text" :class="certStatusTextClass(item.status)">{{ item.status }}</text>
							</view>
						</view>
						<text class="cert-desc">{{ item.description }}</text>
					</view>
					<view class="cert-action" @click="handleCertification(item.id, item.status)">
						<text class="cert-action-text">{{ item.actionLabel }}</text>
					</view>
				</view>
			</view>

			<view class="help-card">
				<text class="help-title">认证遇到问题？</text>
				<text class="help-desc">如材料审核未通过，请根据提示补充真实、清晰的资料。</text>
				<view class="help-button" @click="openHelp">
					<text class="help-button-text">联系客服</text>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProviderCertifications } from '../../services/service-container.uts'
	import type { ProviderCertificationItem } from '../../types/models.uts'

	const certifications = ref<ProviderCertificationItem[]>(getProviderCertifications())

	function certIcon(status: string): string {
		if (status == '已通过') {
			return '✓'
		}
		if (status == '待审核') {
			return '◷'
		}
		return '!'
	}

	function certIconClass(status: string): string {
		if (status == '已通过') {
			return 'cert-icon-success'
		}
		if (status == '待审核' || status == '未通过') {
			return 'cert-icon-warning'
		}
		return 'cert-icon-error'
	}

	function certStatusClass(status: string): string {
		if (status == '已通过') {
			return 'cert-status-success'
		}
		if (status == '待审核' || status == '未通过') {
			return 'cert-status-warning'
		}
		return 'cert-status-error'
	}

	function certStatusTextClass(status: string): string {
		if (status == '已通过') {
			return 'cert-status-success-text'
		}
		if (status == '待审核' || status == '未通过') {
			return 'cert-status-warning-text'
		}
		return 'cert-status-error-text'
	}

	function handleCertification(id: string, status: string) {
		if (id == 'real-name') {
			uni.navigateTo({
				url: '/pages/verification/id-verify'
			})
			return
		}
		if (status == '待审核') {
			uni.showToast({
				title: '认证材料正在审核中',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		if (status == '未通过') {
			uni.navigateTo({
				url: '/pages/provider/profile'
			})
			return
		}
		uni.showToast({
			title: '认证详情将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openHelp() {
		uni.navigateTo({
			url: '/pages/help/help'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

