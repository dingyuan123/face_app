<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">动态管理</text>
				<view class="publish-button" @click="publishMoment">
					<text class="publish-plus">＋</text>
					<text class="publish-text">发布动态</text>
				</view>
			</view>

			<view class="stats-card">
				<view class="stat-item">
					<text class="stat-value">{{ publishedCount }}</text>
					<text class="stat-label">已发布</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item">
					<text class="stat-value">{{ totalLikes }}</text>
					<text class="stat-label">获赞</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item">
					<text class="stat-value">{{ totalComments }}</text>
					<text class="stat-label">评论</text>
				</view>
			</view>

			<view class="filter-wrap">
				<segment-tabs
					:items="filterLabels"
					:active="activeFilter"
					variant="pill"
					@change="changeFilter"
				></segment-tabs>
			</view>

			<view v-if="loading" class="empty-state">
				<text class="empty-title">正在加载动态…</text>
			</view>

			<view v-else-if="moments.length == 0" class="empty-state">
				<image class="empty-image" src="/static/moments/empty.png" mode="aspectFit"></image>
				<text class="empty-title">还没有发布动态</text>
				<text class="empty-desc">发布第一条动态，让更多人看到你的服务。</text>
				<view class="empty-button" @click="publishMoment">
					<text class="empty-button-text">发布动态</text>
				</view>
			</view>

			<view v-else class="moment-list">
				<view v-for="moment in moments" :key="moment.id" class="moment-card">
					<view class="moment-main">
						<image class="moment-cover" :src="coverOf(moment)" mode="aspectFill"></image>
						<view class="moment-copy">
							<view class="moment-head">
								<text class="moment-title">{{ moment.title }}</text>
								<view class="moment-status" :class="statusClass(moment.statusCode)">
									<text class="moment-status-text" :class="statusTextClass(moment.statusCode)">{{ moment.status }}</text>
								</view>
							</view>
							<text class="moment-time">{{ timeOf(moment) }}</text>
							<view class="moment-data">
								<text class="data-text">浏览 {{ moment.viewCount }}</text>
								<text class="data-text">赞 {{ moment.likeCount }}</text>
								<text class="data-text">评论 {{ moment.commentCount }}</text>
							</view>
							<text v-if="moment.attachedServiceTitle.length > 0" class="moment-service">挂载：{{ moment.attachedServiceTitle }}</text>
						</view>
					</view>
					<view v-if="moment.statusCode == 'REJECTED' && moment.rejectReason.length > 0" class="reject-row">
						<text class="reject-text">拒绝原因：{{ moment.rejectReason }}</text>
					</view>
					<view class="moment-actions">
						<view class="action-button" @click="editMoment(moment.id)">
							<text class="action-text">编辑</text>
						</view>
						<view v-if="moment.statusCode == 'DRAFT'" class="action-button highlight" @click="publishDraft(moment)">
							<text class="action-text action-text-highlight">发布</text>
						</view>
						<view class="action-button danger" @click="removeMoment(moment.id)">
							<text class="action-text danger-text">删除</text>
						</view>
					</view>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import {
		listProviderMoments,
		publishProviderMomentData,
		removeProviderMoment
	} from '../../services/service-container.uts'
	import type { ProviderMomentManageItem } from '../../types/models.uts'

	const filterLabels = ['全部', '草稿', '已发布', '已拒绝']
	const filterCodes = ['', 'DRAFT', 'PUBLISHED', 'REJECTED']
	const activeFilter = ref('全部')
	const moments = ref<ProviderMomentManageItem[]>([])
	const loading = ref(false)
	const publishedCount = ref(0)
	const totalLikes = ref(0)
	const totalComments = ref(0)

	// 列表在刷新函数中显式生成，避免响应式数组派生迭代问题。
	function refreshMoments() {
		if (loading.value) {
			return
		}
		loading.value = true
		let status = ''
		for (let i = 0; i < filterLabels.length; i++) {
			if (filterLabels[i] == activeFilter.value) {
				status = filterCodes[i]
			}
		}
		listProviderMoments(status, 1, 50).then((result) => {
			loading.value = false
			if (!result.ok) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			const next: Array<ProviderMomentManageItem> = []
			let likes = 0
			let comments = 0
			let published = 0
			for (let i = 0; i < result.items.length; i++) {
				next.push(result.items[i])
				likes += result.items[i].likeCount
				comments += result.items[i].commentCount
				if (result.items[i].statusCode == 'PUBLISHED') {
					published += 1
				}
			}
			moments.value = next
			totalLikes.value = likes
			totalComments.value = comments
			publishedCount.value = published
		})
	}

	function changeFilter(label: string) {
		activeFilter.value = label
		refreshMoments()
	}

	function coverOf(moment: ProviderMomentManageItem): string {
		if (moment.coverImage.length > 0) {
			return moment.coverImage
		}
		return '/static/content/city.png'
	}

	function timeOf(moment: ProviderMomentManageItem): string {
		const value = moment.publishedAt.length > 0 ? moment.publishedAt : moment.updatedAt
		if (value.length == 0) {
			return '未发布'
		}
		return value.replace('T', ' ').slice(0, 16)
	}

	function statusClass(code: string): string {
		if (code == 'PUBLISHED') {
			return 'status-published'
		}
		if (code == 'REJECTED') {
			return 'status-rejected'
		}
		return 'status-draft'
	}

	function statusTextClass(code: string): string {
		if (code == 'PUBLISHED') {
			return 'status-text-published'
		}
		if (code == 'REJECTED') {
			return 'status-text-rejected'
		}
		return 'status-text-draft'
	}

	refreshMoments()

	function publishMoment() {
		uni.navigateTo({
			url: '/pages/moment/publish'
		})
	}

	function editMoment(id: string) {
		uni.navigateTo({
			url: '/pages/moment/publish?momentId=' + encodeURIComponent(id)
		})
	}

	function publishDraft(moment: ProviderMomentManageItem) {
		uni.showModal({
			title: '发布动态',
			content: '确认发布这条动态吗？',
			confirmText: '确认发布',
			cancelText: '再想想',
			success: (result) => {
				if (!result.confirm) {
					return
				}
				publishProviderMomentData(moment.id, moment.version).then((publishResult) => {
					uni.showToast({
						title: publishResult.message,
						position: 'bottom',
						icon: publishResult.ok ? 'success' : 'error'
					})
					refreshMoments()
				})
			}
		})
	}

	function removeMoment(id: string) {
		uni.showModal({
			title: '删除动态',
			content: '删除后不可恢复，确认删除吗？',
			confirmText: '确认删除',
			cancelText: '再想想',
			success: (result) => {
				if (!result.confirm) {
					return
				}
				removeProviderMoment(id).then((outcome) => {
					uni.showToast({
						title: outcome.message,
						position: 'bottom',
						icon: outcome.ok ? 'success' : 'error'
					})
					refreshMoments()
				})
			}
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

