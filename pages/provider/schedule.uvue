		background-color: #FFF1F2;
		border-radius: 999rpx;
	}

	.summary-badge-text {
		font-size: 21rpx;
		font-weight: 700;
		color: $facetof-color-primary;
	}

	.stats-card,
	.mode-card,
	.calendar-card,
	.section-card,
	.batch-card {
		margin: 18rpx 32rpx 0;
		padding: 24rpx;
