<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">评价管理</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="rating-card">
				<view class="rating-main">
					<text class="rating-value">4.9</text>
					<text class="rating-stars">★★★★★</text>
					<text class="rating-count">累计 126 条评价</text>
				</view>
				<view class="rating-divider"></view>
				<view class="rating-bars">
					<view class="rating-row">
						<text class="rating-label">5星</text>
						<view class="rating-track"><view class="rating-fill fill-5"></view></view>
						<text class="rating-percent">86%</text>
					</view>
					<view class="rating-row">
						<text class="rating-label">4星</text>
						<view class="rating-track"><view class="rating-fill fill-4"></view></view>
						<text class="rating-percent">10%</text>
					</view>
					<view class="rating-row">
						<text class="rating-label">3星</text>
						<view class="rating-track"><view class="rating-fill fill-3"></view></view>
						<text class="rating-percent">3%</text>
					</view>
					<view class="rating-row">
						<text class="rating-label">2星</text>
						<view class="rating-track"><view class="rating-fill fill-2"></view></view>
						<text class="rating-percent">1%</text>
					</view>
					<view class="rating-row">
						<text class="rating-label">1星</text>
						<view class="rating-track"><view class="rating-fill fill-1"></view></view>
						<text class="rating-percent">0%</text>
					</view>
				</view>
			</view>

			<view class="notice-card">
				<text class="notice-icon">✓</text>
				<text class="notice-text">真诚回复每一条评价，有助于建立用户信任。</text>
			</view>

			<view class="review-list">
				<view v-for="review in reviews" :key="review.id" class="review-card">
					<view class="review-head">
						<image class="review-avatar" :src="review.avatar" mode="aspectFill"></image>
						<view class="review-user">
							<text class="review-name">{{ review.userName }}</text>
							<text class="review-service">{{ review.serviceTitle }}</text>
						</view>
						<view class="review-rating">
							<text class="review-stars">{{ ratingStars(review.rating) }}</text>
							<text class="review-time">{{ review.createdAt }}</text>
						</view>
					</view>
					<text class="review-content">{{ review.content }}</text>
					<view v-if="review.reply.length > 0" class="reply-box">
						<text class="reply-label">我的回复</text>
						<text class="reply-text">{{ review.reply }}</text>
					</view>
					<view class="review-actions">
						<view class="reply-button" @click="openReply(review)">
							<text class="reply-button-text">{{ review.reply.length > 0 ? '修改回复' : '回复评价' }}</text>
						</view>
					</view>

					<view v-if="replyingId == review.id" class="reply-editor">
						<textarea
							class="reply-input"
							:value="replyContent"
							maxlength="120"
							placeholder="感谢你的评价，期待再次见面..."
							placeholder-class="reply-placeholder"
							@input="onReplyInput"
						></textarea>
						<view class="editor-actions">
							<view class="cancel-button" @click="closeReply">
								<text class="cancel-text">取消</text>
							</view>
							<view class="submit-button" @click="submitReply">
								<text class="submit-text">发布回复</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProviderReviewItems, replyProviderReview } from '../../services/service-container.uts'
	import type { ProviderReviewItem } from '../../types/models.uts'

	const reviews = ref<ProviderReviewItem[]>(getProviderReviewItems())
	const replyingId = ref('')
	const replyContent = ref('')

	function ratingStars(rating: number): string {
		if (rating >= 5) {
			return '★★★★★'
		}
		if (rating >= 4) {
			return '★★★★☆'
		}
		if (rating >= 3) {
			return '★★★☆☆'
		}
		return '★★☆☆☆'
	}

	function openReply(review: ProviderReviewItem) {
		replyingId.value = review.id
		replyContent.value = review.reply
	}

	function closeReply() {
		replyingId.value = ''
		replyContent.value = ''
	}

	function onReplyInput(event: InputEvent) {
		replyContent.value = event.detail.value
	}

	function submitReply() {
		const result = replyProviderReview(replyingId.value, replyContent.value)
		if (result.ok) {
			reviews.value = getProviderReviewItems()
			closeReply()
		}
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

