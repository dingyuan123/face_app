		height: 128rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 0 32rpx;
		background-color: #FFF9F5;
	}

	.nav-button,
	.nav-placeholder {
		width: 76rpx;
		height: 76rpx;
	}

