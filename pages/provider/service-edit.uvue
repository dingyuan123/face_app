		padding: 18rpx 32rpx;
		padding-bottom: var(--uni-safe-area-inset-bottom);
		background-color: #FFFFFF;
		border-top: 1rpx solid #F5DED5;
	}

	.draft-button,
	.submit-button {
		height: 88rpx;
