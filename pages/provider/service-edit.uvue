<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">{{ pageTitle }}</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="cover-card">
					<view class="cover-preview" @click="chooseCover">
						<image v-if="coverPath.length > 0" class="cover-image" :src="coverPath" mode="aspectFill"></image>
						<view v-else class="cover-empty">
							<text class="cover-plus">＋</text>
							<text class="cover-text">上传服务封面</text>
						</view>
					</view>
					<text class="cover-hint">建议使用能展示服务场景的清晰图片</text>
					<text class="field-label">服务图集（{{ galleryPaths.length }}/6）</text>
					<view class="gallery-grid">
						<view v-for="(photo, index) in galleryPaths" :key="photo" class="gallery-item">
							<image class="gallery-image" :src="photo" mode="aspectFill"></image>
							<view class="gallery-remove" @click="removeGallery(index)">
								<text class="gallery-remove-text">×</text>
							</view>
						</view>
						<view v-if="galleryPaths.length < 6" class="gallery-add" @click="chooseGallery">
							<text class="cover-plus">＋</text>
							<text class="cover-hint">添加图集</text>
						</view>
					</view>
				</view>

				<view class="form-card">
					<text class="section-title">基础信息</text>
					<text class="field-label">服务名称</text>
					<input
						class="field-input"
						:value="title"
						maxlength="30"
						placeholder="例如：台球助教 · 新手体验"
						placeholder-class="field-placeholder"
						@input="onTitleInput"
					/>

					<text class="field-label">服务类目</text>
					<view class="tag-wrap">
						<view
							v-for="item in categoryOptions"
							:key="item.code"
							class="tag-button"
							:class="categoryCode == item.code ? 'tag-active' : ''"
							@click="selectCategory(item.code)"
						>
							<text class="tag-text">{{ item.name }}</text>
						</view>
					</view>

					<view class="form-row">
						<view class="form-column">
							<text class="field-label">价格</text>
							<input
								class="field-input"
								:value="priceText"
								type="number"
								maxlength="8"
								placeholder="¥68"
								placeholder-class="field-placeholder"
								@input="onPriceInput"
							/>
						</view>
						<view class="form-column">
							<text class="field-label">服务时长</text>
							<input
								class="field-input"
								:value="durationText"
								maxlength="12"
								placeholder="60 分钟"
								placeholder-class="field-placeholder"
								@input="onDurationInput"
							/>
						</view>
					</view>

					<text class="field-label">服务介绍</text>
					<textarea
						class="intro-input"
						:value="introduction"
						maxlength="300"
						placeholder="介绍你的服务内容、适合人群和见面安排"
						placeholder-class="field-placeholder"
						@input="onIntroductionInput"
					></textarea>
				</view>

				<view class="form-card">
					<text class="section-title">服务标签</text>
					<text class="section-desc">帮助用户快速了解你的服务特点</text>
					<view class="tag-wrap">
						<view
							v-for="item in tagOptions"
							:key="item.code"
							class="tag-button"
							:class="isTagSelected(item.code) ? 'tag-active' : ''"
							@click="toggleTag(item.code)"
						>
							<text class="tag-text">{{ item.name }}</text>
						</view>
					</view>
				</view>

				<view class="setting-card">
					<view class="setting-row">
						<text class="setting-label">可约地点类型</text>
						<view class="location-pill">
							<text class="location-text">仅限公共场所</text>
						</view>
					</view>
					<view class="setting-divider"></view>
					<text class="setting-hint">请遵守平台安全规范，仅在正规公共场所提供服务。</text>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="action-bar">
			<view class="draft-button" @click="saveDraft">
				<text class="draft-text">保存草稿</text>
			</view>
			<view class="submit-button" :class="title.trim().length > 0 ? '' : 'submit-disabled'" @click="submitReview">
				<text class="submit-text">提交审核</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import {
		createOrUpdateProviderService,
		getProviderServiceData,
		getServiceCategoryOptions,
		getServiceTagOptions,
		submitProviderServiceReview
	} from '../../services/service-container.uts'
	import type {
		ProviderOptionItem,
		ProviderServiceData,
		ProviderServiceDraftInput
	} from '../../types/models.uts'

	const editId = ref('')
	const serviceVersion = ref(0)
	const pageTitle = ref('创建服务')
	const title = ref('')
	const categoryCode = ref('')
	const priceText = ref('')
	const durationText = ref('')
	const introduction = ref('')
	const coverPath = ref('')
	const coverMediaId = ref('')
	const galleryPaths = ref<string[]>([])
	const galleryMediaIds = ref<string[]>([])
	const selectedTagCodes = ref<string[]>([])
	const categoryOptions = ref<ProviderOptionItem[]>([])
	const tagOptions = ref<ProviderOptionItem[]>([])
	const saving = ref(false)

	function isTagSelected(code: string): boolean {
		for (let i = 0; i < selectedTagCodes.value.length; i++) {
			if (selectedTagCodes.value[i] == code) {
				return true
			}
		}
		return false
	}

	function toggleTag(code: string) {
		const next: string[] = []
		for (let i = 0; i < selectedTagCodes.value.length; i++) {
			if (selectedTagCodes.value[i] != code) {
				next.push(selectedTagCodes.value[i])
			}
		}
		if (next.length == selectedTagCodes.value.length) {
			if (next.length >= 8) {
				uni.showToast({
					title: '最多选择 8 个服务标签',
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			next.push(code)
		}
		selectedTagCodes.value = next
	}

	function selectCategory(code: string) {
		categoryCode.value = code
	}

	function onTitleInput(event: InputEvent) {
		title.value = event.detail.value
	}

	function onPriceInput(event: InputEvent) {
		priceText.value = event.detail.value
	}

	function onDurationInput(event: InputEvent) {
		durationText.value = event.detail.value
	}

	function onIntroductionInput(event: InputEvent) {
		introduction.value = event.detail.value
	}

	function chooseCover() {
		uni.chooseImage({
			count: 1,
			success: (result) => {
				if (result.tempFilePaths.length > 0) {
					coverPath.value = result.tempFilePaths[0]
				}
			}
		})
	}

	function chooseGallery() {
		const remaining = 6 - galleryPaths.value.length
		if (remaining <= 0) {
			return
		}
		uni.chooseImage({
			count: remaining,
			success: (result) => {
				const next: string[] = []
				for (let i = 0; i < galleryPaths.value.length; i++) {
					next.push(galleryPaths.value[i])
				}
				for (let i = 0; i < result.tempFilePaths.length && next.length < 6; i++) {
					next.push(result.tempFilePaths[i])
				}
				galleryPaths.value = next
			}
		})
	}

	function removeGallery(index: number) {
		const next: string[] = []
		const nextIds: string[] = []
		for (let i = 0; i < galleryPaths.value.length; i++) {
			if (i != index) {
				next.push(galleryPaths.value[i])
			}
		}
		for (let i = 0; i < galleryMediaIds.value.length; i++) {
			if (i != index) {
				nextIds.push(galleryMediaIds.value[i])
			}
		}
		galleryPaths.value = next
		galleryMediaIds.value = nextIds
	}

	function priceToMinor(value: string): number {
		const amount = parseFloat(value)
		return Math.round(amount * 100)
	}

	function durationToMinutes(value: string): number {
		const result = parseInt(value)
		return result > 0 ? result : 0
	}

	function loadOptions() {
		getServiceCategoryOptions().then((result) => {
			if (result.ok) {
				categoryOptions.value = result.items
				if (categoryCode.value.length == 0 && result.items.length > 0) {
					categoryCode.value = result.items[0].code
				}
			}
		})
		getServiceTagOptions().then((result) => {
			if (result.ok) {
				tagOptions.value = result.items
			}
		})
	}

	function loadService(id: string) {
		getProviderServiceData(id).then((result) => {
			if (!result.ok || result.service == null) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			const service = result.service
			editId.value = service.id
			serviceVersion.value = service.version
			pageTitle.value = '编辑服务'
			title.value = service.title
			categoryCode.value = service.categoryCode
			priceText.value = (service.priceAmountMinor / 100).toFixed(2)
			durationText.value = service.durationMinutes.toString()
			introduction.value = service.introduction
			coverPath.value = service.coverUrl
			coverMediaId.value = service.coverMediaId
			galleryPaths.value = service.galleryUrls
			galleryMediaIds.value = service.galleryMediaIds
			selectedTagCodes.value = service.tagCodes
		})
	}

	onLoad((options) => {
		loadOptions()
		if (options == null) {
			return
		}
		const serviceId = options['serviceId'] as string
		if (serviceId != null && serviceId.length > 0) {
			loadService(decodeURIComponent(serviceId))
		}
	})

	function buildDraft(): ProviderServiceDraftInput {
		return {
			id: editId.value,
			expectedVersion: serviceVersion.value,
			title: title.value.trim(),
			categoryCode: categoryCode.value,
			currency: 'CNY',
			priceAmountMinor: priceToMinor(priceText.value),
			durationMinutes: durationToMinutes(durationText.value),
			introduction: introduction.value.trim(),
			coverPath: coverPath.value,
			coverMediaId: coverMediaId.value,
			galleryPaths: galleryPaths.value,
			galleryMediaIds: galleryMediaIds.value,
			tagCodes: selectedTagCodes.value,
			locationType: 'PUBLIC_PLACE'
		}
	}

	function submitDraft(afterSubmit: boolean) {
		if (saving.value) {
			return
		}
		if (title.value.trim().length == 0 || categoryCode.value.length == 0) {
			uni.showToast({
				title: '请填写服务名称并选择类目',
				position: 'bottom',
				icon: 'error'
			})
			return
		}
		if (coverPath.value.length == 0) {
			uni.showToast({
				title: '请上传服务封面',
				position: 'bottom',
				icon: 'error'
			})
			return
		}
		if (galleryPaths.value.length == 0) {
			uni.showToast({
				title: '请至少上传 1 张服务图集图片',
				position: 'bottom',
				icon: 'error'
			})
			return
		}
		saving.value = true
		createOrUpdateProviderService(buildDraft()).then((result) => {
			saving.value = false
			if (!result.ok || result.service == null) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			editId.value = result.service.id
			serviceVersion.value = result.service.version
			if (!afterSubmit) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'success'
				})
				return
			}
			submitProviderServiceReview(result.service.id, result.service.version).then((reviewResult) => {
				uni.showToast({
					title: reviewResult.message,
					position: 'bottom',
					icon: reviewResult.ok ? 'success' : 'error'
				})
				if (reviewResult.ok && reviewResult.service != null) {
					serviceVersion.value = reviewResult.service.version
				}
			})
		})
	}

	function saveDraft() {
		submitDraft(false)
	}

	function submitReview() {
		submitDraft(true)
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/services'
				})
			}
		})
	}
</script>

