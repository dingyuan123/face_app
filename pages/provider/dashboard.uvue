<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">服务者工作台</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="summary-card">
				<view class="summary-head">
					<view>
						<text class="summary-kicker">今日概览</text>
						<text class="summary-title">让每一份服务，都清晰可见</text>
					</view>
					<view class="summary-badge">
						<text class="summary-badge-text">生效中</text>
					</view>
				</view>
				<view class="summary-stats">
					<view class="summary-stat">
						<text class="summary-label">今日收入</text>
						<text class="summary-value">{{ dashboard.todayIncome }}</text>
					</view>
					<view class="summary-line"></view>
					<view class="summary-stat">
						<text class="summary-label">今日订单</text>
						<text class="summary-value">{{ dashboard.todayOrders }}</text>
					</view>
				</view>
			</view>

			<view class="profile-manage-card">
				<view class="profile-manage-icon">✎</view>
				<view class="profile-manage-copy">
					<text class="profile-manage-title">服务者资料</text>
					<text class="profile-manage-desc">完善照片、昵称、服务标签和个人介绍</text>
				</view>
				<view class="profile-manage-button" @click="openProviderProfile">
					<text class="profile-manage-button-text">去完善</text>
				</view>
			</view>

			<view class="section-head">
				<text class="section-title">待处理事项</text>
				<text class="section-subtitle">及时处理，服务更顺畅</text>
			</view>

			<view class="task-list">
				<view v-for="task in dashboard.tasks" :key="task.id" class="task-card">
					<view class="task-icon" :class="task.status == '待处理' ? 'task-icon-brand' : 'task-icon-warm'">
						<text class="task-icon-text">{{ task.title.slice(0, 1) }}</text>
					</view>
					<view class="task-main">
						<view class="task-head">
							<text class="task-title">{{ task.title }}</text>
							<text class="task-count">{{ task.count }}</text>
						</view>
						<text class="task-desc">{{ task.description }}</text>
					</view>
					<view class="task-status" :class="task.status == '待处理' ? 'task-status-brand' : 'task-status-warm'">
						<text class="task-status-text">{{ task.status }}</text>
					</view>
				</view>
			</view>

			<view class="section-head">
				<text class="section-title">数据概览</text>
				<text class="section-subtitle">本周经营表现</text>
			</view>

			<view class="metrics-card">
				<view v-for="metric in dashboard.metrics" :key="metric.label" class="metric-item">
					<text class="metric-value">{{ metric.value }}</text>
					<text class="metric-label">{{ metric.label }}</text>
				</view>
			</view>

			<view class="section-head">
				<text class="section-title">快捷入口</text>
				<text class="section-subtitle">高效管理服务</text>
			</view>

			<view class="quick-grid">
				<view v-for="(item, index) in quickItems" :key="item.name" class="quick-item" :class="index % 2 == 0 ? 'quick-item-left' : ''" @click="openQuickAction(item.name)">
					<view class="quick-icon" :class="item.tone">
						<text class="quick-icon-text">{{ item.icon }}</text>
					</view>
					<text class="quick-name">{{ item.name }}</text>
				</view>
			</view>

			<view class="footer-card">
				<text class="footer-title">真实服务，安心见面</text>
				<text class="footer-desc">请遵守平台服务规范，优先选择公共场所。</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProviderDashboard } from '../../services/service-container.uts'
	import type { ProviderDashboardSummary } from '../../types/models.uts'

	const dashboard = ref<ProviderDashboardSummary>(getProviderDashboard())
	const quickItems = [
		{ name: '订单管理', icon: '☷', tone: 'tone-warm' },
		{ name: '服务管理', icon: '▤', tone: 'tone-brand' },
		{ name: '排期管理', icon: '◷', tone: 'tone-warm' },
		{ name: '动态管理', icon: '◫', tone: 'tone-brand' },
		{ name: '收入提现', icon: '¥', tone: 'tone-warm' },
		{ name: '评价管理', icon: '★', tone: 'tone-brand' },
		{ name: '数据看板', icon: '↗', tone: 'tone-warm' },
		{ name: '认证中心', icon: '✓', tone: 'tone-brand' }
	]

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function openProviderProfile() {
		uni.navigateTo({
			url: '/pages/provider/profile'
		})
	}

	function openQuickAction(name: string) {
		if (name == '订单管理') {
			uni.navigateTo({
				url: '/pages/provider/orders'
			})
			return
		}
		if (name == '收入提现') {
			uni.navigateTo({
				url: '/pages/provider/earnings'
			})
			return
		}
		if (name == '评价管理') {
			uni.navigateTo({
				url: '/pages/provider/reviews'
			})
			return
		}
		if (name == '数据看板') {
			uni.navigateTo({
				url: '/pages/provider/analytics'
			})
			return
		}
		if (name == '认证中心') {
			uni.navigateTo({
				url: '/pages/provider/certification'
			})
			return
		}
		if (name == '排期管理') {
			uni.navigateTo({
				url: '/pages/provider/schedule'
			})
			return
		}
		if (name == '动态管理') {
			uni.navigateTo({
				url: '/pages/provider/moment-manage'
			})
			return
		}
		if (name == '服务管理') {
			uni.navigateTo({
				url: '/pages/provider/services'
			})
			return
		}
		uni.showToast({
			title: name + '将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

