<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="gallery">
					<swiper class="gallery-swiper" :current="currentMedia" :circular="true" @change="onMediaChange">
						<swiper-item v-for="(image, index) in provider.galleryImages" :key="index">
							<image class="gallery-image" :src="image" mode="aspectFill"></image>
						</swiper-item>
					</swiper>
					<view class="gallery-mask"></view>
					<view class="gallery-topbar">
						<view class="circle-button" @click="goBack">
							<text class="circle-icon">‹</text>
						</view>
						<view class="gallery-title">
							<text class="gallery-title-text">{{ provider.themeTitle }}</text>
							<text class="gallery-subtitle">{{ provider.subtitle }}</text>
						</view>
						<view class="circle-button" @click="shareProvider">
							<text class="circle-icon">↑</text>
						</view>
					</view>
					<view class="gallery-dots">
						<view
							v-for="(image, index) in provider.galleryImages"
							:key="index"
							class="dot"
							:class="currentMedia == index ? 'dot-active' : ''"
						></view>
					</view>
				</view>

				<view class="profile-card">
					<view class="profile-head">
						<view class="avatar-wrap">
							<image class="provider-avatar" :src="provider.avatar" mode="aspectFill"></image>
							<view class="verified-check">
								<text class="verified-check-text">✓</text>
							</view>
						</view>
						<view class="profile-main">
							<text class="provider-name">{{ provider.providerName }}</text>
							<view class="verified-pill">
								<text class="verified-pill-text">✓ 实名认证</text>
							</view>
							<text class="provider-meta">{{ provider.age }} 岁 · {{ provider.city }} · {{ provider.distance }}</text>
						</view>
					</view>
					<text class="provider-bio">{{ provider.bio }}</text>
					<view class="profile-actions">
						<view class="profile-action follow" @click="followProvider">
							<text class="action-icon">＋</text>
							<text class="action-label">关注</text>
						</view>
						<view class="profile-action favorite profile-action-gap" @click="favoriteProvider">
							<image class="action-icon-image favorite-action-icon" :src="favorited ? '/static/search/heart-filled.png' : '/static/search/heart-outline.png'" mode="aspectFit"></image>
							<text class="action-label favorite-action-label">收藏</text>
						</view>
					</view>
				</view>

				<segment-tabs
					:items="[('动态 ' + provider.momentCount), ('服务 ' + provider.serviceCount)]"
					:active="activeTab"
					variant="underline"
					@change="changeTab"
				></segment-tabs>

				<view v-if="activeTab == ('服务 ' + provider.serviceCount)" class="service-list">
					<view v-for="service in provider.services" :key="service.id" class="service-card" @click="openService(service.id)">
						<image class="service-cover" :src="service.coverImage" mode="aspectFill"></image>
						<view class="service-main">
							<text class="service-title">{{ service.title }}</text>
							<view class="service-tag">
								<text class="service-tag-text">{{ service.tag }}</text>
							</view>
							<text class="service-meta">{{ service.duration }} · {{ service.format }}</text>
							<text class="service-meta">已售 {{ service.soldCount }} 次</text>
						</view>
						<view class="price-block">
							<text class="price-text">{{ service.price }}</text>
						</view>
					</view>
				</view>

				<view v-else class="moment-list">
					<view v-for="moment in provider.moments" :key="moment.id" class="provider-moment" @click="openMoment(moment.id)">
						<image class="moment-cover" :src="moment.coverImage" mode="aspectFill"></image>
						<view class="moment-main">
							<text class="moment-title">{{ moment.title }}</text>
							<text class="moment-description">{{ moment.description }}</text>
							<view class="moment-meta-row">
								<text class="moment-meta">{{ moment.publishedAt }} · {{ moment.location }}</text>
								<text class="moment-count">♡ {{ moment.likeCount }}</text>
							</view>
						</view>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="booking-bar">
			<view class="booking-price">
				<text class="booking-price-value">¥45</text>
				<text class="booking-price-unit">起 / 小时</text>
			</view>
			<view class="booking-button" @click="bookProvider">
				<text class="booking-button-icon">▣</text>
				<text class="booking-button-text">立即预约</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import { getProviderDetail } from '../../services/service-container.uts'
	import type { ProviderDetail } from '../../types/models.uts'
	import { sessionState } from '../../state/session-state.uts'
	import { PROVIDER_DETAIL_ROUTE, requireAccount } from '../../router/route-guard.uts'

	const provider = ref<ProviderDetail>(getProviderDetail('provider-001'))
	const activeTab = ref('服务 3')
	const currentMedia = ref(0)
	const favorited = ref(false)
	const providerId = ref('provider-001')

	onLoad((options) => {
		const id = options['providerId'] as string
		if (id != null && id.length > 0) {
			providerId.value = decodeURIComponent(id)
		}
		provider.value = getProviderDetail(providerId.value)
		if (provider.value != null) {
			activeTab.value = '服务 ' + provider.value.serviceCount
		}
	})

	function onMediaChange(event: any) {
		currentMedia.value = event.detail.current
	}

	function changeTab(tab: string) {
		activeTab.value = tab
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/index/index'
				})
			}
		})
	}

	function shareProvider() {
		uni.showToast({
			title: '分享能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function followProvider() {
		if (!requireAccount('follow-provider', PROVIDER_DETAIL_ROUTE, providerId.value)) {
			return
		}
		uni.showToast({
			title: '已关注（开发 Mock）',
			position: 'bottom',
			icon: 'success'
		})
	}

	function favoriteProvider() {
		if (!requireAccount('favorite-provider', PROVIDER_DETAIL_ROUTE, providerId.value)) {
			return
		}
		uni.showToast({
			title: '已收藏（开发 Mock）',
			position: 'bottom',
			icon: 'success'
		})
	}

	function openService(id: string) {
		uni.navigateTo({
			url: '/pages/service/detail?serviceId=' + encodeURIComponent(id)
		})
	}

	function openMoment(id: string) {
		uni.navigateTo({
			url: '/pages/moment/detail?momentId=' + encodeURIComponent(id)
		})
	}

	function bookProvider() {
		openService(provider.value.services[0].id)
	}
</script>

