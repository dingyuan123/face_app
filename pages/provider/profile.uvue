<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">资料管理</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="provider-card">
				<image class="provider-avatar" :src="avatarPath.length > 0 ? avatarPath : '/static/brand/app-logo.png'" mode="aspectFill"></image>
				<view class="provider-main">
					<text class="provider-name">阿哲</text>
					<view class="verified-pill">
						<text class="verified-text">✓ 已认证</text>
					</view>
					<text class="provider-meta">台球助教 · 泸州江阳区</text>
				</view>
				<view class="status-pill">
					<text class="status-text">生效中</text>
				</view>
			</view>

			<view class="section-card">
				<view class="section-head">
					<text class="section-title">照片墙</text>
					<text class="section-desc">展示真实、清晰的服务照片</text>
				</view>
				<view class="photo-grid">
					<view v-for="(photo, index) in photos" :key="photo" class="photo-item">
						<image class="photo-image" :src="photo" mode="aspectFill"></image>
						<view class="photo-remove" @click="removePhoto(index)">
							<text class="remove-text">×</text>
						</view>
					</view>
					<view v-if="photos.length < 6" class="photo-add" @click="addPhoto">
						<text class="add-plus">＋</text>
						<text class="add-text">添加照片</text>
					</view>
				</view>
			</view>

			<view class="section-card">
				<text class="section-title">基础资料</text>
				<text class="field-label">昵称</text>
				<input
					class="field-input"
					:value="nickname"
					maxlength="20"
					placeholder="请输入服务者昵称"
					placeholder-class="field-placeholder"
					@input="onNicknameInput"
				/>
				<text class="field-label">签名</text>
				<input
					class="field-input"
					:value="signature"
					maxlength="50"
					placeholder="一句话介绍你的服务"
					placeholder-class="field-placeholder"
					@input="onSignatureInput"
				/>
				<text class="field-label">个人介绍</text>
				<textarea
					class="intro-input"
					:value="introduction"
					maxlength="200"
					placeholder="让客户更了解你的服务风格和擅长领域"
					placeholder-class="field-placeholder"
					@input="onIntroductionInput"
				></textarea>
			</view>

			<view class="section-card">
				<text class="section-title">服务类目</text>
				<text class="section-desc">选择你主要提供的服务类型</text>
				<view class="tag-wrap">
					<view
						v-for="item in categoryOptions"
						:key="item.code"
						class="tag-button"
						:class="isCategorySelected(item.code) ? 'tag-active' : ''"
						@click="toggleCategory(item.code)"
					>
						<text class="tag-text" :class="isCategorySelected(item.code) ? 'tag-text-active' : ''">{{ item.name }}</text>
					</view>
				</view>
			</view>

			<view class="section-card">
				<text class="section-title">服务标签</text>
				<text class="section-desc">帮助用户快速了解你的优势</text>
				<view class="tag-wrap">
					<view
						v-for="item in tagOptions"
						:key="item.code"
						class="tag-button"
						:class="isTagSelected(item.code) ? 'tag-active' : ''"
						@click="toggleTag(item.code)"
					>
						<text class="tag-text" :class="isTagSelected(item.code) ? 'tag-text-active' : ''">{{ item.name }}</text>
					</view>
				</view>
			</view>

			<view class="certification-card">
				<view class="certification-copy">
					<text class="certification-title">认证状态</text>
					<text class="certification-desc">实名认证已完成，资料将用于服务展示。</text>
				</view>
				<view class="certification-pill">
					<text class="certification-pill-text">✓ 已认证</text>
				</view>
			</view>

			<view class="bottom-space"></view>
		</view>
		</scroll-view>

		<view class="action-bar">
			<view class="save-button" :class="nickname.trim().length > 0 ? '' : 'save-disabled'" @click="save">
				<text class="save-text">保存资料</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import {
		getProviderProfileData,
		getProviderTagOptions,
		getServiceCategoryOptions,
		updateProviderProfileData
	} from '../../services/service-container.uts'
	import type {
		ProviderOptionItem,
		ProviderProfileData,
		ProviderProfileUpdateDraft
	} from '../../types/models.uts'
	import { sessionState } from '../../state/session-state.uts'
	import { openLogin } from '../../router/route-guard.uts'

	const avatarPath = ref('')
	const avatarMediaId = ref('')
	const avatarChanged = ref(false)
	const photos = ref<string[]>([])
	const photoMediaIds = ref<string[]>([])
	const photoPaths = ref<string[]>([])
	const nickname = ref('')
	const signature = ref('')
	const introduction = ref('')
	const selectedCategoryCodes = ref<string[]>([])
	const selectedTagCodes = ref<string[]>([])
	const categoryOptions = ref<ProviderOptionItem[]>([])
	const tagOptions = ref<ProviderOptionItem[]>([])
	const profileVersion = ref(0)
	const saving = ref(false)

	function isSelected(values: string[], code: string): boolean {
		for (let i = 0; i < values.length; i++) {
			if (values[i] == code) {
				return true
			}
		}
		return false
	}

	function isCategorySelected(code: string): boolean {
		return isSelected(selectedCategoryCodes.value, code)
	}

	function isTagSelected(code: string): boolean {
		return isSelected(selectedTagCodes.value, code)
	}

	function toggleCategory(code: string) {
		const next: string[] = []
		for (let i = 0; i < selectedCategoryCodes.value.length; i++) {
			if (selectedCategoryCodes.value[i] != code) {
				next.push(selectedCategoryCodes.value[i])
			}
		}
		if (next.length == selectedCategoryCodes.value.length) {
			next.push(code)
		}
		selectedCategoryCodes.value = next
	}

	function toggleTag(code: string) {
		const next: string[] = []
		for (let i = 0; i < selectedTagCodes.value.length; i++) {
			if (selectedTagCodes.value[i] != code) {
				next.push(selectedTagCodes.value[i])
			}
		}
		if (next.length == selectedTagCodes.value.length) {
			if (next.length >= 8) {
				uni.showToast({
					title: '最多选择 8 个服务标签',
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			next.push(code)
		}
		selectedTagCodes.value = next
	}

	function loadOptions() {
		getServiceCategoryOptions().then((result) => {
			if (result.ok) {
				categoryOptions.value = result.items
			}
		})
		getProviderTagOptions().then((result) => {
			if (result.ok) {
				tagOptions.value = result.items
			}
		})
	}

	function loadProfile() {
		getProviderProfileData().then((result) => {
			if (!result.ok || result.profile == null) {
				if (!result.ok) {
					uni.showToast({
						title: result.message,
						position: 'bottom',
						icon: 'error'
					})
				}
				return
			}
			const profile = result.profile
			profileVersion.value = profile.version
			nickname.value = profile.nickname
			signature.value = profile.signature
			introduction.value = profile.introduction
			avatarPath.value = profile.avatarUrl
			avatarMediaId.value = profile.avatarMediaId
			avatarChanged.value = false
			photos.value = profile.photoUrls
			photoPaths.value = profile.photoUrls
			photoMediaIds.value = profile.photoMediaIds
			selectedCategoryCodes.value = profile.categoryCodes
			selectedTagCodes.value = profile.tagCodes
		})
	}

	onShow(() => {
		if (!sessionState.loggedIn) {
			openLogin('provider-profile', '/pages/provider/profile', '')
			return
		}
		loadProfile()
		loadOptions()
	})

	function onNicknameInput(event: InputEvent) {
		nickname.value = event.detail.value
	}

	function onSignatureInput(event: InputEvent) {
		signature.value = event.detail.value
	}

	function onIntroductionInput(event: InputEvent) {
		introduction.value = event.detail.value
	}

	function chooseAvatar() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				if (res.tempFilePaths.length > 0) {
					avatarPath.value = res.tempFilePaths[0]
					avatarChanged.value = true
				}
			}
		})
	}

	function addPhoto() {
		const remaining = 6 - photos.value.length
		if (remaining <= 0) {
			uni.showToast({
				title: '最多上传 6 张照片',
				position: 'bottom',
				icon: 'error'
			})
			return
		}
		uni.chooseImage({
			count: remaining,
			success: (res) => {
				const nextPaths: string[] = []
				const nextIds: string[] = []
				for (let i = 0; i < photoPaths.value.length; i++) {
					nextPaths.push(photoPaths.value[i])
				}
				for (let i = 0; i < photoMediaIds.value.length; i++) {
					nextIds.push(photoMediaIds.value[i])
				}
				for (let i = 0; i < res.tempFilePaths.length && nextPaths.length < 6; i++) {
					nextPaths.push(res.tempFilePaths[i])
				}
				photoPaths.value = nextPaths
				photos.value = nextPaths
				photoMediaIds.value = nextIds
			}
		})
	}

	function removePhoto(index: number) {
		const nextPaths: string[] = []
		const nextIds: string[] = []
		for (let i = 0; i < photoPaths.value.length; i++) {
			if (i != index) {
				nextPaths.push(photoPaths.value[i])
			}
		}
		for (let i = 0; i < photoMediaIds.value.length; i++) {
			if (i != index) {
				nextIds.push(photoMediaIds.value[i])
			}
		}
		photoPaths.value = nextPaths
		photos.value = nextPaths
		photoMediaIds.value = nextIds
	}

	function save() {
		if (saving.value) {
			return
		}
		saving.value = true
		const draft: ProviderProfileUpdateDraft = {
			expectedVersion: profileVersion.value,
			nickname: nickname.value,
			signature: signature.value,
			introduction: introduction.value,
			avatarPath: avatarChanged.value ? avatarPath.value : '',
			avatarMediaId: avatarMediaId.value,
			photoPaths: photoPaths.value,
			photoMediaIds: photoMediaIds.value,
			categoryCodes: selectedCategoryCodes.value,
			tagCodes: selectedTagCodes.value
		}
		updateProviderProfileData(draft).then((result) => {
			saving.value = false
			uni.showToast({
				title: result.message,
				position: 'bottom',
				icon: result.ok ? 'success' : 'error'
			})
			if (result.ok && result.profile != null) {
				profileVersion.value = result.profile.version
				avatarPath.value = result.profile.avatarUrl
				avatarMediaId.value = result.profile.avatarMediaId
				photos.value = result.profile.photoUrls
				photoPaths.value = result.profile.photoUrls
				photoMediaIds.value = result.profile.photoMediaIds
				avatarChanged.value = false
			}
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

