<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">数据看板</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="period-card">
				<view class="period-button" :class="period == '近7天' ? 'period-active' : ''" @click="changePeriod('近7天')">
					<text class="period-text" :class="period == '近7天' ? 'period-text-active' : ''">近7天</text>
				</view>
				<view class="period-button" :class="period == '近30天' ? 'period-active' : ''" @click="changePeriod('近30天')">
					<text class="period-text" :class="period == '近30天' ? 'period-text-active' : ''">近30天</text>
				</view>
			</view>

			<view class="metric-grid">
				<view v-for="metric in summary.metrics" :key="metric.label" class="metric-card">
					<text class="metric-label">{{ metric.label }}</text>
					<text class="metric-value">{{ metric.value }}</text>
					<text class="metric-delta">{{ metric.delta }} 较上期</text>
				</view>
			</view>

			<view class="section-card">
				<view class="section-head">
					<view>
						<text class="section-title">收入趋势</text>
						<text class="section-subtitle">{{ period }}服务收入变化</text>
					</view>
					<view class="trend-total">
						<text class="trend-total-label">合计</text>
						<text class="trend-total-value">¥12,860</text>
					</view>
				</view>
				<view class="chart-area">
					<view class="chart-line line-one"></view>
					<view class="chart-line line-two"></view>
					<view class="chart-line line-three"></view>
					<view class="trend-row">
						<view v-for="point in summary.trend" :key="point.label" class="trend-column">
							<text class="trend-value">{{ point.value }}</text>
							<view class="trend-bar" :class="barClass(point.level)">
								<view class="trend-dot"></view>
							</view>
							<text class="trend-label">{{ point.label }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="section-card">
				<view class="section-head">
					<view>
						<text class="section-title">转化漏斗</text>
						<text class="section-subtitle">从浏览到完成订单的转化</text>
					</view>
				</view>
				<view class="funnel-list">
					<view v-for="item in summary.funnel" :key="item.label" class="funnel-row">
						<text class="funnel-label">{{ item.label }}</text>
						<view class="funnel-track">
							<view class="funnel-fill" :class="funnelClass(item.ratio)"></view>
						</view>
						<text class="funnel-value">{{ item.value }}</text>
					</view>
				</view>
			</view>

			<view class="insight-card">
				<text class="insight-title">经营建议</text>
				<text class="insight-text">周末订单转化率较高，可适当增加周末可约时段；服务详情页访问到预约仍有提升空间。</text>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProviderAnalytics } from '../../services/service-container.uts'
	import type { ProviderAnalyticsSummary } from '../../types/models.uts'

	const period = ref('近7天')
	const summary = ref<ProviderAnalyticsSummary>(getProviderAnalytics())

	function changePeriod(value: string) {
		period.value = value
	}

	function barClass(level: number): string {
		if (level >= 7) {
			return 'trend-height-7'
		}
		if (level == 6) {
			return 'trend-height-6'
		}
		if (level == 5) {
			return 'trend-height-5'
		}
		if (level == 4) {
			return 'trend-height-4'
		}
		if (level == 3) {
			return 'trend-height-3'
		}
		return 'trend-height-2'
	}

	function funnelClass(ratio: number): string {
		if (ratio >= 90) {
			return 'funnel-width-100'
		}
		if (ratio >= 70) {
			return 'funnel-width-80'
		}
		if (ratio >= 50) {
			return 'funnel-width-60'
		}
		if (ratio >= 35) {
			return 'funnel-width-45'
		}
		return 'funnel-width-35'
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

