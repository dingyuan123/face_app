		<view class="action-bar">
			<view v-if="detail.order.status == '待接单'" class="action-button action-outline" @click="rejectOrder">
				<text class="action-outline-text">拒单</text>
			</view>
			<view v-if="detail.order.status == '待接单'" class="action-button action-primary" @click="acceptOrder">
				<text class="action-primary-text">接单</text>
			</view>
			<view v-if="detail.order.status == '待履约'" class="action-button action-outline" @click="changeSchedule">
				<text class="action-outline-text">改期</text>
			</view>
			<view v-if="detail.order.status == '待履约' || detail.order.status == '进行中'" class="action-button action-primary" @click="completeOrder">
				<text class="action-primary-text">确认完成</text>
			</view>
			<view v-if="detail.order.status == '已完成' || detail.order.status == '已取消'" class="action-button action-outline" @click="contactUser">
