			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import {
		acceptProviderOrder,
		completeProviderOrder,
		getProviderOrderDetail,
		rejectProviderOrder
	} from '../../services/service-container.uts'
	import type { ProviderOrderDetail } from '../../types/models.uts'

	const orderId = ref('provider-order-001')
	const detail = ref<ProviderOrderDetail>(getProviderOrderDetail('provider-order-001'))

	onLoad((options) => {
		if (options == null) {
			return
		}
		const value = options['orderId'] as string
		if (value != null && value.length > 0) {
			orderId.value = decodeURIComponent(value)
		}
		detail.value = getProviderOrderDetail(orderId.value)
	})

	function refreshDetail() {
		detail.value = getProviderOrderDetail(orderId.value)
	}

	function statusIcon(status: string): string {
		if (status == '已完成') {
			return '✓'
		}
		if (status == '已取消') {
			return '×'
		}
		if (status == '进行中') {
			return '●'
		}
		return '◷'
	}

	function statusIconClass(status: string): string {
		if (status == '已完成') {
			return 'status-icon-success'
		}
		if (status == '已取消') {
			return 'status-icon-muted'
		}
		return 'status-icon-warning'
	}

	function statusDescription(status: string): string {
		if (status == '待接单') {
			return '用户已预约，请确认是否接单'
		}
		if (status == '待履约') {
			return '已接单，请按预约时间完成服务'
		}
		if (status == '进行中') {
			return '服务进行中，完成后请确认订单'
		}
		if (status == '已完成') {
			return '本次服务已完成'
		}
		return '订单已取消'
	}

	function timelineMarkerClass(state: string): string {
		if (state == 'done') {
			return 'marker-done'
		}
		if (state == 'current') {
			return 'marker-current'
		}
		return 'marker-future'
	}

	function showResult(ok: boolean, message: string) {
		uni.showToast({
			title: message,
			position: 'bottom',
			icon: ok ? 'success' : 'error'
		})
	}

	function acceptOrder() {
		const result = acceptProviderOrder(orderId.value)
		refreshDetail()
		showResult(result.ok, result.message)
	}

	function completeOrder() {
		const result = completeProviderOrder(orderId.value)
		refreshDetail()
		showResult(result.ok, result.message)
	}

	function rejectOrder() {
		uni.showModal({
			title: '确认拒绝订单',
			content: '拒绝后订单将变为已取消，是否继续？',
			confirmText: '确认拒绝',
			cancelText: '再想想',
			success: (result) => {
				if (result.confirm) {
					const outcome = rejectProviderOrder(orderId.value)
					refreshDetail()
					showResult(outcome.ok, outcome.message)
				}
			}
		})
	}

	function changeSchedule() {
		uni.showToast({
			title: '订单改期将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function contactUser() {
		uni.navigateTo({
			url: '/pages/chat/detail?threadId=' + encodeURIComponent(orderId.value)
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/orders'
				})
			}
		})
	}
</script>

