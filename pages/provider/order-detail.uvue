							<view class="timeline-marker-wrap">
								<view class="timeline-marker" :class="timelineMarkerClass(item.state)"></view>
								<view v-if="index < detail.timeline.length - 1" class="timeline-line"></view>
							</view>
							<view class="timeline-copy">
								<text class="timeline-title">{{ item.title }}</text>
								<text class="timeline-desc">{{ item.description }}</text>
								<text v-if="item.time.length > 0" class="timeline-time">{{ item.time }}</text>
							</view>
