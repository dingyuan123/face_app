						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">订单详情</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="status-card">
					<view class="status-icon" :class="statusIconClass(detail.order.status)">
						<text class="status-icon-text">{{ statusIcon(detail.order.status) }}</text>
					</view>
					<view class="status-copy">
						<text class="status-title">{{ detail.order.status }}</text>
						<text class="status-desc">{{ statusDescription(detail.order.status) }}</text>
					</view>
					<text class="order-no">{{ detail.order.orderNo }}</text>
				</view>

				<view class="section-card">
					<text class="section-title">用户信息</text>
					<view class="user-row">
						<image class="user-avatar" :src="detail.order.customerAvatar" mode="aspectFill"></image>
						<view class="user-main">
							<view class="user-name-row">
								<text class="user-name">{{ detail.order.customerName }}</text>
								<view v-if="detail.order.customerVerified" class="verified-pill">
									<text class="verified-text">✓ 已认证</text>
								</view>
							</view>
							<text class="user-meta">已完成实名核验</text>
						</view>
						<view class="contact-button" @click="contactUser">
							<text class="contact-text">联系</text>
						</view>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">服务信息</text>
					<view class="service-row">
						<view class="service-icon">
							<text class="service-icon-text">服</text>
						</view>
						<view class="service-main">
							<text class="service-title">{{ detail.order.serviceTitle }}</text>
							<text class="service-meta">{{ detail.order.duration }} · 公共场所服务</text>
						</view>
						<text class="service-amount">{{ detail.order.amount }}</text>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">预约信息</text>
					<view class="info-row">
						<text class="info-icon">◷</text>
