<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">订单管理</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="summary-card">
				<view class="summary-copy">
					<text class="summary-kicker">服务订单</text>
					<text class="summary-title">及时确认每一次见面</text>
					<text class="summary-desc">请认真核对时间、地点和用户需求</text>
				</view>
				<view class="summary-badge">
					<text class="summary-badge-text">服务中</text>
				</view>
			</view>

			<view class="stats-card">
				<view class="stat-item">
					<text class="stat-value stat-value-brand">{{ pendingCount }}</text>
					<text class="stat-label">待接单</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item">
					<text class="stat-value stat-value-warm">{{ todayCount }}</text>
					<text class="stat-label">今日预约</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item">
					<text class="stat-value stat-value-success">{{ completedCount }}</text>
					<text class="stat-label">已完成</text>
				</view>
			</view>

			<view class="safety-banner">
				<text class="safety-icon">✓</text>
				<text class="safety-text">安心见面，请优先选择公共经营场所</text>
			</view>

			<segment-tabs
				class="order-tabs"
				:items="tabs"
				:active="activeTab"
				variant="underline"
				@change="changeTab"
			></segment-tabs>

			<view v-if="orders.length == 0" class="empty-state">
				<text class="empty-title">暂无相关订单</text>
				<text class="empty-desc">换个状态看看吧</text>
			</view>

			<view v-else class="order-list">
				<view v-for="order in orders" :key="order.id" class="order-card">
					<view class="order-head">
						<image class="customer-avatar" :src="order.customerAvatar" mode="aspectFill"></image>
						<view class="customer-main">
							<view class="customer-name-row">
								<text class="customer-name">{{ order.customerName }}</text>
								<view v-if="order.customerVerified" class="verified-pill">
									<text class="verified-text">✓ 已认证</text>
								</view>
							</view>
							<text class="order-number">订单号 {{ order.orderNo }}</text>
						</view>
						<view class="status-pill" :class="statusClass(order.status)">
							<text class="status-text" :class="statusTextClass(order.status)">{{ order.status }}</text>
						</view>
					</view>

					<view class="service-row">
						<text class="service-title">{{ order.serviceTitle }}</text>
						<text class="service-duration">{{ order.duration }}</text>
					</view>

					<view class="info-card">
						<view class="info-row">
							<text class="info-icon">◷</text>
							<text class="info-text">{{ order.appointmentDate }} · {{ order.appointmentTime }}</text>
						</view>
						<view class="info-row">
							<text class="info-icon">⌖</text>
							<text class="info-text">{{ order.location }}</text>
						</view>
					</view>

					<view class="note-card">
						<text class="note-label">用户留言</text>
						<text class="note-text">{{ order.note }}</text>
					</view>

					<view class="order-bottom">
						<view class="amount-wrap">
							<text class="amount-label">订单金额</text>
							<text class="amount-value">{{ order.amount }}</text>
						</view>
						<view class="action-wrap">
							<view v-if="order.status == '待接单'" class="action-button action-outline" @click="handleAction(order, 'reject')">
								<text class="action-outline-text">拒单</text>
							</view>
							<view v-if="order.status == '待接单'" class="action-button action-primary" @click="handleAction(order, 'accept')">
								<text class="action-primary-text">接单</text>
							</view>
							<view v-if="order.status == '待履约' || order.status == '进行中'" class="action-button action-primary" @click="handleAction(order, 'complete')">
								<text class="action-primary-text">确认完成</text>
							</view>
							<view v-if="order.status == '已完成' || order.status == '已取消'" class="action-button action-outline" @click="handleAction(order, 'detail')">
								<text class="action-outline-text">查看详情</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import {
		acceptProviderOrder,
		completeProviderOrder,
		getProviderOrderItems,
		rejectProviderOrder
	} from '../../services/service-container.uts'
	import type { ProviderOrderItem } from '../../types/models.uts'

	const tabs = ['全部', '待接单', '待履约', '进行中', '已完成']
	const activeTab = ref('全部')
	const orders = ref<ProviderOrderItem[]>(getProviderOrderItems('全部'))
	const pendingCount = ref(0)
	const todayCount = ref(0)
	const completedCount = ref(0)

	function refreshStats() {
		const all = getProviderOrderItems('全部')
		let pending = 0
		let today = 0
		let completed = 0
		for (let i = 0; i < all.length; i++) {
			if (all[i].status == '待接单') {
				pending++
			}
			if (all[i].appointmentDate == '今天') {
				today++
			}
			if (all[i].status == '已完成') {
				completed++
			}
		}
		pendingCount.value = pending
		todayCount.value = today
		completedCount.value = completed
	}

	function refreshOrders() {
		orders.value = getProviderOrderItems(activeTab.value)
		refreshStats()
	}

	refreshStats()

	function changeTab(tab: string) {
		activeTab.value = tab
		refreshOrders()
	}

	function statusClass(status: string): string {
		if (status == '已完成') {
			return 'status-success-bg'
		}
		if (status == '待接单' || status == '待履约' || status == '进行中') {
			return 'status-warning-bg'
		}
		return 'status-muted-bg'
	}

	function statusTextClass(status: string): string {
		if (status == '已完成') {
			return 'status-success-text'
		}
		if (status == '待接单' || status == '待履约' || status == '进行中') {
			return 'status-warning-text'
		}
		return 'status-muted-text'
	}

	function showToast(resultOk: boolean, message: string) {
		uni.showToast({
			title: message,
			position: 'bottom',
			icon: resultOk ? 'success' : 'error'
		})
	}

	function handleAction(order: ProviderOrderItem, action: string) {
		if (action == 'accept') {
			const result = acceptProviderOrder(order.id)
			refreshOrders()
			showToast(result.ok, result.message)
			return
		}
		if (action == 'complete') {
			const result = completeProviderOrder(order.id)
			refreshOrders()
			showToast(result.ok, result.message)
			return
		}
		if (action == 'reject') {
			uni.showModal({
				title: '确认拒绝订单',
				content: '拒绝后订单将变为已取消，是否继续？',
				confirmText: '确认拒绝',
				cancelText: '再想想',
				success: (result) => {
					if (result.confirm) {
						const outcome = rejectProviderOrder(order.id)
						refreshOrders()
						showToast(outcome.ok, outcome.message)
					}
				}
			})
			return
		}
		uni.navigateTo({
			url: '/pages/provider/order-detail?orderId=' + encodeURIComponent(order.id)
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

