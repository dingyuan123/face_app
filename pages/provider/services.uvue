<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">服务管理</text>
				<view class="create-button" @click="createService">
					<text class="create-plus">＋</text>
					<text class="create-text">创建服务</text>
				</view>
			</view>

			<view class="summary-card">
				<view class="summary-item">
					<text class="summary-value">{{ services.length }}</text>
					<text class="summary-label">全部服务</text>
				</view>
				<view class="summary-line"></view>
				<view class="summary-item">
					<text class="summary-value">{{ onlineCount }}</text>
					<text class="summary-label">已上架</text>
				</view>
				<view class="summary-line"></view>
				<view class="summary-item">
					<text class="summary-value">{{ totalSold }}</text>
					<text class="summary-label">累计已售</text>
				</view>
			</view>

			<view v-if="services.length == 0" class="empty-state">
				<image class="empty-image" src="/static/moments/empty.png" mode="aspectFit"></image>
				<text class="empty-title">还没有服务项目</text>
				<text class="empty-desc">创建服务后，用户才能预约你的服务。</text>
				<view class="empty-button" @click="createService">
					<text class="empty-button-text">创建服务</text>
				</view>
			</view>

			<view v-else class="service-list">
				<view v-for="service in services" :key="service.id" class="service-card">
					<view class="service-main-row">
						<image class="service-cover" :src="service.coverImage" mode="aspectFill"></image>
						<view class="service-main">
							<view class="service-head">
								<text class="service-title">{{ service.title }}</text>
								<view class="status-pill" :class="statusClass(service.status)">
									<text class="status-text" :class="service.status == '审核中' ? 'status-text-pending' : service.status == '下架' ? 'status-text-offline' : ''">{{ service.status }}</text>
								</view>
							</view>
							<text class="service-meta">{{ service.duration }} · 已售 {{ service.soldCount }} 次</text>
							<text class="service-price">{{ service.price }}</text>
						</view>
					</view>
					<view class="service-action-row">
						<view class="action-button" @click="editService(service.id)">
							<text class="action-text">编辑</text>
						</view>
						<view class="action-button" @click="toggleStatus(service.id)">
							<text class="action-text">{{ service.status == '上架' ? '下架' : '上架' }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProviderManageServices, toggleProviderService } from '../../services/service-container.uts'
	import type { ProviderManageServiceItem } from '../../types/models.uts'

	const services = ref<ProviderManageServiceItem[]>(getProviderManageServices())

	const onlineCount = ref(0)
	const totalSold = ref(0)

	function refreshStats() {
		let online = 0
		let sold = 0
		for (let i = 0; i < services.value.length; i++) {
			if (services.value[i].status == '上架') {
				online++
			}
			sold += services.value[i].soldCount
		}
		onlineCount.value = online
		totalSold.value = sold
	}

	refreshStats()

	function statusClass(status: string): string {
		if (status == '上架') {
			return 'status-online'
		}
		if (status == '审核中') {
			return 'status-pending'
		}
		return 'status-offline'
	}

	function createService() {
		uni.navigateTo({
			url: '/pages/provider/service-edit'
		})
	}

	function editService(id: string) {
		uni.navigateTo({
			url: '/pages/provider/service-edit?serviceId=' + encodeURIComponent(id)
		})
	}

	function toggleStatus(id: string) {
		const result = toggleProviderService(id)
		services.value = getProviderManageServices()
		refreshStats()
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/dashboard'
				})
			}
		})
	}
</script>

<style lang="scss">
