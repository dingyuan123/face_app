<template>
	<view class="page">
		<view class="page-head">
			<text class="eyebrow">服务者申请</text>
			<text class="title">提交真实资料，等待平台审核</text>
			<text class="description">当前为单页统一提交。离开页面后未提交内容会清空；已提交申请和审核历史会保留。</text>
		</view>

		<view v-if="latest != null" class="current-status">
			<view class="status-row">
				<text class="status-title">当前申请状态</text>
				<status-pill :label="statusLabel" :tone="statusTone"></status-pill>
			</view>
			<text class="current-message">{{ currentStatusMessage }}</text>
		</view>

		<view class="benefit-card">
			<text class="section-title">成为服务者</text>
			<view class="benefit-row">
				<view class="benefit-item">
					<text class="benefit-icon">01</text>
					<text class="benefit-title">技能变现</text>
					<text class="benefit-desc">把擅长的陪伴技能转化为服务</text>
				</view>
				<view class="benefit-item">
					<text class="benefit-icon">02</text>
					<text class="benefit-title">真实展示</text>
					<text class="benefit-desc">通过资料审核后展示服务能力</text>
				</view>
				<view class="benefit-item">
					<text class="benefit-icon">03</text>
					<text class="benefit-title">平台保障</text>
					<text class="benefit-desc">在规范流程下提供安心服务</text>
				</view>
			</view>
			<view class="condition-line">
				<text class="condition-label">申请条件</text>
				<text class="condition-text">资料真实清晰 · 同意平台审核 · 遵守公共场所见面规范</text>
			</view>
		</view>

		<view class="form-card">
			<text class="section-title">申请资料</text>
			<text class="field-label">头像</text>
			<view class="upload-row">
				<view class="avatar-preview" @click="chooseAvatar">
					<image v-if="avatarPath.length > 0" class="avatar-image" :src="avatarPath" mode="aspectFill"></image>
					<text v-else class="upload-plus">＋</text>
				</view>
				<view class="upload-copy">
					<text class="upload-title">上传头像</text>
					<text class="upload-desc">建议使用清晰、真实的正脸照片</text>
				</view>
			</view>

			<text class="field-label">生活照</text>
			<view class="life-photo" @click="chooseLifePhoto">
				<image v-if="lifePhotoPath.length > 0" class="life-image" :src="lifePhotoPath" mode="aspectFill"></image>
				<view v-else class="upload-empty">
					<text class="upload-plus large">＋</text>
					<text class="upload-desc">点击上传生活照</text>
				</view>
			</view>

			<text class="field-label">个人简介</text>
			<textarea
				class="textarea"
				:value="bio"
				maxlength="120"
				placeholder="介绍你的服务风格、擅长领域和见面偏好"
				placeholder-class="placeholder"
				@input="onBioInput"
			></textarea>

			<text class="field-label">真实姓名</text>
			<input
				class="input"
				:value="realName"
				maxlength="20"
				placeholder="请输入与证件一致的真实姓名"
				placeholder-class="placeholder"
				@input="onRealNameInput"
			/>

			<text class="field-label">身份证信息</text>
			<input
				class="input"
				type="text"
				:value="idCardNumber"
				maxlength="18"
				placeholder="请输入 18 位身份证号码"
				placeholder-class="placeholder"
				@input="onIdCardInput"
			/>
			<view class="privacy-note">
				<text class="privacy-title">敏感信息说明</text>
				<text class="privacy-text">真实姓名和身份证信息仅用于服务者资格审核。开发 Mock 仅保存脱敏摘要，不保存未提交表单或明文身份证号码。</text>
			</view>
		</view>

		<view v-if="history.length > 0" class="history-card">
			<view class="history-head">
				<text class="section-title">申请与审核历史</text>
				<text class="history-count">共 {{ history.length }} 条</text>
			</view>
			<view v-for="record in history" :key="record.id" class="history-item">
				<view class="history-main">
					<text class="history-time">{{ formatDate(record.submittedAt) }}</text>
					<status-pill :label="labelFor(record.status)" :tone="toneFor(record.status)"></status-pill>
				</view>
				<text v-if="record.rejectionReason.length > 0" class="history-reason">{{ record.rejectionReason }}</text>
			</view>
		</view>

		<facetof-button
			:label="submitLabel"
			tone="gradient"
			:disabled="submitting"
			@press="submit"
		></facetof-button>
		<text class="form-tip">提交后不可撤回为草稿；重新进入本页时，未提交内容会清空。</text>
	</view>
</template>

<script setup lang="uts">
	import FacetofButton from '../../components/facetof-button.uvue'
	import StatusPill from '../../components/status-pill.uvue'
	import { getApplicationHistory, getLatestApplication, submitProviderApplication } from '../../services/service-container.uts'
	import type { ProviderApplicationRecord } from '../../types/models.uts'
	import { sessionState, setRejectionReason } from '../../state/session-state.uts'
	import { openLogin } from '../../router/route-guard.uts'

	const avatarPath = ref('')
	const lifePhotoPath = ref('')
	const bio = ref('')
	const realName = ref('')
	const idCardNumber = ref('')
	const submitting = ref(false)
	const history = ref<ProviderApplicationRecord[]>([])
	const latest = ref<ProviderApplicationRecord | null>(null)

	function refreshState() {
		history.value = getApplicationHistory()
		latest.value = getLatestApplication()
		if (latest.value != null && latest.value.status == 'rejected') {
			bio.value = latest.value.bio
			realName.value = latest.value.realName
		}
	}

	onShow(() => {
		if (!sessionState.loggedIn) {
			openLogin('provider-apply', '/pages/provider/apply', '')
			return
		}
		refreshState()
	})

	function onBioInput(event: InputEvent) {
		bio.value = event.detail.value
	}

	function onRealNameInput(event: InputEvent) {
		realName.value = event.detail.value
	}

	function onIdCardInput(event: InputEvent) {
		idCardNumber.value = event.detail.value
	}

	function chooseAvatar() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				if (res.tempFilePaths.length > 0) {
					avatarPath.value = res.tempFilePaths[0]
				}
			}
		})
	}

	function chooseLifePhoto() {
		uni.chooseImage({
			count: 1,
			success: (res) => {
				if (res.tempFilePaths.length > 0) {
					lifePhotoPath.value = res.tempFilePaths[0]
				}
			}
		})
	}

	function labelFor(status: string): string {
		if (status == 'approved') {
			return '审核通过'
		}
		if (status == 'rejected') {
			return '审核拒绝'
		}
		if (status == 'pending') {
			return '审核中'
		}
		return '未提交'
	}

	function toneFor(status: string): string {
		if (status == 'approved') {
			return 'success'
		}
		if (status == 'rejected') {
			return 'danger'
		}
		if (status == 'pending') {
			return 'warning'
		}
		return 'neutral'
	}

	function statusLabelForRecord(record: ProviderApplicationRecord | null): string {
		return record == null ? '尚未提交' : labelFor(record.status)
	}

	const statusLabel = computed(() : string => statusLabelForRecord(latest.value))
	const statusTone = computed(() : string => latest.value == null ? 'neutral' : toneFor(latest.value!.status))
	const currentStatusMessage = computed(() : string => {
		const record = latest.value
		if (record == null) {
			return '尚未提交申请。'
		}
		if (record.status == 'rejected') {
			return '拒绝原因：' + record.rejectionReason
		}
		if (record.status == 'approved') {
			return '审核已通过。工作台入口将在个人中心展示，默认登录仍进入普通用户首页。'
		}
		return '资料已提交，请耐心等待审核。'
	})
	const submitLabel = computed(() : string => {
		return latest.value != null && latest.value!.status == 'rejected' ? '修改后重新提交' : '提交审核'
	})

	function formatDate(value: string): string {
		return value.replace('T', ' ').slice(0, 16)
	}

	function submit() {
		if (submitting.value) {
			return
		}
		submitting.value = true
		const result = submitProviderApplication({
			avatarPath: avatarPath.value,
			lifePhotoPath: lifePhotoPath.value,
			bio: bio.value,
			realName: realName.value,
			idCardNumber: idCardNumber.value
		})
		submitting.value = false
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
		if (result.ok) {
			setRejectionReason('')
			avatarPath.value = ''
			lifePhotoPath.value = ''
			bio.value = ''
			realName.value = ''
			idCardNumber.value = ''
			refreshState()
		}
	}
</script>

