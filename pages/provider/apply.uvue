<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-head">
			<text class="eyebrow">服务者申请</text>
			<text class="title">提交真实资料，等待平台审核</text>
			<text class="description">当前为单页统一提交。离开页面后未提交内容会清空；已提交申请和审核历史会保留。</text>
		</view>

		<view v-if="latest != null" class="current-status">
			<view class="status-row">
				<text class="status-title">当前申请状态</text>
				<status-pill :label="statusLabel" :tone="statusTone"></status-pill>
			</view>
			<text class="current-message">{{ currentStatusMessage }}</text>
			<text v-if="formLocked" class="readonly-message">审核期间资料只读，不能修改或重复提交。</text>
		</view>

		<view class="benefit-card">
			<text class="section-title">成为服务者</text>
			<view class="benefit-row">
				<view class="benefit-item">
					<text class="benefit-icon">01</text>
					<text class="benefit-title">技能变现</text>
					<text class="benefit-desc">把擅长的陪伴技能转化为服务</text>
				</view>
				<view class="benefit-item">
					<text class="benefit-icon">02</text>
					<text class="benefit-title">真实展示</text>
					<text class="benefit-desc">通过资料审核后展示服务能力</text>
				</view>
				<view class="benefit-item benefit-item-last">
					<text class="benefit-icon">03</text>
					<text class="benefit-title">平台保障</text>
					<text class="benefit-desc">在规范流程下提供安心服务</text>
				</view>
			</view>
			<view class="condition-line">
				<text class="condition-label">申请条件</text>
				<text class="condition-text">资料真实清晰 · 同意平台审核 · 遵守公共场所见面规范</text>
			</view>
		</view>

		<view class="form-card">
			<text class="section-title">申请资料</text>
			<text class="field-label">头像</text>
			<view class="upload-row">
				<view class="avatar-preview" @click="chooseAvatar">
					<image v-if="avatarPath.length > 0" class="avatar-image" :src="avatarPath" mode="aspectFill"></image>
					<text v-else class="upload-plus">＋</text>
				</view>
				<view class="upload-copy">
					<text class="upload-title">上传头像</text>
					<text class="upload-desc">建议使用清晰、真实的正脸照片</text>
				</view>
			</view>

			<text class="field-label">生活照（{{ lifePhotoPaths.length }}/9）</text>
			<text class="field-hint">请上传 3-9 张真实生活照，提交前可删除和继续添加</text>
			<view class="life-photo-grid">
				<view v-for="(photo, index) in lifePhotoPaths" :key="photo" class="life-photo-item">
					<image class="life-photo-image" :src="photo" mode="aspectFill"></image>
					<view v-if="!formLocked" class="life-photo-remove" @click="removeLifePhoto(index)">
						<text class="life-photo-remove-text">×</text>
					</view>
				</view>
				<view v-if="!formLocked && lifePhotoPaths.length < 9" class="life-photo-add" @click="chooseLifePhoto">
					<text class="upload-plus large">＋</text>
					<text class="upload-desc">添加生活照</text>
				</view>
			</view>

			<text class="field-label">个人简介</text>
			<textarea
				class="textarea"
				:value="bio"
				maxlength="120"
				:disabled="formLocked"
				:placeholder="formLocked ? '审核期间不回显编辑' : '介绍你的服务风格、擅长领域和见面偏好'"
				placeholder-class="placeholder"
				@input="onBioInput"
			></textarea>

			<text class="field-label">真实姓名</text>
			<input
				class="input"
				:value="realName"
				maxlength="20"
				:disabled="formLocked"
				:placeholder="formLocked ? '审核期间不回显敏感信息' : '请输入与证件一致的真实姓名'"
				placeholder-class="placeholder"
				@input="onRealNameInput"
			/>

			<text class="field-label">身份证信息</text>
			<input
				class="input"
				type="text"
				:value="idCardNumber"
				maxlength="18"
				:disabled="formLocked"
				:placeholder="formLocked ? '审核期间不回显敏感信息' : '请输入 18 位身份证号码'"
				placeholder-class="placeholder"
				@input="onIdCardInput"
			/>
			<view class="privacy-note">
				<text class="privacy-title">敏感信息说明</text>
				<text class="privacy-text">真实姓名和身份证信息仅用于服务者资格审核。开发 Mock 仅保存脱敏摘要，不保存未提交表单或明文身份证号码。</text>
			</view>

			<view v-if="formLocked" class="review-summary">
				<text class="review-summary-title">审核资料状态</text>
				<text class="review-summary-text">实名核验：{{ reviewRealNameStatus() }}</text>
				<text class="review-summary-text">人脸核验：{{ reviewFaceStatus() }}</text>
				<text class="review-summary-text">真实姓名和身份证号属于敏感信息，接口不回显明文内容。</text>
			</view>
		</view>

		<view v-if="history.length > 0" class="history-card">
			<view class="history-head">
				<text class="section-title">申请与审核历史</text>
				<text class="history-count">共 {{ history.length }} 条</text>
			</view>
			<view v-for="record in history" :key="record.id" class="history-item">
				<view class="history-main">
					<text class="history-time">{{ formatDate(record.submittedAt) }}</text>
					<status-pill :label="labelFor(record.status)" :tone="toneFor(record.status)"></status-pill>
				</view>
				<text v-if="record.rejectionReason.length > 0" class="history-reason">{{ record.rejectionReason }}</text>
			</view>
		</view>

		<facetof-button
			:label="submitButtonText()"
			tone="gradient"
			:disabled="submitting || formLocked"
			@press="submit"
		></facetof-button>
		<text class="form-tip">提交后不可撤回为草稿；重新进入本页时，未提交内容会清空。</text>
	</scroll-view>
</template>

<script setup lang="uts">
	import FacetofButton from '../../components/facetof-button.uvue'
	import StatusPill from '../../components/status-pill.uvue'
	import {
		getProviderApplication,
		submitProviderApplicationApi,
		updateProviderApplicationApi
	} from '../../services/service-container.uts'
	import type { ProviderApplicationRecord } from '../../types/models.uts'
	import { sessionState, setRejectionReason } from '../../state/session-state.uts'
	import { openLogin } from '../../router/route-guard.uts'

	const avatarPath = ref('')
	const lifePhotoPaths = ref<string[]>([])
	const bio = ref('')
	const realName = ref('')
	const idCardNumber = ref('')
	const submitting = ref(false)
	const history = ref<ProviderApplicationRecord[]>([])
	const latest = ref<ProviderApplicationRecord | null>(null)

	// UniApp x/Vapor 模板中不直接读取可空 latest 属性，避免空指针。
	function reviewRealNameStatus(): string {
		const value = latest.value
		return value == null ? '' : value.realNameStatus
	}

	function reviewFaceStatus(): string {
		const value = latest.value
		return value == null ? '' : value.faceStatus
	}

	function submitButtonText(): string {
		if (formLocked.value) {
			const value = latest.value
			return value != null && value.status == 'approved' ? '已审核通过' : '审核中，暂不能提交'
		}
		return submitting.value ? '提交中...' : submitLabel.value
	}

	// 审核中和已通过的申请只读展示，不允许重复提交。
	const formLocked = computed(() : boolean => {
		return latest.value != null && (latest.value!.status == 'pending' || latest.value!.status == 'approved')
	})

	// 每次进入页面都从后端读取当前申请状态，避免本地状态与审核结果不一致。
	function refreshState() {
		getProviderApplication().then((result) => {
			if (!result.ok) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			latest.value = result.record
			history.value = result.record == null ? [] : [result.record]
			if (latest.value != null) {
				// 展示后端允许回显的资料；真实姓名和身份证号不会由接口返回。
				bio.value = latest.value.bio
				avatarPath.value = latest.value.avatarAsset
				lifePhotoPaths.value = latest.value.lifePhotoAssets
				if (latest.value.status == 'rejected' || latest.value.status == 'cancelled') {
					realName.value = latest.value.realName
				} else {
					realName.value = ''
					idCardNumber.value = ''
				}
			}
		})
	}

	onShow(() => {
		if (!sessionState.loggedIn) {
			openLogin('provider-apply', '/pages/provider/apply', '')
			return
		}
		refreshState()
	})

	function onBioInput(event: InputEvent) {
		bio.value = event.detail.value
	}

	function onRealNameInput(event: InputEvent) {
		realName.value = event.detail.value
	}

	function onIdCardInput(event: InputEvent) {
		idCardNumber.value = event.detail.value
	}

	function chooseAvatar() {
		if (formLocked.value) {
			return
		}
		uni.chooseImage({
			count: 1,
			success: (res) => {
				if (res.tempFilePaths.length > 0) {
					avatarPath.value = res.tempFilePaths[0]
				}
			}
		})
	}

	// 生活照支持一次选择多张，剩余数量不足时限制选择上限。
	function chooseLifePhoto() {
		if (formLocked.value) {
			return
		}
		const remaining = 9 - lifePhotoPaths.value.length
		if (remaining <= 0) {
			uni.showToast({
				title: '最多上传 9 张生活照',
				position: 'bottom',
				icon: 'error'
			})
			return
		}
		uni.chooseImage({
			count: remaining,
			success: (res) => {
				const next: string[] = []
				for (let i = 0; i < lifePhotoPaths.value.length; i++) {
					next.push(lifePhotoPaths.value[i])
				}
				for (let i = 0; i < res.tempFilePaths.length && next.length < 9; i++) {
					next.push(res.tempFilePaths[i])
				}
				lifePhotoPaths.value = next
			}
		})
	}

	function removeLifePhoto(index: number) {
		if (formLocked.value) {
			return
		}
		const next: string[] = []
		for (let i = 0; i < lifePhotoPaths.value.length; i++) {
			if (i != index) {
				next.push(lifePhotoPaths.value[i])
			}
		}
		lifePhotoPaths.value = next
	}

	function labelFor(status: string): string {
		if (status == 'approved') {
			return '审核通过'
		}
		if (status == 'rejected') {
			return '审核拒绝'
		}
		if (status == 'pending') {
			return '审核中'
		}
		if (status == 'cancelled') {
			return '已取消'
		}
		return '未提交'
	}

	function toneFor(status: string): string {
		if (status == 'approved') {
			return 'success'
		}
		if (status == 'rejected') {
			return 'danger'
		}
		if (status == 'pending') {
			return 'warning'
		}
		if (status == 'cancelled') {
			return 'neutral'
		}
		return 'neutral'
	}

	function statusLabelForRecord(record: ProviderApplicationRecord | null): string {
		return record == null ? '尚未提交' : labelFor(record.status)
	}

	const statusLabel = computed(() : string => statusLabelForRecord(latest.value))
	const statusTone = computed(() : string => latest.value == null ? 'neutral' : toneFor(latest.value!.status))
	const currentStatusMessage = computed(() : string => {
		const record = latest.value
		if (record == null) {
			return '尚未提交申请。'
		}
		if (record.status == 'rejected') {
			return '拒绝原因：' + record.rejectionReason
		}
		if (record.status == 'approved') {
			return '审核已通过。工作台入口将在个人中心展示，默认登录仍进入普通用户首页。'
		}
		if (record.status == 'cancelled') {
			return '申请已取消，可修改资料后重新提交。'
		}
		return '资料已提交，请耐心等待审核。'
	})
	const submitLabel = computed(() : string => {
		return latest.value != null && (latest.value!.status == 'rejected' || latest.value!.status == 'cancelled') ? '修改后重新提交' : '提交审核'
	})

	function formatDate(value: string): string {
		return value.replace('T', ' ').slice(0, 16)
	}

	function submit() {
		if (submitting.value) {
			return
		}
		submitting.value = true
		const draft = {
			avatarPath: avatarPath.value,
			lifePhotoPaths: lifePhotoPaths.value,
			bio: bio.value,
			realName: realName.value,
			idCardNumber: idCardNumber.value
		}
		// 被拒绝或已取消的申请通过 PATCH 重新提交，携带后端版本号防止并发覆盖。
		const request = latest.value != null && (latest.value!.status == 'rejected' || latest.value!.status == 'cancelled')
			? updateProviderApplicationApi(draft, latest.value!, latest.value!.version)
			: submitProviderApplicationApi(draft)
		request.then((result) => {
			submitting.value = false
			uni.showToast({
				title: result.message,
				position: 'bottom',
				icon: result.ok ? 'success' : 'error'
			})
			if (result.ok) {
				setRejectionReason('')
				avatarPath.value = ''
				lifePhotoPaths.value = []
				bio.value = ''
				realName.value = ''
				idCardNumber.value = ''
				refreshState()
			}
		})
	}
</script>

