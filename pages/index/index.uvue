<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
		<view class="topbar">
			<view class="city">
				<text class="city-label">当前城市</text>
				<text class="city-name">泸州 ▾</text>
			</view>
			<view class="search" @click="openSearch">
				<text class="search-icon">⌕</text>
				<text class="search-placeholder">搜索服务者、服务项目</text>
			</view>
			<view class="message-button" @click="accountAction('chat', 'message-center')">
				<text class="message-icon">✉</text>
				<view class="message-dot"></view>
			</view>
		</view>

		<view class="brand-banner">
			<view class="banner-copy">
				<text class="banner-title">同城玩伴，刷着找</text>
				<text class="banner-desc">真实服务者 · 公共场所见面 · 平台保障</text>
			</view>
			<view class="banner-bubble">
				<text class="bubble-text">安心见</text>
			</view>
		</view>

		<view class="category-wrap">
			<segment-tabs
				:items="categories"
				:active="selectedCategory"
				variant="pill"
				@change="changeCategory"
			></segment-tabs>
		</view>

		<view class="section-head">
			<view>
				<text class="section-title">附近真实分享</text>
				<text class="section-desc">公开内容，游客也可以浏览</text>
			</view>
			<status-pill label="公开数据" tone="brand"></status-pill>
		</view>

		<view v-if="filteredFeed.length == 0" class="empty-state">
			<text class="empty-title">暂时没有相关动态</text>
			<text class="empty-desc">换一个分类看看吧</text>
		</view>

		<view v-for="item in filteredFeed" :key="item.id" class="feed-card">
			<view class="cover" @click="openProvider(item.providerId)">
				<image class="cover-main-image" :src="coverImageAt(item, 0)" mode="aspectFill"></image>
				<view class="cover-side">
					<image class="cover-side-image" :src="coverImageAt(item, 1)" mode="aspectFill"></image>
					<image class="cover-side-image cover-side-image-last" :src="coverImageAt(item, 2)" mode="aspectFill"></image>
					<view v-if="item.coverImages.length > 3" class="cover-more">
						<text class="cover-more-text">+{{ item.coverImages.length - 3 }}</text>
					</view>
				</view>
				<text class="cover-label">{{ item.coverLabel }}</text>
				<view v-if="item.online" class="online-badge">
					<view class="online-dot"></view>
					<text class="online-text">在线</text>
				</view>
			</view>

			<view class="card-body">
				<view class="provider-row">
					<image class="avatar" :src="item.providerAvatar" mode="aspectFill"></image>
					<view class="provider-main">
						<view class="name-row">
							<text class="provider-name">{{ item.providerName }}</text>
							<status-pill v-if="item.verified" label="真人认证" tone="success"></status-pill>
						</view>
						<text class="provider-meta">{{ item.age }} 岁 · {{ item.distance }} · {{ item.categoryName }}</text>
					</view>
				</view>

				<text class="headline">{{ item.headline }}</text>
				<text class="description">{{ item.description }}</text>

				<view class="service-row">
					<view>
						<text class="service-name">{{ item.serviceName }}</text>
						<text class="service-price">{{ item.price }}</text>
					</view>
					<view class="verified-tag">
						<text class="verified-text">资料已审核</text>
					</view>
				</view>

				<view class="action-row">
					<view class="action-button ghost" @click="accountAction('favorite', item.providerId)">
						<text class="action-icon">♡</text>
						<text class="action-text">收藏</text>
					</view>
					<view class="action-button ghost" @click="accountAction('chat', item.providerId)">
						<text class="action-icon">◌</text>
						<text class="action-text">私信</text>
					</view>
					<view class="action-button primary" @click="openProvider(item.providerId)">
						<text class="action-text white">立即预约</text>
					</view>
				</view>
			</view>
		</view>

		<view class="footer-tip">
			<text class="footer-tip-text">公开数据仅展示服务者主动公开的信息</text>
		</view>
		</view>
		</scroll-view>

	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import StatusPill from '../../components/status-pill.uvue'
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import { getHomeFeed, performAccountAction } from '../../services/service-container.uts'
	import type { HomeFeedItem } from '../../types/models.uts'
	import { sessionState } from '../../state/session-state.uts'
	import { openLogin } from '../../router/route-guard.uts'

	const categories = ['全部', '运动', '娱乐', '休闲']
	const selectedCategory = ref('全部')
	const allFeed = ref<HomeFeedItem[]>([])

	const filteredFeed = computed(() : Array<HomeFeedItem> => {
		if (selectedCategory.value == '全部') {
			return allFeed.value
		}
		const result: Array<HomeFeedItem> = []
		for (let i = 0; i < allFeed.value.length; i++) {
			if (allFeed.value[i].categoryName == selectedCategory.value) {
				result.push(allFeed.value[i])
			}
		}
		return result
	})

	onShow(() => {
		allFeed.value = getHomeFeed()
	})

	onLoad((options) => {
		const action = options['resumeAction'] as string
		if (action != null && action.length > 0) {
			let message = '登录成功，可继续原操作'
			if (action == 'favorite') {
				message = '登录成功，可以继续收藏'
			} else if (action == 'chat') {
				message = '登录成功，可以继续聊天'
			} else if (action == 'booking') {
				message = '登录成功，可以继续预约'
			}
			uni.showToast({
				title: message,
				position: 'bottom',
				icon: 'success'
			})
		}
	})

	function coverImageAt(item: HomeFeedItem, index: number): string {
		if (index < item.coverImages.length && item.coverImages[index].length > 0) {
			return item.coverImages[index]
		}
		return '/static/content/city.png'
	}

	function changeCategory(category: string) {
		selectedCategory.value = category
	}

	function openProvider(providerId: string) {
		uni.navigateTo({
			url: '/pages/provider/detail?providerId=' + encodeURIComponent(providerId)
		})
	}

	function openSearch() {
		uni.navigateTo({
			url: '/pages/search/search'
		})
	}

	function accountAction(action: string, targetId: string) {
		if (!sessionState.loggedIn) {
			openLogin(action, '/pages/index/index', targetId)
			return
		}
		const result = performAccountAction(action, targetId)
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
	}

</script>

