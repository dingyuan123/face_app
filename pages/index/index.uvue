<template>
	<view class="page">
		<scroll-view class="page-scroll" scroll-y :show-scrollbar="false">
		<view class="page-content">
		<view class="topbar">
			<view class="city">
				<text class="city-label">当前城市</text>
				<text class="city-name">泸州 ▾</text>
			</view>
			<view class="search">
				<text class="search-icon">⌕</text>
				<text class="search-placeholder">搜索服务者、服务项目</text>
			</view>
			<view class="message-button" @click="accountAction('chat', 'message-center')">
				<text class="message-icon">✉</text>
				<view class="message-dot"></view>
			</view>
		</view>

		<view class="brand-banner">
			<view class="banner-copy">
				<text class="banner-title">同城玩伴，刷着找</text>
				<text class="banner-desc">真实服务者 · 公共场所见面 · 平台保障</text>
			</view>
			<view class="banner-bubble">
				<text class="bubble-text">安心见</text>
			</view>
		</view>

		<scroll-view class="category-scroll" scroll-x :show-scrollbar="false">
			<view class="category-list">
				<view
					v-for="category in categories"
					:key="category"
					class="category-item"
					:class="selectedCategory == category ? 'category-active' : ''"
					@click="selectedCategory = category"
				>
					<text class="category-text" :class="selectedCategory == category ? 'category-text-active' : ''">{{ category }}</text>
				</view>
			</view>
		</scroll-view>

		<view class="section-head">
			<view>
				<text class="section-title">附近真实分享</text>
				<text class="section-desc">公开内容，游客也可以浏览</text>
			</view>
			<status-pill label="公开数据" tone="brand"></status-pill>
		</view>

		<view v-if="filteredFeed.length == 0" class="empty-state">
			<text class="empty-title">暂时没有相关动态</text>
			<text class="empty-desc">换一个分类看看吧</text>
		</view>

		<view v-for="item in filteredFeed" :key="item.id" class="feed-card">
			<view class="cover">
				<image class="cover-main-image" :src="coverImageAt(item, 0)" mode="aspectFill"></image>
				<view class="cover-side">
					<image class="cover-side-image" :src="coverImageAt(item, 1)" mode="aspectFill"></image>
					<image class="cover-side-image cover-side-image-last" :src="coverImageAt(item, 2)" mode="aspectFill"></image>
					<view v-if="item.coverImages.length > 3" class="cover-more">
						<text class="cover-more-text">+{{ item.coverImages.length - 3 }}</text>
					</view>
				</view>
				<text class="cover-label">{{ item.coverLabel }}</text>
				<view v-if="item.online" class="online-badge">
					<view class="online-dot"></view>
					<text class="online-text">在线</text>
				</view>
			</view>

			<view class="card-body">
				<view class="provider-row">
					<view class="avatar">
						<text class="avatar-text">{{ item.providerName.slice(0, 1) }}</text>
					</view>
					<view class="provider-main">
						<view class="name-row">
							<text class="provider-name">{{ item.providerName }}</text>
							<status-pill v-if="item.verified" label="真人认证" tone="success"></status-pill>
						</view>
						<text class="provider-meta">{{ item.age }} 岁 · {{ item.distance }} · {{ item.categoryName }}</text>
					</view>
				</view>

				<text class="headline">{{ item.headline }}</text>
				<text class="description">{{ item.description }}</text>

				<view class="service-row">
					<view>
						<text class="service-name">{{ item.serviceName }}</text>
						<text class="service-price">{{ item.price }}</text>
					</view>
					<view class="verified-tag">
						<text class="verified-text">资料已审核</text>
					</view>
				</view>

				<view class="action-row">
					<view class="action-button ghost" @click="accountAction('favorite', item.providerId)">
						<text class="action-icon">♡</text>
						<text class="action-text">收藏</text>
					</view>
					<view class="action-button ghost" @click="accountAction('chat', item.providerId)">
						<text class="action-icon">◌</text>
						<text class="action-text">私信</text>
					</view>
					<view class="action-button primary" @click="accountAction('booking', item.providerId)">
						<text class="action-text white">立即预约</text>
					</view>
				</view>
			</view>
		</view>

		<view class="footer-tip">
			<text class="footer-tip-text">公开数据仅展示服务者主动公开的信息</text>
		</view>
		</view>
		</scroll-view>

		<view class="bottom-nav">
			<view class="nav-item nav-active">
				<text class="nav-icon">⌂</text>
				<text class="nav-label">首页</text>
			</view>
			<view class="nav-item" @click="showProfile = true">
				<text class="nav-icon">○</text>
				<text class="nav-label">我的</text>
			</view>
		</view>

		<view v-if="showProfile" class="profile-mask" @click="showProfile = false">
			<view class="profile-sheet" @click.stop="noop">
				<view class="sheet-handle"></view>
				<view class="sheet-head">
					<view>
						<text class="sheet-title">我的</text>
						<text class="sheet-subtitle">{{ sessionState.loggedIn ? sessionState.displayName : '游客浏览中' }}</text>
					</view>
					<view class="close-button" @click="showProfile = false">
						<text class="close-text">×</text>
					</view>
				</view>

				<view v-if="!sessionState.loggedIn" class="profile-login">
					<text class="profile-tip">登录后可预约、聊天、收藏并查看个人数据。</text>
					<facetof-button label="登录 / 注册" tone="gradient" @press="loginFromProfile"></facetof-button>
				</view>

				<view v-else class="profile-content">
					<view class="profile-row">
						<text class="profile-label">当前身份</text>
						<status-pill :label="identityLabel" tone="brand"></status-pill>
					</view>
					<view class="profile-row">
						<text class="profile-label">服务者申请</text>
						<status-pill :label="applicationLabel" :tone="applicationTone"></status-pill>
					</view>
					<text v-if="sessionState.applicationStatus == 'rejected'" class="sheet-reason">{{ sessionState.rejectionReason }}</text>

					<view v-if="sessionState.providerPermission" class="workbench-entry" @click="showWorkbenchTip">
						<view>
							<text class="workbench-title">服务者工作台</text>
							<text class="workbench-desc">审核已通过，可进入工作台</text>
						</view>
						<text class="entry-arrow">›</text>
					</view>

					<view v-if="sessionState.applicationStatus == 'rejected'" class="profile-action" @click="openApply">
						<text class="profile-action-text">修改并重新提交申请</text>
						<text class="entry-arrow">›</text>
					</view>
					<view v-if="sessionState.applicationStatus == 'pending'" class="profile-action" @click="openApply">
						<text class="profile-action-text">查看申请进度</text>
						<text class="entry-arrow">›</text>
					</view>

					<view class="logout-row" @click="logoutFromProfile">
						<text class="logout-text">退出登录</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import FacetofButton from '../../components/facetof-button.uvue'
	import StatusPill from '../../components/status-pill.uvue'
	import { getHomeFeed, performAccountAction } from '../../services/service-container.uts'
	import type { HomeFeedItem } from '../../types/models.uts'
	import { logout, sessionState } from '../../state/session-state.uts'
	import { openLogin, openProviderApply } from '../../router/route-guard.uts'

	const categories = ['全部', '运动', '娱乐', '休闲']
	const selectedCategory = ref('全部')
	const showProfile = ref(false)
	const allFeed = ref<HomeFeedItem[]>([])

	const filteredFeed = computed(() : Array<HomeFeedItem> => {
		if (selectedCategory.value == '全部') {
			return allFeed.value
		}
		const result: Array<HomeFeedItem> = []
		for (let i = 0; i < allFeed.value.length; i++) {
			if (allFeed.value[i].categoryName == selectedCategory.value) {
				result.push(allFeed.value[i])
			}
		}
		return result
	})

	const identityLabel = computed(() : string => {
		if (sessionState.identity == 'provider') {
			return '服务者身份'
		}
		if (sessionState.identity == 'user') {
			return '普通用户'
		}
		return '未选择'
	})

	const applicationLabel = computed(() : string => {
		if (sessionState.applicationStatus == 'approved') {
			return '审核通过'
		}
		if (sessionState.applicationStatus == 'pending') {
			return '审核中'
		}
		if (sessionState.applicationStatus == 'rejected') {
			return '审核拒绝'
		}
		return '未申请'
	})

	const applicationTone = computed(() : string => {
		if (sessionState.applicationStatus == 'approved') {
			return 'success'
		}
		if (sessionState.applicationStatus == 'pending') {
			return 'warning'
		}
		if (sessionState.applicationStatus == 'rejected') {
			return 'danger'
		}
		return 'neutral'
	})

	onShow(() => {
		allFeed.value = getHomeFeed()
	})

	onLoad((options) => {
		const action = options['resumeAction'] as string
		if (action != null && action.length > 0) {
			let message = '登录成功，可继续原操作'
			if (action == 'favorite') {
				message = '登录成功，可以继续收藏'
			} else if (action == 'chat') {
				message = '登录成功，可以继续聊天'
			} else if (action == 'booking') {
				message = '登录成功，可以继续预约'
			}
			uni.showToast({
				title: message,
				position: 'bottom',
				icon: 'success'
			})
		}
	})

	function noop() {
	}

	function coverImageAt(item: HomeFeedItem, index: number): string {
		if (index < item.coverImages.length && item.coverImages[index].length > 0) {
			return item.coverImages[index]
		}
		return '/static/placeholders/provider-1.png'
	}

	function accountAction(action: string, targetId: string) {
		if (!sessionState.loggedIn) {
			openLogin(action, '/pages/index/index', targetId)
			return
		}
		const result = performAccountAction(action, targetId)
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
	}

	function loginFromProfile() {
		showProfile.value = false
		openLogin('profile-login', '/pages/index/index', '')
	}

	function logoutFromProfile() {
		logout()
		showProfile.value = false
		uni.showToast({
			title: '已退出登录，身份选择已保留',
			position: 'bottom',
			icon: 'success'
		})
	}

	function openApply() {
		showProfile.value = false
		openProviderApply()
	}

	function showWorkbenchTip() {
		uni.showToast({
			title: '工作台页面将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

