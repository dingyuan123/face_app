<template>
	<view class="page">
		<swiper
			class="moment-swiper"
			:current="currentMoment"
			:vertical="true"
			:circular="false"
			@change="onMomentChange"
		>
			<swiper-item v-for="(item, index) in moments" :key="item.id">
				<view class="video-area">
					<video
						v-if="item.videoUrl.length > 0 && index == currentMoment"
						class="video-cover"
						:id="'moment-video-' + item.id"
						:src="item.videoUrl"
						:poster="item.coverImage"
						:autoplay="true"
						:controls="false"
						:muted="muted"
						:loop="true"
						:show-play-btn="false"
						:show-center-play-btn="false"
						:show-fullscreen-btn="false"
						:show-progress="false"
						:enable-progress-gesture="false"
						@click="togglePlay"
						@play="onVideoPlay"
					></video>
					<image v-else class="video-cover" :src="item.coverImage" mode="aspectFill"></image>
					<view class="video-shade"></view>
					<view class="media-tap-layer" @click.stop="togglePlay"></view>

					<view class="topbar">
						<view class="circle-button" @click="goBack">
							<text class="circle-icon">‹</text>
						</view>
						<text class="topbar-title">动态</text>
						<view class="circle-button" @click="openMore">
							<text class="circle-icon">···</text>
						</view>
					</view>

					<view class="right-actions">
						<view class="author-action" @click="followAuthor">
							<image class="author-avatar" :src="item.avatar" mode="aspectFill"></image>
							<view class="follow-dot">
								<text class="follow-dot-text">＋</text>
							</view>
						</view>
						<view class="action-item" @click="toggleLike">
							<text class="action-symbol">{{ liked ? '♥' : '♡' }}</text>
							<text class="action-count">{{ formatCount(item.likeCount) }}</text>
						</view>
						<view class="action-item" @click="openComments">
							<text class="action-symbol">♧</text>
							<text class="action-count">{{ item.commentCount }}</text>
						</view>
						<view class="action-item" @click="shareMoment">
							<text class="action-symbol">↑</text>
							<text class="action-count">分享</text>
						</view>
						<view class="action-item" @click="openService(item.serviceId)">
							<text class="action-symbol">▤</text>
							<text class="action-count">服务</text>
						</view>
						<view class="action-item sound" @click="toggleSound">
							<text class="action-symbol">{{ muted ? '♩' : '♫' }}</text>
							<text class="action-count">原声</text>
						</view>
					</view>

					<view class="video-info">
						<view class="author-line">
							<text class="author-name">{{ item.providerName }}</text>
							<view class="verified-tag">
								<text class="verified-text">✓ 实名认证</text>
							</view>
						</view>
						<text class="moment-title">{{ item.title }}</text>
						<text class="moment-description">{{ item.description }}</text>
						<text class="hashtags">#{{ item.hashtags.join(' #') }}</text>
						<view class="location-row">
							<text class="location-icon">⌖</text>
							<text class="location-text">{{ item.location }}</text>
						</view>

						<view class="service-link" @click="openService(item.serviceId)">
							<view class="service-link-main">
								<text class="service-link-title">台球助教 · 新手体验</text>
								<text class="service-link-meta">60 分钟 · 线下陪练</text>
								<text class="service-link-price">¥68</text>
							</view>
							<view class="service-link-button">
								<text class="service-link-button-text">查看服务</text>
							</view>
						</view>
					</view>

					<view class="sound-tip">
						<text class="sound-tip-text">默认静音 · 点击开启声音</text>
						<view class="sound-button" @click="toggleSound">
							<text class="sound-button-text">{{ muted ? '⌁' : '♫' }}</text>
						</view>
					</view>
				</view>
			</swiper-item>
		</swiper>
	</view>
</template>

<script setup lang="uts">
	import { getMomentFeed } from '../../services/service-container.uts'
	import type { MomentDetail } from '../../types/models.uts'
	import { requireAccount, MOMENT_DETAIL_ROUTE } from '../../router/route-guard.uts'

	const moments = ref<MomentDetail[]>(getMomentFeed())
	const currentMoment = ref(0)
	const paused = ref(false)
	const muted = ref(true)
	const liked = ref(false)
	const videoContexts = new Map<string, VideoContext>()

	function onMomentChange(event: any) {
		const previous = currentMoment.value
		releaseVideo(previous)
		currentMoment.value = event.detail.current
		liked.value = false
		paused.value = false
	}

	function formatCount(count: number): string {
		if (count >= 10000) {
			return (count / 10000).toFixed(1) + 'W'
		}
		return count.toString()
	}

	function currentId(): string {
		if (currentMoment.value < moments.value.length) {
			return moments.value[currentMoment.value].id
		}
		return ''
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/moments/moments'
				})
			}
		})
	}

	function releaseVideo(index: number) {
		if (index < 0 || index >= moments.value.length) {
			return
		}
		const item = moments.value[index]
		if (item.videoUrl.length == 0) {
			return
		}
		const id = 'moment-video-' + item.id
		const context = videoContexts.get(id)
		if (context != null) {
			context.stop()
			videoContexts.delete(id)
		}
	}

	function getVideoContext(index: number): VideoContext {
		const id = 'moment-video-' + moments.value[index].id
		let context = videoContexts.get(id)
		if (context == null) {
			context = uni.createVideoContext(id) as VideoContext
			videoContexts.set(id, context)
		}
		return context
	}

	function onVideoPlay() {
		paused.value = false
	}

	function togglePlay() {
		const item = moments.value[currentMoment.value]
		if (item.videoUrl.length > 0) {
			const context = getVideoContext(currentMoment.value)
			if (paused.value) {
				context.play()
				paused.value = false
			} else {
				context.pause()
				paused.value = true
			}
			return
		}
		paused.value = !paused.value
	}

	function toggleSound() {
		muted.value = !muted.value
		uni.showToast({
			title: muted.value ? '已静音' : '声音已开启',
			position: 'bottom',
			icon: 'none'
		})
	}

	function followAuthor() {
		if (!requireAccount('follow-moment-author', MOMENT_DETAIL_ROUTE, currentId())) {
			return
		}
		uni.showToast({
			title: '已关注（开发 Mock）',
			position: 'bottom',
			icon: 'success'
		})
	}

	function toggleLike() {
		if (!requireAccount('like-moment', MOMENT_DETAIL_ROUTE, currentId())) {
			return
		}
		liked.value = !liked.value
		uni.showToast({
			title: liked.value ? '已点赞' : '已取消点赞',
			position: 'bottom',
			icon: 'success'
		})
	}

	function openComments() {
		uni.showToast({
			title: '评论区将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function shareMoment() {
		uni.showToast({
			title: '分享能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openMore() {
		uni.showToast({
			title: '更多操作将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openService(id: string) {
		uni.navigateTo({
			url: '/pages/service/detail?serviceId=' + encodeURIComponent(id)
		})
	}
</script>

<style lang="scss">
