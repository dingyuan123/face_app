<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">{{ pageTitle }}</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="media-card">
					<view class="media-head">
						<text class="section-title">添加图片</text>
						<text class="section-count">{{ images.length }}/9</text>
					</view>

					<view class="media-grid">
						<view v-for="(image, index) in images" :key="image" class="media-preview">
							<image class="preview-image" :src="image" mode="aspectFill"></image>
							<view class="remove-button" @click="removeImage(index)">
								<text class="remove-text">×</text>
							</view>
						</view>

						<view v-if="images.length < 9" class="add-media" @click="chooseImages">
							<text class="add-plus">＋</text>
							<text class="add-text">添加图片</text>
						</view>
					</view>

					<view class="media-actions">
						<view class="media-action" @click="chooseImages">
							<text class="media-action-icon">▧</text>
							<text class="media-action-text">从相册选择</text>
						</view>
					</view>
				</view>

				<view class="form-card">
					<text class="section-title">分享此刻</text>
					<textarea
						class="content-input"
						:value="content"
						maxlength="2000"
						placeholder="记录你此刻的心情、见闻或体验…"
						placeholder-class="content-placeholder"
						@input="onContentInput"
					></textarea>
					<text class="content-count">{{ content.length }}/2000</text>
				</view>

				<view class="setting-card">
					<view class="setting-row" @click="openServicePicker">
						<view class="setting-main">
							<text class="setting-label">挂载服务</text>
							<text class="setting-value">{{ serviceDisplay }}</text>
						</view>
						<text class="setting-arrow">›</text>
					</view>
					<view class="setting-divider"></view>
					<view class="visibility-row">
						<text class="setting-label">可见范围</text>
						<view class="visibility-options">
							<view class="visibility-option" :class="visibility == 'PUBLIC' ? 'visibility-active' : ''" @click="visibility = 'PUBLIC'">
								<text class="visibility-dot" :class="visibility == 'PUBLIC' ? 'visibility-dot-active' : ''">{{ visibility == 'PUBLIC' ? '●' : '○' }}</text>
								<text class="visibility-text" :class="visibility == 'PUBLIC' ? 'visibility-text-active' : ''">公开</text>
							</view>
							<view class="visibility-option" :class="allowRecommend ? 'visibility-active' : ''" @click="toggleRecommend">
								<text class="visibility-dot" :class="allowRecommend ? 'visibility-dot-active' : ''">{{ allowRecommend ? '●' : '○' }}</text>
								<text class="visibility-text" :class="allowRecommend ? 'visibility-text-active' : ''">允许推荐</text>
							</view>
						</view>
					</view>
				</view>

				<view class="policy-row">
					<view class="policy-check">✓</view>
					<text class="policy-text">发布内容应真实友善，不包含隐私和违法信息</text>
				</view>
				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="action-bar">
			<view class="draft-button" @click="save(false)">
				<text class="draft-text">{{ editing ? '保存修改' : '存草稿' }}</text>
			</view>
			<view class="publish-button" :class="canSubmit ? '' : 'publish-disabled'" @click="save(true)">
				<text class="publish-text">{{ editing ? '保存并发布' : '发布' }}</text>
			</view>
		</view>

		<view v-if="servicePickerVisible" class="picker-mask">
			<view class="picker-backdrop" @click="closeServicePicker"></view>
			<view class="picker-panel">
				<view class="picker-head">
					<text class="picker-title">挂载服务</text>
					<text class="picker-subtitle">仅可挂载本人已上架的服务，便于访客直接预约</text>
				</view>
				<scroll-view class="picker-scroll" direction="vertical" :show-scrollbar="false">
					<view
						class="picker-item"
						:class="attachedServiceId.length == 0 ? 'picker-item-active' : ''"
						@click="selectService('', '')"
					>
						<view class="picker-item-main">
							<text class="picker-item-title">不挂载服务</text>
							<text class="picker-item-desc">仅分享动态内容</text>
						</view>
						<view class="picker-radio" :class="attachedServiceId.length == 0 ? 'picker-radio-active' : ''"></view>
					</view>
					<view
						v-for="service in mountableServices"
						:key="service.id"
						class="picker-item"
						:class="attachedServiceId == service.id ? 'picker-item-active' : ''"
						@click="selectService(service.id, service.title)"
					>
						<image class="picker-cover" :src="service.coverUrl" mode="aspectFill"></image>
						<view class="picker-item-main">
							<text class="picker-item-title">{{ service.title }}</text>
							<text class="picker-item-desc">{{ service.priceDisplay }} · {{ service.durationMinutes }}分钟</text>
						</view>
						<view class="picker-radio" :class="attachedServiceId == service.id ? 'picker-radio-active' : ''"></view>
					</view>
					<view v-if="mountableServices.length == 0" class="picker-empty">
						<text class="picker-empty-text">暂无已上架服务，上架后即可挂载</text>
					</view>
				</scroll-view>
				<view class="picker-done" @click="closeServicePicker">
					<text class="picker-done-text">完成</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import {
		getMomentMountableServices,
		getProviderMomentData,
		saveProviderMomentData
	} from '../../services/service-container.uts'
	import type { MomentMountableServiceItem, ProviderMomentDraftInput } from '../../types/models.uts'

	const editId = ref('')
	const expectedVersion = ref(0)
	const pageTitle = ref('发布动态')
	const images = ref<string[]>([])
	const imageMediaIds = ref<string[]>([])
	const content = ref('')
	const visibility = ref('PUBLIC')
	const allowRecommend = ref(true)
	const attachedServiceId = ref('')
	const attachedServiceTitle = ref('')
	const servicePickerVisible = ref(false)
	const mountableServices = ref<MomentMountableServiceItem[]>([])
	const saving = ref(false)

	const editing = computed(() : boolean => {
		return editId.value.length > 0
	})

	const canSubmit = computed(() : boolean => {
		return content.value.trim().length > 0 && images.value.length > 0
	})

	const serviceDisplay = computed(() : string => {
		return attachedServiceTitle.value.length > 0 ? attachedServiceTitle.value : '不挂载，仅分享动态'
	})

	function onContentInput(event: InputEvent) {
		content.value = event.detail.value
	}

	function toggleRecommend() {
		allowRecommend.value = !allowRecommend.value
	}

	function chooseImages() {
		const remaining = 9 - images.value.length
		if (remaining <= 0) {
			return
		}
		uni.chooseImage({
			count: remaining,
			success: (result) => {
				const next: Array<string> = []
				const nextIds: Array<string> = []
				for (let i = 0; i < images.value.length; i++) {
					next.push(images.value[i])
					nextIds.push(imageMediaIds.value[i])
				}
				for (let i = 0; i < result.tempFilePaths.length && next.length < 9; i++) {
					next.push(result.tempFilePaths[i])
					nextIds.push('')
				}
				images.value = next
				imageMediaIds.value = nextIds
			}
		})
	}

	function removeImage(index: number) {
		const next: Array<string> = []
		const nextIds: Array<string> = []
		for (let i = 0; i < images.value.length; i++) {
			if (i != index) {
				next.push(images.value[i])
				nextIds.push(imageMediaIds.value[i])
			}
		}
		images.value = next
		imageMediaIds.value = nextIds
	}

	function openServicePicker() {
		servicePickerVisible.value = true
		if (mountableServices.value.length > 0) {
			return
		}
		getMomentMountableServices().then((result) => {
			if (result.ok) {
				mountableServices.value = result.items
				return
			}
			uni.showToast({
				title: result.message,
				position: 'bottom',
				icon: 'error'
			})
		})
	}

	function closeServicePicker() {
		servicePickerVisible.value = false
	}

	function selectService(id: string, title: string) {
		attachedServiceId.value = id
		attachedServiceTitle.value = title
		servicePickerVisible.value = false
	}

	function loadMoment(id: string) {
		getProviderMomentData(id).then((result) => {
			if (!result.ok || result.moment == null) {
				uni.showToast({
					title: result.message,
					position: 'bottom',
					icon: 'error'
				})
				return
			}
			const moment = result.moment
			editId.value = moment.id
			expectedVersion.value = moment.version
			pageTitle.value = '编辑动态'
			content.value = moment.content
			images.value = moment.mediaUrls.slice()
			imageMediaIds.value = moment.mediaIds.slice()
			visibility.value = moment.visibility.length > 0 ? moment.visibility : 'PUBLIC'
			allowRecommend.value = moment.allowRecommend
			attachedServiceId.value = moment.attachedServiceId
			attachedServiceTitle.value = moment.attachedServiceTitle
		})
	}

	function save(publishAfter: boolean) {
		if (saving.value) {
			return
		}
		if (content.value.trim().length == 0) {
			uni.showToast({
				title: '请先填写动态内容',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		if (images.value.length == 0) {
			uni.showToast({
				title: '请至少添加一张图片',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		saving.value = true
		const draft: ProviderMomentDraftInput = {
			id: editId.value,
			expectedVersion: expectedVersion.value,
			content: content.value.trim(),
			mediaPaths: images.value.slice(),
			mediaIds: imageMediaIds.value.slice(),
			visibility: visibility.value,
			allowRecommend: allowRecommend.value,
			attachedServiceId: attachedServiceId.value
		}
		saveProviderMomentData(draft, publishAfter).then((result) => {
			saving.value = false
			uni.showToast({
				title: result.message,
				position: 'bottom',
				icon: result.ok ? 'success' : 'error'
			})
			if (result.ok) {
				setTimeout(() => {
					goBack()
				}, 600)
			}
		})
	}

	onLoad((options) => {
		if (options == null) {
			return
		}
		const momentId = options['momentId'] as string
		if (momentId != null && momentId.length > 0) {
			loadMoment(decodeURIComponent(momentId))
		}
	})

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/provider/moment-manage'
				})
			}
		})
	}
</script>

