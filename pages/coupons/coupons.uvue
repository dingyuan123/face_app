<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">我的优惠券</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="coupon-tabs">
				<view
					v-for="tab in tabs"
					:key="tab"
					class="coupon-tab-item"
					:class="activeTab == tab ? 'coupon-tab-item-active' : ''"
					@click="changeTab(tab)"
				>
					<text class="coupon-tab-text" :class="activeTab == tab ? 'coupon-tab-text-active' : ''">{{ tab }}</text>
					<view v-if="activeTab == tab" class="coupon-tab-indicator"></view>
				</view>
			</view>

			<view class="notice-row">
				<text class="notice-text">{{ activeTab == '可用 3' ? '好好见面，优惠相伴' : '已过期优惠券不可使用' }}</text>
				<text class="notice-count">{{ activeTab == '可用 3' ? '共 3 张可用' : '共 3 张已过期' }}</text>
			</view>

			<view class="coupon-list">
				<view v-for="coupon in coupons" :key="coupon.id" class="coupon-card" :class="coupon.status == '已过期' ? 'coupon-card-expired' : ''">
					<view class="coupon-top">
						<view class="coupon-amount">
							<view class="amount-main">
							<text class="amount-symbol">¥</text>
							<text class="amount-value">{{ coupon.amount.replace('¥', '') }}</text>
						</view>
						<text class="amount-threshold">{{ coupon.threshold }}</text>
						</view>
						<view class="coupon-divider"></view>
						<view class="coupon-detail">
							<view class="coupon-title-row">
								<text class="coupon-title">{{ coupon.title }}</text>
								<view class="coupon-status" :class="coupon.status == '已过期' ? 'status-expired' : 'status-available'">
									<text class="coupon-status-text" :class="coupon.status == '已过期' ? 'coupon-status-text-expired' : ''">{{ coupon.status }}</text>
								</view>
							</view>
							<text class="coupon-label">适用范围</text>
							<text class="coupon-scope">{{ coupon.scope }}</text>
						</view>
					</view>
					<view class="coupon-date-row">
						<text class="date-label">有效期</text>
						<text class="date-value">{{ coupon.dateRange }}</text>
					</view>
				</view>
			</view>

			<view class="policy-note">
				<text class="policy-icon">ⓘ</text>
				<view class="policy-copy">
					<text class="policy-text">券面内容仅为设计示例，非平台已确认政策。</text>
					<text class="policy-text">实际优惠与使用规则以订单页展示为准。</text>
				</view>
			</view>

			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getCouponItems } from '../../services/service-container.uts'
	import type { CouponItem } from '../../types/models.uts'

	const tabs = ['可用 3', '已过期 3']
	const activeTab = ref('可用 3')
	const coupons = ref<CouponItem[]>(getCouponItems('可用'))

	function changeTab(tab: string) {
		activeTab.value = tab
		coupons.value = getCouponItems(tab.indexOf('已过期') >= 0 ? '已过期' : '可用')
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}
</script>

