<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="service-hero">
					<swiper class="hero-swiper" :current="currentMedia" :circular="true" @change="onMediaChange">
						<swiper-item v-for="(image, index) in service.galleryImages" :key="index">
							<image class="hero-image" :src="image" mode="aspectFill"></image>
						</swiper-item>
					</swiper>
					<view class="hero-overlay"></view>
					<view class="hero-topbar">
						<view class="circle-button" @click="goBack">
							<text class="circle-icon">‹</text>
						</view>
						<view class="circle-button" @click="toggleFavorite">
							<text class="circle-icon">{{ favorited ? '♥' : '♡' }}</text>
						</view>
					</view>
					<view class="hero-caption">
						<text class="hero-caption-icon">▶</text>
						<text class="hero-caption-text">服务展示</text>
					</view>
					<text class="hero-count">{{ currentMedia + 1 }} / {{ service.galleryImages.length }}</text>
				</view>

				<view class="section-card service-summary">
					<text class="service-title">{{ service.title }}</text>
					<view class="summary-row">
						<view class="verified-pill">
							<text class="verified-pill-text">✓ 实名认证</text>
						</view>
						<view class="price-block">
							<text class="price-value">{{ service.price }}</text>
							<text class="price-unit">{{ service.priceUnit }}</text>
						</view>
					</view>
					<text class="service-subtitle">{{ service.duration }} · {{ service.format }}</text>
				</view>

				<view class="section-card">
					<text class="section-title">服务内容</text>
					<view class="content-lines">
						<view v-for="line in service.contentLines" :key="line" class="content-line">
							<text class="line-dot">·</text>
							<text class="line-text">{{ line }}</text>
						</view>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">选择预约时间</text>
					<text class="section-subtitle">可预约 · 选择日期和时段</text>
					<scroll-view class="date-scroll" direction="horizontal" :show-scrollbar="false">
						<view class="date-row">
							<view v-for="date in dates" :key="date.label" class="date-item" :class="selectedDate == date.label ? 'date-item-active' : ''" @click="selectedDate = date.label">
								<text class="date-label" :class="selectedDate == date.label ? 'date-label-active' : ''">{{ date.label }}</text>
								<text class="date-value" :class="selectedDate == date.label ? 'date-value-active' : ''">{{ date.value }}</text>
							</view>
						</view>
					</scroll-view>
				</view>

				<view class="section-card">
					<text class="section-title">见面地点</text>
					<view class="location-pill">
						<text class="location-pill-text">♧ {{ service.locationType }}</text>
					</view>
					<text class="location-text">{{ service.locationText }}</text>
				</view>

				<view class="section-card review-card">
					<view class="review-head">
						<text class="section-title">用户评价</text>
						<view class="rating-row">
							<text class="rating-star">★</text>
							<text class="rating-value">{{ service.rating }}</text>
							<text class="rating-count">（{{ service.reviewCount }} 条评价）</text>
						</view>
					</view>
					<view v-for="review in service.reviews" :key="review.id" class="review-item">
						<image class="review-avatar" :src="review.reviewerAvatar" mode="aspectFill"></image>
						<view class="review-main">
							<view class="review-top">
								<text class="review-name">{{ review.reviewerName }}</text>
								<text class="review-rating">★ {{ review.rating }}</text>
							</view>
							<text class="review-content">{{ review.content }}</text>
							<text class="review-time">{{ review.createdAt }}</text>
						</view>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="booking-bar">
			<view class="booking-info">
				<text class="booking-price">{{ service.price }}</text>
				<text class="booking-unit">{{ service.priceUnit }}</text>
				<text class="booking-duration">60 分钟起</text>
			</view>
			<view class="booking-button" @click="bookService">
				<text class="booking-icon">▣</text>
				<text class="booking-text">立即预约</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getServiceDetail } from '../../services/service-container.uts'
	import type { ServiceDetail } from '../../types/models.uts'
	import { requireAccount, SERVICE_DETAIL_ROUTE } from '../../router/route-guard.uts'

	const service = ref<ServiceDetail>(getServiceDetail('service-billiards-001'))
	const favorited = ref(false)
	const currentMedia = ref(0)
	const selectedDate = ref('今天')
	const dates = [
		{ label: '今天', value: '16' },
		{ label: '明天', value: '17' },
		{ label: '周日', value: '18' },
		{ label: '周一', value: '19' },
		{ label: '周二', value: '20' }
	]

	onLoad((options) => {
		const id = options['serviceId'] as string
		service.value = getServiceDetail(id != null && id.length > 0 ? decodeURIComponent(id) : 'service-billiards-001')
	})

	function onMediaChange(event: any) {
		currentMedia.value = event.detail.current
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/index/index'
				})
			}
		})
	}

	function toggleFavorite() {
		if (!requireAccount('favorite-service', SERVICE_DETAIL_ROUTE, service.value.id)) {
			return
		}
		favorited.value = !favorited.value
		uni.showToast({
			title: favorited.value ? '已收藏（开发 Mock）' : '已取消收藏',
			position: 'bottom',
			icon: 'success'
		})
	}

	function bookService() {
		if (!requireAccount('booking-service', SERVICE_DETAIL_ROUTE, service.value.id)) {
			return
		}
		uni.navigateTo({
			url: '/pages/order/confirm?serviceId=' + encodeURIComponent(service.value.id)
		})
	}
</script>

