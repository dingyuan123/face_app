<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">我的收藏</text>
				<view class="nav-placeholder"></view>
			</view>

			<segment-tabs
				:items="tabs"
				:active="selectedTab"
				variant="underline"
				@change="changeTab"
			></segment-tabs>

			<view class="safety-banner">
				<text class="safety-icon">♢</text>
				<text class="safety-text">安心见面，请选择公共经营场所</text>
			</view>

			<view v-if="items.length == 0" class="empty-state">
				<image class="empty-image" src="/static/favorites/empty.png" mode="aspectFit"></image>
				<text class="empty-title">还没有收藏的玩伴</text>
				<text class="empty-desc">遇见感兴趣的服务者，点亮爱心收藏</text>
				<text class="empty-desc">下次想约，随时在这里找到。</text>
				<view class="discover-button" @click="goDiscover">
					<text class="discover-text">去发现玩伴</text>
				</view>
			</view>

			<view v-else class="favorite-content">
				<view class="section-head">
					<text class="section-title">收藏的服务者</text>
					<text class="section-count">{{ items.length }} 位</text>
				</view>

				<view class="favorite-list">
					<view v-for="item in items" :key="item.id" class="favorite-card">
						<view class="favorite-head">
							<image class="avatar" :src="item.avatar" mode="aspectFill"></image>
							<view class="provider-main">
								<view class="provider-name-row">
									<text class="provider-name">{{ item.providerName }}</text>
									<view v-if="item.verified" class="verified-pill">
										<text class="verified-text">◉ 实名认证</text>
									</view>
								</view>
								<text class="provider-meta">{{ item.city }} · {{ item.category }}</text>
							</view>
							<image class="favorite-icon" src="/static/search/heart-filled.png" mode="aspectFit" @click="removeFavorite(item.id)"></image>
						</view>
						<text class="service-title">{{ item.serviceTitle }}</text>
						<view class="favorite-bottom">
							<view class="price-row">
								<text class="price-value">{{ item.price.split('/')[0] }}</text>
								<text class="price-unit">/{{ item.price.split('/')[1] }}</text>
								<text v-if="item.duration.length > 0" class="duration-text"> · {{ item.duration }}</text>
							</view>
							<view class="distance-row">
								<text class="distance-icon">⌖</text>
								<text class="distance-text">{{ item.distance }}</text>
							</view>
						</view>
					</view>
				</view>
			</view>

			<text v-if="items.length > 0" class="footer-tip">喜欢的玩伴，都在这里</text>
			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import { getFavoriteItems } from '../../services/service-container.uts'
	import type { FavoriteItem } from '../../types/models.uts'

	const tabs = ['全部', '运动', '娱乐', '休闲']
	const selectedTab = ref('全部')
	const items = ref<FavoriteItem[]>(getFavoriteItems('全部'))

	function changeTab(tab: string) {
		selectedTab.value = tab
		items.value = getFavoriteItems(tab)
	}

	function removeFavorite(id: string) {
		const next: Array<FavoriteItem> = []
		for (let i = 0; i < items.value.length; i++) {
			if (items.value[i].id != id) {
				next.push(items.value[i])
			}
		}
		items.value = next
		uni.showToast({
			title: '已取消收藏',
			position: 'bottom',
			icon: 'success'
		})
	}

	function goDiscover() {
		uni.reLaunch({
			url: '/pages/index/index'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}
</script>

