<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">我的关注</text>
				<view class="nav-placeholder"></view>
			</view>

			<view v-if="providers.length == 0" class="empty-state">
				<image class="empty-image" src="/static/favorites/empty.png" mode="aspectFit"></image>
				<text class="empty-title">还没有收藏的玩伴</text>
				<text class="empty-desc">遇见感兴趣的服务者，点亮爱心收藏</text>
				<text class="empty-desc">下次想约，随时在这里找到。</text>
				<view class="discover-button" @click="goDiscover">
					<text class="discover-text">去发现玩伴</text>
				</view>
			</view>

			<view v-else class="following-content">
				<view class="provider-head">
					<text class="section-title">关注的服务者</text>
					<text class="section-count">{{ providers.length }} 位</text>
				</view>

				<scroll-view class="provider-scroll" direction="horizontal" :show-scrollbar="false">
					<view class="provider-row">
						<view v-for="provider in providers" :key="provider.id" class="provider-item">
							<view class="provider-avatar-wrap">
								<image class="provider-avatar" :src="provider.avatar" mode="aspectFill"></image>
								<view v-if="provider.online" class="online-dot"></view>
							</view>
							<text class="provider-name">{{ provider.name }}</text>
							<text class="provider-label">{{ provider.serviceLabel }}</text>
						</view>
					</view>
				</scroll-view>

				<view class="moment-head">
					<text class="moment-title">最新动态</text>
					<view class="update-row">
						<view class="update-dot"></view>
						<text class="update-text">{{ moments.length }} 条更新</text>
					</view>
				</view>

				<view class="moment-list">
					<view v-for="moment in moments" :key="moment.id" class="moment-card" @click="openMoment(moment.id)">
						<view class="moment-author-row">
							<image class="moment-avatar" :src="moment.avatar" mode="aspectFill"></image>
							<view class="moment-author-main">
								<view class="moment-name-row">
									<text class="moment-name">{{ moment.providerName }}</text>
									<view v-if="moment.verified" class="verified-pill">
										<text class="verified-text">◉ 实名认证</text>
									</view>
								</view>
								<text class="moment-meta">{{ moment.publishedAt }} · {{ moment.categoryName }}</text>
							</view>
						</view>
						<text class="moment-content">{{ moment.content }}</text>
						<image class="moment-cover" :src="moment.coverImage" mode="aspectFill"></image>
						<view class="moment-footer">
							<view class="location-row">
								<text class="location-icon">⌖</text>
								<text class="location-text">{{ moment.location }}</text>
							</view>
							<text class="like-count">{{ moment.likeCount }} 人赞过</text>
						</view>
					</view>
				</view>

				<text class="end-tip">已看完最新动态，期待下次见面</text>
				<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			</view>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getFollowingMoments, getFollowingProviders } from '../../services/service-container.uts'
	import type { FollowingMoment, FollowingProvider } from '../../types/models.uts'

	const providers = ref<FollowingProvider[]>(getFollowingProviders())
	const moments = ref<FollowingMoment[]>(getFollowingMoments())

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function goDiscover() {
		uni.reLaunch({
			url: '/pages/index/index'
		})
	}

	function openMoment(id: string) {
		uni.navigateTo({
			url: '/pages/moment/detail?momentId=' + encodeURIComponent(id)
		})
	}
</script>

