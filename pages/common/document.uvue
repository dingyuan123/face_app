<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">{{ legalDocument.title }}</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="document-card">
					<text class="document-title">{{ legalDocument.title }}</text>
					<text class="document-date">{{ legalDocument.updatedAt }}</text>
					<view class="template-notice">
						<text class="template-icon">i</text>
						<text class="template-text">{{ legalDocument.summary }}</text>
					</view>

					<view v-for="section in legalDocument.sections" :key="section.title" class="section">
						<text class="section-title">{{ section.title }}</text>
						<text v-for="paragraph in section.paragraphs" :key="paragraph" class="section-paragraph">{{ paragraph }}</text>
					</view>

					<view class="document-footer">
						<text class="footer-title">见面聊（FaceTo）</text>
						<text class="footer-desc">本页面内容为开发模板，最终解释以正式发布版本为准。</text>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>
	</view>
</template>

<script setup lang="uts">
	import { getLegalDocument } from '../../services/service-container.uts'
	import type { LegalDocument } from '../../types/models.uts'

	const legalDocument = ref<LegalDocument>(getLegalDocument('user-agreement'))

	onLoad((options) => {
		if (options == null) {
			return
		}
		const type = options['type'] as string
		legalDocument.value = getLegalDocument(type != null && type.length > 0 ? decodeURIComponent(type) : 'user-agreement')
	})

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/about/about'
				})
			}
		})
	}
</script>

