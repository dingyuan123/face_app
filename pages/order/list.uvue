<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">我的订单</text>
				<view class="nav-button" @click="openService">
					<text class="nav-icon">♧</text>
				</view>
			</view>

			<segment-tabs
				class="order-tabs"
				:items="tabs"
				:active="activeTab"
				variant="underline"
				@change="changeTab"
			></segment-tabs>

			<view class="safety-banner">
				<text class="safety-icon">♢</text>
				<text class="safety-text">安心见面，请选择公共经营场所</text>
			</view>

			<view v-if="!sessionState.loggedIn" class="login-gate">
				<text class="gate-title">登录后查看我的订单</text>
				<text class="gate-desc">订单、预约和支付信息属于账号私有数据。</text>
				<facetof-button label="登录 / 注册" tone="gradient" @press="loginForOrders"></facetof-button>
			</view>

			<view v-else-if="orders.length == 0" class="empty-state">
				<text class="empty-title">暂无相关订单</text>
				<text class="empty-desc">换个状态看看吧</text>
			</view>

			<view v-else class="order-list">
				<view v-for="order in orders" :key="order.id" class="order-card">
					<view class="order-head">
						<image class="order-avatar" :src="order.avatar" mode="aspectFill"></image>
						<view class="order-main">
							<text class="order-title">{{ order.title }}</text>
							<view class="provider-row">
								<text class="provider-name">{{ order.providerName }}</text>
								<view v-if="order.verified" class="verified">
									<text class="verified-text">✓ 实名认证</text>
								</view>
							</view>
						</view>
						<view class="status-pill" :class="statusClass(order.status)">
							<text class="status-text" :class="statusTextClass(order.status)">{{ order.status }}</text>
						</view>
					</view>

					<view class="order-info">
						<view class="info-row">
							<text class="info-icon">◷</text>
							<text class="info-text">{{ order.time }}</text>
						</view>
						<view class="info-row">
							<text class="info-icon">⌖</text>
							<text class="info-text">{{ order.location }}</text>
						</view>
					</view>

					<view class="order-divider"></view>

					<view class="order-bottom">
						<view class="amount-row">
							<text class="amount-label">{{ order.amountLabel }}</text>
							<text class="amount-value">{{ order.amount }}</text>
						</view>
						<view class="action-button" :class="actionClass(order.status)" @click="handleOrder(order)">
							<text class="action-text" :class="actionTextClass(order.status)">{{ order.actionLabel }}</text>
						</view>
					</view>
				</view>
			</view>

			<view class="brand-footer">
				<text class="brand-text">FaceTo · 见面聊，安心见</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import FacetofButton from '../../components/facetof-button.uvue'
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import { getOrderList } from '../../services/service-container.uts'
	import type { OrderListItem } from '../../types/models.uts'
	import { sessionState } from '../../state/session-state.uts'
	import { openLogin, ORDER_LIST_ROUTE } from '../../router/route-guard.uts'

	const tabs = ['全部', '待支付', '待接单', '待履约', '进行中', '待评价', '已完成', '已取消']
	const activeTab = ref('全部')
	const orders = ref<OrderListItem[]>(getOrderList('全部'))

	function loginForOrders() {
		openLogin('view-orders', ORDER_LIST_ROUTE, '')
	}

	function changeTab(tab: string) {
		activeTab.value = tab
		orders.value = getOrderList(tab)
	}

	function statusClass(status: string): string {
		if (status == '已完成') {
			return 'status-success-bg'
		}
		if (status == '待接单' || status == '待履约' || status == '进行中') {
			return 'status-warning-bg'
		}
		return 'status-brand-bg'
	}

	function statusTextClass(status: string): string {
		if (status == '已完成') {
			return 'status-success-text'
		}
		if (status == '待接单' || status == '待履约' || status == '进行中') {
			return 'status-warning-text'
		}
		return 'status-brand-text'
	}

	function actionClass(status: string): string {
		if (status == '待支付' || status == '待评价') {
			return 'action-primary'
		}
		return 'action-outline'
	}

	function actionTextClass(status: string): string {
		return status == '待支付' || status == '待评价' ? 'action-primary-text' : 'action-outline-text'
	}

	function handleOrder(order: OrderListItem) {
		if (order.status == '待支付') {
			uni.navigateTo({
				url: '/pages/order/confirm?serviceId=service-billiards-001'
			})
			return
		}
		if (order.status == '待评价') {
			uni.navigateTo({
				url: '/pages/review/review?orderId=' + encodeURIComponent(order.id)
			})
			return
		}
		openOrderDetail(order.id)
	}

	function openOrderDetail(orderId: string) {
		uni.navigateTo({
			url: '/pages/order/detail?orderId=' + encodeURIComponent(orderId)
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function openService() {
		uni.showToast({
			title: '客服能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

