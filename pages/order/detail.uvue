<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">订单详情</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="status-banner">
					<image class="status-icon" :src="statusIcon(order.status)" mode="aspectFit"></image>
					<view class="status-copy">
						<text class="status-title">{{ order.status }}</text>
						<text class="status-desc">{{ order.statusDescription }}</text>
					</view>
				</view>

				<view class="section-card service-section">
					<text class="section-label">预约服务</text>
					<view class="service-row">
						<image class="service-image" src="/static/content/billiards.png" mode="aspectFill"></image>
						<view class="service-main">
							<text class="service-title">{{ order.serviceTitle }}</text>
							<text class="service-meta">{{ order.serviceLocation }}</text>
							<text class="service-meta">{{ order.serviceDuration }}</text>
						</view>
						<text class="service-price">{{ order.servicePrice }}</text>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">预约信息</text>
					<view class="info-row">
						<text class="info-icon">◷</text>
						<view class="info-copy">
							<text class="info-title">{{ order.appointmentDate }}</text>
							<text class="info-desc">{{ order.appointmentTime }}</text>
						</view>
					</view>
					<view class="info-row">
						<text class="info-icon">⌖</text>
						<view class="info-copy">
							<text class="info-title">{{ order.locationName }}</text>
							<text class="info-desc">{{ order.locationAddress }}</text>
						</view>
						<view class="location-link" @click="openLocation">
							<text class="location-link-text">查看位置 〉</text>
						</view>
					</view>
				</view>

				<view class="section-card people-card">
					<text class="section-title">见面双方</text>
					<view class="person-row">
						<view class="person-avatar provider-avatar">
							<text class="person-avatar-text">哲</text>
						</view>
						<view class="person-copy">
							<view class="person-name-row">
								<text class="person-name">服务者 · {{ order.providerName }}</text>
								<view class="verified-pill">
									<text class="verified-text">✓ 已认证</text>
								</view>
							</view>
							<text class="person-desc">{{ order.providerRating }}</text>
						</view>
						<view class="contact-button" @click="contactProvider">
							<text class="contact-text">联系</text>
						</view>
					</view>
					<view class="people-divider"></view>
					<view class="person-row">
						<view class="person-avatar customer-avatar">
							<text class="person-avatar-text">我</text>
						</view>
						<view class="person-copy">
							<text class="person-name">预约用户 · {{ order.customerName }}</text>
							<text class="person-desc">手机号 {{ order.customerPhone }}</text>
						</view>
						<view class="contact-button" @click="contactCustomer">
							<text class="contact-text">联系</text>
						</view>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">金额明细</text>
					<view class="amount-row">
						<text class="amount-label">服务费用</text>
						<text class="amount-value">¥68.00</text>
					</view>
					<view class="amount-row">
						<text class="amount-label">平台服务费</text>
						<text class="amount-value">{{ order.platformFee }}</text>
					</view>
					<view class="amount-divider"></view>
					<view class="amount-row total-row">
						<text class="total-label">实付金额</text>
						<text class="total-value">{{ order.totalAmount }}</text>
					</view>
				</view>

				<view class="section-card">
					<text class="section-title">订单进度</text>
					<view class="timeline">
						<view v-for="(item, index) in order.timeline" :key="item.title" class="timeline-item">
							<view class="timeline-marker-wrap">
								<view class="timeline-marker" :class="timelineClass(item.state)"></view>
								<view v-if="index < order.timeline.length - 1" class="timeline-line"></view>
							</view>
							<view class="timeline-copy">
								<text class="timeline-title">{{ item.title }}</text>
								<text class="timeline-desc">{{ item.description }}</text>
								<text v-if="item.time.length > 0" class="timeline-time">{{ item.time }}</text>
							</view>
						</view>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="bottom-bar">
			<view class="rule-button" @click="openRules">
				<text class="rule-text">订单规则</text>
			</view>
			<view class="contact-button-large" @click="contactProvider">
				<text class="contact-large-text">联系对方</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getOrderDetail } from '../../services/service-container.uts'
	import type { OrderDetail } from '../../types/models.uts'

	const order = ref<OrderDetail>(getOrderDetail('order-002'))

	onLoad((options) => {
		const id = options['orderId'] as string
		order.value = getOrderDetail(id != null && id.length > 0 ? decodeURIComponent(id) : 'order-002')
	})

	function statusIcon(status: string): string {
		if (status == '已完成') {
			return '/static/order/status-completed.png'
		}
		if (status == '进行中' || status == '待履约') {
			return '/static/order/status-progress.png'
		}
		if (status == '待支付') {
			return '/static/order/status-pending.png'
		}
		if (status == '已取消') {
			return '/static/order/status-cancelled.png'
		}
		return '/static/order/status-accepted.png'
	}

	function timelineClass(state: string): string {
		if (state == 'done') {
			return 'marker-done'
		}
		if (state == 'current') {
			return 'marker-current'
		}
		return 'marker-future'
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/order/list'
				})
			}
		})
	}

	function openLocation() {
		uni.showToast({
			title: '地图查看将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function contactProvider() {
		uni.showToast({
			title: '联系服务者将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function contactCustomer() {
		uni.showToast({
			title: '联系用户将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openRules() {
		uni.showToast({
			title: '订单规则将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

