<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">确认订单</text>
				<view class="nav-button" @click="openService">
					<text class="nav-icon">♧</text>
				</view>
			</view>

			<view class="trust-banner">
				<text class="trust-icon">♢</text>
				<view class="trust-copy">
					<text class="trust-title">见面聊，安心见</text>
					<text class="trust-subtitle">FaceTo · 实名认证 · 平台担保交易</text>
				</view>
			</view>

			<view class="section-card service-card">
				<image class="service-image" :src="order.providerAvatar" mode="aspectFill"></image>
				<view class="service-main">
					<text class="service-title">{{ order.serviceTitle }}</text>
					<text class="service-meta">{{ order.providerName }} · 泸州江阳区</text>
					<view class="tag-row">
						<view class="tag">
							<text class="tag-text">◉ 实名认证</text>
						</view>
						<view class="tag">
							<text class="tag-text">技能认证</text>
						</view>
					</view>
				</view>
				<view class="service-price">
					<text class="price-value">¥80</text>
					<text class="price-unit">/小时</text>
				</view>
				<view class="service-divider"></view>
				<text class="service-detail">{{ order.format }} · {{ order.duration }}</text>
			</view>

			<view class="section-card">
				<view class="section-head">
					<text class="section-title">预约时间</text>
					<text class="section-meta">2026年10月 ⛷</text>
				</view>
				<scroll-view class="date-scroll" direction="horizontal" :show-scrollbar="false">
					<view class="date-row">
						<view v-for="date in dates" :key="date.value" class="date-item" :class="selectedDate == date.value ? 'date-active' : ''" @click="selectedDate = date.value">
							<text class="date-label" :class="selectedDate == date.value ? 'date-label-active' : ''">{{ date.label }}</text>
							<text class="date-value" :class="selectedDate == date.value ? 'date-value-active' : ''">{{ date.value }}</text>
						</view>
					</view>
				</scroll-view>
				<view class="time-row" @click="chooseTime">
					<text class="time-icon">◷</text>
					<text class="time-value">{{ order.timeRange }}</text>
					<text class="time-meta">共{{ order.duration }} 〉</text>
				</view>
				<text class="tip-text">请提前10分钟到店，和助教从容见面。</text>
			</view>

			<view class="section-card">
				<view class="section-head">
					<text class="section-title">见面地点</text>
					<view class="map-link" @click="chooseLocation">
						<text class="map-text">⌖ 地图选点 〉</text>
					</view>
				</view>
				<text class="location-name">{{ order.locationName }}</text>
				<text class="location-address">{{ order.locationAddress }}</text>
				<view class="location-tag-row">
					<view class="location-tag">
						<text class="location-tag-text">♧ 公共经营场所</text>
					</view>
					<text class="location-tip">到店前台集合</text>
				</view>
				<view class="notice-row">
					<text class="notice-icon">♢</text>
					<text class="notice-text">{{ order.locationTip }}</text>
				</view>
			</view>

			<view class="section-card">
				<view class="section-head">
					<text class="section-title">给助教留言</text>
					<text class="optional">选填</text>
				</view>
				<textarea class="note-input" :value="note" maxlength="200" placeholder="我是台球新手，想先学习握杆、站姿和直线击球，谢谢！" placeholder-class="note-placeholder" @input="onNoteInput"></textarea>
				<text class="note-count">{{ note.length }}/200</text>
			</view>

			<view class="section-card">
				<text class="section-title">金额明细</text>
				<view class="amount-row">
					<text class="amount-label">服务价格（¥80 × 2小时）</text>
					<text class="amount-value">¥160.00</text>
				</view>
				<view class="amount-row">
					<text class="amount-label">平台服务费</text>
					<text class="amount-value">¥8.00</text>
				</view>
				<view class="amount-divider"></view>
				<view class="amount-row total-row">
					<text class="total-label">应付总额</text>
					<text class="total-value">¥168.00</text>
				</view>
				<text class="amount-note">已含球台费，无需到店另付。服务费含交易保障。</text>
			</view>

			<view class="section-card payment-card">
				<text class="section-title">支付方式</text>
				<view class="payment-option" :class="paymentMethod == '微信支付' ? 'payment-active' : ''" @click="paymentMethod = '微信支付'">
					<view class="payment-icon wechat-icon">微</view>
					<view class="payment-copy">
						<text class="payment-name">微信支付</text>
						<text class="payment-desc">推荐使用 · 安全快捷</text>
					</view>
					<view class="radio">{{ paymentMethod == '微信支付' ? '✓' : '' }}</view>
				</view>
				<view class="payment-option" :class="paymentMethod == '支付宝' ? 'payment-active' : ''" @click="paymentMethod = '支付宝'">
					<view class="payment-icon alipay-icon">支</view>
					<view class="payment-copy">
						<text class="payment-name">支付宝</text>
						<text class="payment-desc">支付宝安全支付</text>
					</view>
					<view class="radio">{{ paymentMethod == '支付宝' ? '✓' : '' }}</view>
				</view>
			</view>

			<view class="agreement-row" @click="agreed = !agreed">
				<view class="checkbox">{{ agreed ? '✓' : '' }}</view>
				<text class="agreement-text">我已阅读并同意《用户服务协议》、《下单须知》及《取消与退款规则》</text>
			</view>
			<view class="bottom-space"></view>
		</view>
		</scroll-view>

		<view class="submit-bar">
			<view class="submit-total">
				<text class="submit-total-label">合计（含服务费）</text>
				<text class="submit-total-value">¥168.00</text>
			</view>
			<view class="submit-button" @click="submitPayment">
				<text class="submit-lock">♧</text>
				<text class="submit-text">确认支付</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getOrderDraft, submitOrder } from '../../services/service-container.uts'
	import type { OrderDraft } from '../../types/models.uts'

	const order = ref<OrderDraft>(getOrderDraft('service-billiards-001'))
	const selectedDate = ref('17')
	const paymentMethod = ref('微信支付')
	const agreed = ref(true)
	const note = ref('')

	const dates = [
		{ label: '明天 周六', value: '17' },
		{ label: '周日', value: '18' },
		{ label: '周一', value: '19' },
		{ label: '周二', value: '20' }
	]

	onLoad((options) => {
		const serviceId = options['serviceId'] as string
		order.value = getOrderDraft(serviceId != null && serviceId.length > 0 ? decodeURIComponent(serviceId) : 'service-billiards-001')
	})

	function onNoteInput(event: InputEvent) {
		note.value = event.detail.value
	}

	function chooseTime() {
		uni.showToast({
			title: '时间段选择将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function chooseLocation() {
		uni.showToast({
			title: '地图选点将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openService() {
		uni.showToast({
			title: '客服能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/service/detail'
				})
			}
		})
	}

	function submitPayment() {
		if (!agreed.value) {
			uni.showToast({
				title: '请先阅读并同意相关协议',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		const result = submitOrder(order.value.orderId, paymentMethod.value)
		if (!result.ok) {
			uni.navigateTo({
				url: '/pages/payment/result?status=failed&orderId=' + encodeURIComponent(order.value.orderId)
			})
			return
		}
		uni.navigateTo({
			url: '/pages/payment/result?status=success&orderId=' + encodeURIComponent(order.value.orderId) + '&method=' + encodeURIComponent(paymentMethod.value)
		})
	}
</script>

