<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">会员中心</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="membership-card">
				<view class="membership-copy">
					<text class="membership-brand">FaceTo MEMBERSHIP</text>
					<view class="membership-status-row">
						<view class="membership-status-dot"></view>
						<text class="membership-status">{{ membership.status }}</text>
					</view>
					<text class="membership-name">{{ membership.membershipName }}</text>
					<text class="membership-expire">有效期至 {{ membership.expireAt }}</text>
				</view>
				<view class="crown-circle">
					<text class="crown-text">♛</text>
				</view>
			</view>

			<view class="benefit-head">
				<text class="section-title">让每次见面，多一份心意</text>
				<text class="section-count">3 项权益</text>
			</view>

			<view class="benefit-card">
				<view v-for="(benefit, index) in membership.benefits" :key="benefit.id" class="benefit-row" :class="index == membership.benefits.length - 1 ? 'benefit-row-last' : ''">
					<view class="benefit-icon">
						<text class="benefit-icon-text">{{ benefitIcon(benefit.iconType) }}</text>
					</view>
					<view class="benefit-copy">
						<text class="benefit-title">{{ benefit.title }}</text>
						<text class="benefit-desc">{{ benefit.description }}</text>
					</view>
				</view>
			</view>

			<view class="plan-head">
				<text class="section-title">续费会员</text>
				<text class="section-subtitle">金卡权益，随心选择</text>
			</view>

			<view class="plan-grid">
				<view
					v-for="plan in membership.plans"
					:key="plan.id"
					class="plan-card"
					:class="selectedPlan == plan.id ? 'plan-card-active' : ''"
					@click="selectedPlan = plan.id"
				>
					<view class="plan-title-row">
						<text class="plan-title">{{ plan.title }}</text>
						<view v-if="selectedPlan == plan.id" class="plan-check">✓</view>
					</view>
					<view class="plan-price-row">
						<text class="plan-symbol">¥</text>
						<text class="plan-price" :class="selectedPlan == plan.id ? 'plan-price-active' : ''">{{ plan.price.replace('¥', '') }}</text>
					</view>
					<text class="plan-duration">{{ plan.duration }}</text>
				</view>
			</view>

			<text class="policy-note">套餐价格与权益仅为设计示例，非平台已确认政策。</text>
			<view class="bottom-safe-space"></view>
		</view>
		</scroll-view>

		<view class="action-bar">
			<view class="selected-row">
				<text class="selected-label">已选{{ selectedPlanTitle }} · {{ selectedPlanDuration }}</text>
				<view class="pay-row">
					<text class="pay-label">应付</text>
					<text class="pay-symbol">¥</text>
					<text class="pay-value">{{ selectedPlanPrice }}</text>
				</view>
			</view>
			<view class="open-button" @click="openMembership">
				<text class="open-text">立即开通</text>
			</view>
			<text class="action-tip">已是会员，开通后有效期顺延</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { getMembershipSummary } from '../../services/service-container.uts'
	import type { MembershipSummary } from '../../types/models.uts'

	const membership = ref<MembershipSummary>(getMembershipSummary())
	const selectedPlan = ref('plan-quarter')

	const selectedPlanData = computed(() => {
		for (let i = 0; i < membership.value.plans.length; i++) {
			if (membership.value.plans[i].id == selectedPlan.value) {
				return membership.value.plans[i]
			}
		}
		return membership.value.plans[1]
	})

	const selectedPlanTitle = computed(() : string => selectedPlanData.value.title)
	const selectedPlanDuration = computed(() : string => selectedPlanData.value.duration.replace('有效期 ', ''))
	const selectedPlanPrice = computed(() : string => selectedPlanData.value.price.replace('¥', '') + '.00')

	function benefitIcon(type: string): string {
		if (type == 'support') {
			return '♧'
		}
		if (type == 'coupon') {
			return '券'
		}
		return '✦'
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function openMembership() {
		uni.showToast({
			title: '会员开通将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

