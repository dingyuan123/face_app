<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">我的钱包</text>
				<view class="nav-button" @click="openService">
					<image class="support-icon-image" src="/static/wallet/icon-support.png" mode="aspectFit"></image>
				</view>
			</view>

			<view class="balance-card">
				<view class="balance-head">
					<text class="balance-label">可用余额（元）</text>
					<view class="wallet-icon">
						<image class="wallet-icon-image" src="/static/wallet/icon-wallet.png" mode="aspectFit"></image>
					</view>
				</view>
				<view class="balance-row">
					<text class="currency">¥</text>
					<text class="balance-value">{{ wallet.availableAmount }}</text>
				</view>
				<view class="balance-divider"></view>
				<view class="frozen-row">
					<image class="frozen-icon-image" src="/static/wallet/icon-lock.png" mode="aspectFit"></image>
					<text class="frozen-label">冻结金额</text>
					<text class="frozen-value">¥{{ wallet.frozenAmount }}</text>
				</view>
				<text class="frozen-desc">{{ wallet.frozenDescription }}</text>
			</view>

			<view class="wallet-actions">
				<view class="action-button outline" @click="withdraw">
					<text class="action-symbol">↗</text>
					<text class="action-text">提现</text>
				</view>
				<view class="action-button primary action-button-later" @click="recharge">
					<text class="action-symbol action-symbol-primary">＋</text>
					<text class="action-text action-text-primary">充值</text>
				</view>
			</view>

			<view class="payment-card" @click="openPaymentMethods">
				<view class="payment-icon">
					<image class="payment-icon-image" src="/static/wallet/icon-payment.png" mode="aspectFit"></image>
				</view>
				<view class="payment-main">
					<text class="payment-title">支付方式管理</text>
					<text class="payment-desc">{{ wallet.paymentName }} · 银行卡尾号 {{ wallet.cardTail }}</text>
				</view>
				<text class="arrow">›</text>
			</view>

			<view class="transaction-head">
				<text class="section-title">交易记录</text>
				<view class="month-button" @click="chooseMonth">
					<text class="month-text">2026年10月⌄</text>
				</view>
			</view>

			<view class="transaction-tabs">
				<segment-tabs
					:items="tabs"
					:active="activeTab"
					variant="chip"
					@change="changeTab"
				></segment-tabs>
			</view>

			<view class="transaction-list">
				<view v-for="(transaction, index) in transactions" :key="transaction.id" class="transaction-item" :class="index == transactions.length - 1 ? 'transaction-item-last' : ''">
					<view class="transaction-icon" :class="iconClass(transaction.iconType)">
						<text class="transaction-icon-text">{{ transactionIcon(transaction.iconType) }}</text>
					</view>
					<view class="transaction-main">
						<view class="transaction-top">
							<text class="transaction-title">{{ transaction.title }}</text>
							<text class="transaction-amount" :class="amountClass(transaction.amount)">{{ transaction.amount }}</text>
						</view>
						<view class="transaction-meta-row">
							<text class="transaction-subtitle">{{ transaction.subtitle }}</text>
							<text class="transaction-time">{{ transaction.time }}</text>
						</view>
						<text class="transaction-status" :class="statusClass(transaction.status)">{{ transaction.status }}</text>
					</view>
				</view>
			</view>

			<view class="end-line"></view>
			<text class="end-text">本月记录已全部展示</text>
			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import { getWalletSummary, getWalletTransactions } from '../../services/service-container.uts'
	import type { WalletSummary, WalletTransaction } from '../../types/models.uts'

	const tabs = ['全部', '收入', '支出', '充值/提现']
	const activeTab = ref('全部')
	const wallet = ref<WalletSummary>(getWalletSummary())
	const transactions = ref<WalletTransaction[]>(getWalletTransactions('全部'))

	function changeTab(tab: string) {
		activeTab.value = tab
		transactions.value = getWalletTransactions(tab)
	}

	function transactionIcon(type: string): string {
		if (type == 'withdraw') {
			return '↗'
		}
		if (type == 'income') {
			return '↙'
		}
		if (type == 'expense') {
			return '☷'
		}
		return '＋'
	}

	function iconClass(type: string): string {
		if (type == 'income' || type == 'recharge') {
			return 'transaction-icon-income'
		}
		if (type == 'expense') {
			return 'transaction-icon-expense'
		}
		return 'transaction-icon-withdraw'
	}

	function amountClass(amount: string): string {
		return amount.indexOf('+') == 0 ? 'amount-income' : 'amount-expense'
	}

	function statusClass(status: string): string {
		if (status == '已完成' || status == '提现成功') {
			return 'status-success'
		}
		return 'status-warning'
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function openService() {
		uni.showToast({
			title: '客服能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function withdraw() {
		uni.showToast({
			title: '提现申请将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function recharge() {
		uni.showToast({
			title: '充值能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openPaymentMethods() {
		uni.showToast({
			title: '支付方式管理将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function chooseMonth() {
		uni.showToast({
			title: '交易月份选择将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

