	}

	.security-desc {
		margin-top: 10rpx;
		font-size: 23rpx;
		line-height: 36rpx;
		color: $facetof-color-primary;
	}

	.form-card,
	.status-card {
		margin: 26rpx 32rpx 0;
		padding: 30rpx;
		background-color: #FFFFFF;
		border: 1rpx solid #F5DED5;
		border-radius: 28rpx;
	}

