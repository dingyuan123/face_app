<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">实名认证</text>
					<view class="nav-placeholder"></view>
				</view>

				<view class="security-banner">
					<image class="security-icon" src="/static/search/shield.png" mode="aspectFit"></image>
					<view class="security-copy">
						<text class="security-title">真实身份，安心相见</text>
						<text class="security-desc">平台加密保护你的身份信息，仅用于身份核验，不公开展示。</text>
					</view>
				</view>

				<view class="form-card">
					<text class="section-title">填写身份信息</text>
					<text class="field-label">姓名</text>
					<view class="input-wrap">
						<text class="input-icon">♙</text>
						<input
							class="input"
							:value="realName"
							maxlength="20"
							placeholder="请输入本人真实姓名"
							placeholder-class="placeholder"
							@input="onNameInput"
						/>
					</view>
					<text class="field-help">请与身份证上的姓名保持一致</text>

					<text class="field-label field-label-space">身份证号码</text>
					<view class="input-wrap">
						<text class="input-icon">▣</text>
						<input
							class="input"
							type="text"
							:value="idNumber"
							maxlength="18"
							placeholder="请输入本人身份证号码"
							placeholder-class="placeholder"
							@input="onIdInput"
						/>
					</view>
					<text class="field-help">18位身份证号码，末位为 X 时请大写</text>
				</view>

				<view class="status-card">
					<view class="status-head">
						<text class="section-title">认证状态</text>
						<view class="status-pill" :class="statusClass()">
							<text class="status-text" :class="verificationStatus == '已提交' ? 'status-text-pending' : verificationStatus == '认证通过' ? 'status-text-success' : ''">{{ verificationStatus }}</text>
						</view>
					</view>
					<text class="status-desc">{{ statusDescription() }}</text>
				</view>

				<view class="privacy-row">
					<text class="privacy-icon">♙</text>
					<text class="privacy-text">你的姓名和身份证号码不会公开展示</text>
				</view>
				<view class="privacy-links">
					<text class="privacy-link">隐私政策</text>
					<text class="privacy-divider">|</text>
					<text class="privacy-link">实名认证须知</text>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="action-bar">
			<view class="submit-button" :class="canSubmit() ? '' : 'submit-disabled'" @click="submitVerification">
				<text class="submit-text" :class="canSubmit() ? '' : 'submit-text-disabled'">提交认证</text>
			</view>
			<text class="submit-tip">填写完整后即可提交认证</text>
			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
		</view>
	</view>
</template>

<script setup lang="uts">
		import { submitIdVerification } from '../../services/service-container.uts'

	const realName = ref('')
	const idNumber = ref('')
	const verificationStatus = ref('未认证')

	function canSubmit(): boolean {
		return realName.value.trim().length >= 2 && idNumber.value.trim().length == 18
	}

	function statusClass(): string {
		if (verificationStatus.value == '已提交') {
			return 'status-pending'
		}
		if (verificationStatus.value == '认证通过') {
			return 'status-success'
		}
		return 'status-idle'
	}

	function statusDescription(): string {
		if (verificationStatus.value == '已提交') {
			return '资料已提交，平台正在核验身份信息。'
		}
		if (verificationStatus.value == '认证通过') {
			return '身份信息核验通过。'
		}
		return '尚未提交认证，请先填写本人的身份信息。'
	}

	function onNameInput(event: InputEvent) {
		realName.value = event.detail.value
	}

	function onIdInput(event: InputEvent) {
		idNumber.value = event.detail.value
	}

	function submitVerification() {
		if (!canSubmit.value) {
			uni.showToast({
				title: '请完整填写姓名和身份证号码',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		const result = submitIdVerification(realName.value, idNumber.value)
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
		if (result.ok) {
			verificationStatus.value = '已提交'
		}
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}
</script>

