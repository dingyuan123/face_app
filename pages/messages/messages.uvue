<template>
	<view class="page">
		<view class="page-head">
			<text class="page-title">消息</text>
			<view class="service-entry" @click="openService">
				<text class="service-icon">?</text>
				<text class="service-text">客服</text>
			</view>
		</view>

		<segment-tabs
			:items="tabs"
			:active="selectedTab"
			variant="underline"
			@change="changeTab"
		></segment-tabs>

		<scroll-view class="content-scroll" direction="vertical" :show-scrollbar="false">
			<view class="content">
				<view class="safety-banner">
					<view class="safety-icon">!</view>
					<view class="safety-copy">
						<text class="safety-title">安心见面提醒</text>
						<text class="safety-desc">优先选择公共场所，不提前支付站外费用，保护个人隐私。</text>
					</view>
				</view>

				<view v-if="!sessionState.loggedIn" class="login-gate">
					<view class="gate-icon">◇</view>
					<text class="gate-title">登录后查看消息</text>
					<text class="gate-desc">订单消息和系统通知属于账号私有数据。</text>
					<facetof-button label="登录 / 注册" tone="gradient" @press="loginForMessages"></facetof-button>
				</view>

				<view v-else-if="threads.length == 0" class="empty-state">
					<text class="empty-title">暂时没有消息</text>
					<text class="empty-desc">新的订单和平台通知会显示在这里</text>
				</view>

				<view v-else class="thread-list">
					<view v-for="(thread, index) in threads" :key="thread.id" :class="index == threads.length - 1 ? 'thread-item thread-item-last' : 'thread-item'" @click="openThread(thread.id)">
						<view class="avatar-wrap">
							<image class="avatar" :src="thread.avatar" mode="aspectFill"></image>
							<view v-if="thread.unreadCount > 0" class="unread-dot">
								<text class="unread-text">{{ thread.unreadCount }}</text>
							</view>
						</view>
						<view class="thread-main">
							<view class="thread-top">
								<text class="thread-name">{{ thread.name }}</text>
								<text class="thread-time">{{ thread.time }}</text>
							</view>
							<text class="thread-preview">{{ thread.preview }}</text>
							<view v-if="thread.orderStatus.length > 0" class="order-status">
								<text class="order-status-text">{{ thread.orderStatus }}</text>
							</view>
						</view>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

	</view>
</template>

<script setup lang="uts">
	import FacetofButton from '../../components/facetof-button.uvue'
	import SegmentTabs from '../../components/segment-tabs.uvue'
		import { getMessageThreads } from '../../services/service-container.uts'
	import type { MessageThread } from '../../types/models.uts'
	import { sessionState } from '../../state/session-state.uts'
	import { MESSAGES_ROUTE, openLogin } from '../../router/route-guard.uts'

	const tabs = ['订单消息', '系统通知']
	const selectedTab = ref('订单消息')
	const threads = ref<MessageThread[]>([])

	function refreshThreads() {
		threads.value = getMessageThreads(selectedTab.value)
	}

	onShow(() => {
		refreshThreads()
	})

	function changeTab(tab: string) {
		selectedTab.value = tab
		refreshThreads()
	}

	function loginForMessages() {
		openLogin('view-messages', MESSAGES_ROUTE, '')
	}

	function openService() {
		uni.showToast({
			title: '客服帮助将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openThread(id: string) {
		uni.showToast({
			title: '聊天详情页将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

</script>

