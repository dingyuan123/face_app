<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
			<view class="page-content">
				<view class="nav-bar">
					<view class="nav-button" @click="goBack">
						<text class="nav-icon">‹</text>
					</view>
					<text class="nav-title">发表评价</text>
					<view class="nav-placeholder"></view>
				</view>

				<text class="intro">评价将帮助更多人做出选择</text>

				<view class="provider-card">
					<view class="provider-avatar">
						<text class="provider-avatar-text">哲</text>
					</view>
					<view class="provider-main">
						<text class="provider-name">阿哲</text>
						<view class="verified-pill">
							<text class="verified-text">✓ 已认证</text>
						</view>
						<text class="service-title">台球助教 · 新手体验</text>
						<text class="service-meta">泸州 · 江阳区 · ¥68</text>
					</view>
				</view>

				<view class="section">
					<text class="section-title">这次服务体验如何？</text>
					<text class="section-desc">点亮星星，为服务打分</text>
					<view class="rating-row">
						<view class="star-button" @click="setRating(1)">
							<text class="star" :class="rating >= 1 ? 'star-active' : ''">★</text>
						</view>
						<view class="star-button" @click="setRating(2)">
							<text class="star" :class="rating >= 2 ? 'star-active' : ''">★</text>
						</view>
						<view class="star-button" @click="setRating(3)">
							<text class="star" :class="rating >= 3 ? 'star-active' : ''">★</text>
						</view>
						<view class="star-button" @click="setRating(4)">
							<text class="star" :class="rating >= 4 ? 'star-active' : ''">★</text>
						</view>
						<view class="star-button" @click="setRating(5)">
							<text class="star" :class="rating >= 5 ? 'star-active' : ''">★</text>
						</view>
					</view>
					<text class="rating-label">{{ ratingLabel }}</text>
				</view>

				<view class="section">
					<text class="section-title">哪些方面让你满意？</text>
					<text class="section-desc">可多选，分享你的真实感受</text>
					<view class="tag-wrap">
						<view class="tag-button" :class="tagOne ? 'tag-button-active' : ''" @click="tagOne = !tagOne">
							<text class="tag-check">{{ tagOne ? '✓' : '' }}</text>
							<text class="tag-text">服务热情</text>
						</view>
						<view class="tag-button" :class="tagTwo ? 'tag-button-active' : ''" @click="tagTwo = !tagTwo">
							<text class="tag-check">{{ tagTwo ? '✓' : '' }}</text>
							<text class="tag-text">准时到达</text>
						</view>
						<view class="tag-button" :class="tagThree ? 'tag-button-active' : ''" @click="tagThree = !tagThree">
							<text class="tag-check">{{ tagThree ? '✓' : '' }}</text>
							<text class="tag-text">专业耐心</text>
						</view>
						<view class="tag-button" :class="tagFour ? 'tag-button-active' : ''" @click="tagFour = !tagFour">
							<text class="tag-check">{{ tagFour ? '✓' : '' }}</text>
							<text class="tag-text">气氛好</text>
						</view>
					</view>
				</view>

				<view class="section">
					<text class="section-title">写下你的评价</text>
					<textarea
						class="review-input"
						:value="content"
						maxlength="200"
						placeholder="说说服务中的细节，帮助其他用户参考～"
						placeholder-class="input-placeholder"
						@input="onContentInput"
					></textarea>
					<text class="count">{{ content.length }}/200</text>
				</view>

				<view class="anonymous-row" @click="anonymous = !anonymous">
					<view class="checkbox">{{ anonymous ? '✓' : '' }}</view>
					<view class="anonymous-copy">
						<text class="anonymous-title">匿名评价</text>
						<text class="anonymous-desc">隐藏昵称和头像，评价内容仍会展示</text>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<view class="action-bar">
			<view class="submit-button" :class="rating > 0 ? '' : 'submit-disabled'" @click="submitReview">
				<text class="submit-text" :class="rating > 0 ? '' : 'submit-text-disabled'">提交评价</text>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { computed } from 'vue'
	import { submitReview as submitReviewRequest } from '../../services/service-container.uts'

	const rating = ref(5)
	const anonymous = ref(false)
	const content = ref('')
	const tagOne = ref(true)
	const tagTwo = ref(true)
	const tagThree = ref(true)
	const tagFour = ref(true)

	const ratingLabel = computed(() : string => {
		if (rating.value >= 5) {
			return '非常满意'
		}
		if (rating.value == 4) {
			return '满意'
		}
		if (rating.value == 3) {
			return '一般'
		}
		if (rating.value == 2) {
			return '不满意'
		}
		return '非常不满意'
	})

	function setRating(value: number) {
		rating.value = value
	}

	function buildSelectedTags(): Array<string> {
		const result: Array<string> = []
		if (tagOne.value) {
			result.push('服务热情')
		}
		if (tagTwo.value) {
			result.push('准时到达')
		}
		if (tagThree.value) {
			result.push('专业耐心')
		}
		if (tagFour.value) {
			result.push('气氛好')
		}
		return result
	}

	function onContentInput(event: InputEvent) {
		content.value = event.detail.value
	}

	function submitReview() {
		const result = submitReviewRequest(rating.value, buildSelectedTags(), content.value, anonymous.value)
		uni.showToast({
			title: result.message,
			position: 'bottom',
			icon: result.ok ? 'success' : 'error'
		})
		if (result.ok) {
			setTimeout(() => {
				uni.reLaunch({
					url: '/pages/order/list'
				})
			}, 500)
		}
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/order/list'
				})
			}
		})
	}
</script>

