<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="search-header">
				<view class="back-button" @click="goBack">
					<image class="back-icon" src="/static/search/back.png" mode="aspectFit"></image>
				</view>
				<view class="search-box">
					<image class="search-icon" src="/static/search/search.png" mode="aspectFit"></image>
					<input
						class="search-input"
						:value="query"
						confirm-type="search"
						placeholder="搜索服务者、服务、动态或资讯"
						placeholder-class="search-placeholder"
						@input="onQueryInput"
						@confirm="refreshResults"
					/>
				</view>
				<view class="bell-button" @click="openMessages">
					<image class="bell-icon" src="/static/search/bell.png" mode="aspectFit"></image>
				</view>
			</view>

			<segment-tabs
				:items="tabs"
				:active="activeTab"
				variant="underline"
				@change="changeTab"
			></segment-tabs>

			<view class="summary-row">
				<text class="summary-title">为你找到合适的玩伴</text>
				<text class="summary-meta">泸州 · {{ results.length }} 条结果</text>
			</view>

			<segment-tabs
				class="filter-tabs"
				:items="filters"
				:active="activeFilter"
				variant="chip"
				@change="changeFilter"
			></segment-tabs>

			<view v-if="results.length == 0" class="empty-state">
				<text class="empty-title">没有找到相关内容</text>
				<text class="empty-desc">试试更换关键词或筛选条件</text>
			</view>

			<view v-else class="result-list">
				<view v-for="item in results" :key="item.id" class="result-card">
					<view v-if="item.type == '服务者'" class="provider-result">
						<view class="provider-head">
							<image class="result-avatar" :src="item.avatar" mode="aspectFill"></image>
							<view class="provider-main">
								<view class="provider-name-row">
									<text class="result-name">{{ item.providerName }}</text>
									<view v-if="item.verified" class="verified-pill">
										<text class="verified-text">✓ 实名认证</text>
									</view>
								</view>
								<text class="result-meta">{{ item.subtitle }}</text>
							</view>
							<view class="price-block"><text class="price-text">{{ item.price }}</text></view>
						</view>
						<view class="result-divider"></view>
						<text class="provider-service-title">{{ item.title }}</text>
						<text class="result-description">{{ item.description }}</text>
						<view class="tag-row centered">
							<view v-for="tag in item.tags" :key="tag" class="tag-pill">
								<text class="tag-text">{{ tag }}</text>
							</view>
						</view>
						<view class="action-row">
							<view class="action-button secondary" @click="handleSecondary(item)">
								<text class="action-secondary-text">{{ item.secondaryAction }}</text>
							</view>
							<view class="action-button primary action-button-later" @click="handlePrimary(item)">
								<text class="action-primary-text">{{ item.primaryAction }}</text>
							</view>
						</view>
					</view>

					<view v-else-if="item.type == '服务'" class="media-result">
						<image class="media-cover" :src="item.coverImage" mode="aspectFill"></image>
						<view class="media-main">
							<view class="type-row">
								<view class="type-pill">
									<text class="type-text">服务</text>
								</view>
								<text class="result-meta">{{ item.meta }}</text>
							</view>
							<text class="media-title">{{ item.title }}</text>
							<text class="result-description">{{ item.subtitle }}</text>
							<view class="media-bottom">
								<view class="tag-row media-tags">
									<view v-for="tag in item.tags" :key="tag" class="tag-pill">
										<text class="tag-text">{{ tag }}</text>
									</view>
								</view>
								<view class="price-block compact-price">
									<text class="price-text">{{ item.price }}</text>
								</view>
							</view>
						</view>
					</view>

					<view v-else-if="item.type == '动态'" class="moment-result">
						<view class="moment-head">
							<image class="result-avatar result-avatar-small" :src="item.avatar" mode="aspectFill"></image>
							<view class="moment-author">
								<text class="result-name">{{ item.providerName }}</text>
								<text class="result-meta">{{ item.subtitle }}</text>
							</view>
							<view class="type-pill">
								<text class="type-text">动态</text>
							</view>
						</view>
						<view class="moment-content">
							<view class="moment-copy">
								<text class="moment-title">{{ item.title }}</text>
								<text class="result-description">{{ item.description }}</text>
								<view class="tag-row">
									<view v-for="tag in item.tags" :key="tag" class="tag-pill">
										<text class="tag-text">{{ tag }}</text>
									</view>
								</view>
							</view>
							<image class="moment-cover" :src="item.coverImage" mode="aspectFill"></image>
						</view>
						<view class="text-action" @click="handlePrimary(item)">
							<text class="text-action-text">{{ item.primaryAction }} ›</text>
						</view>
					</view>

					<view v-else class="news-result">
						<image class="news-cover" :src="item.coverImage" mode="aspectFill"></image>
						<view class="news-main">
							<view class="type-row">
								<view class="type-pill news-type">
									<text class="type-text">{{ item.meta }}</text>
								</view>
								<text class="result-meta">{{ item.subtitle }}</text>
							</view>
							<text class="media-title">{{ item.title }}</text>
							<text class="result-description">{{ item.description }}</text>
							<view class="text-action" @click="handlePrimary(item)">
								<text class="text-action-text">{{ item.primaryAction }} ›</text>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import SegmentTabs from '../../components/segment-tabs.uvue'
	import { getSearchResults } from '../../services/service-container.uts'
	import type { SearchResultItem } from '../../types/models.uts'

	const tabs = ['全部', '服务者', '服务', '动态', '资讯']
	const filters = ['综合排序', '距离最近', '实名认证', '筛选']
	const activeTab = ref('全部')
	const activeFilter = ref('综合排序')
	const query = ref('')
	const results = ref<SearchResultItem[]>([])

	onLoad((options) => {
		const value = options['query'] as string
		if (value != null && value.length > 0) {
			query.value = decodeURIComponent(value)
		}
		refreshResults()
	})

	function onQueryInput(event: InputEvent) {
		query.value = event.detail.value
	}

	function refreshResults() {
		results.value = getSearchResults(query.value, activeTab.value)
	}

	function changeTab(tab: string) {
		activeTab.value = tab
		refreshResults()
	}

	function changeFilter(filter: string) {
		activeFilter.value = filter
		if (filter == '筛选') {
			uni.showToast({
				title: '更多筛选面板将在后续阶段接入',
				position: 'bottom',
				icon: 'none'
			})
		}
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/search/search'
				})
			}
		})
	}

	function openMessages() {
		uni.navigateTo({
			url: '/pages/messages/messages'
		})
	}

	function handlePrimary(item: SearchResultItem) {
		if (item.type == '服务者') {
			openProviderDetail(item.id.replace('search-provider-', 'provider-'))
			return
		}
		if (item.type == '服务') {
			openServiceDetail('service-billiards-001')
			return
		}
		if (item.type == '动态') {
			openMomentDetail('moment-001')
			return
		}
		uni.showToast({
			title: '资讯详情将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function handleSecondary(item: SearchResultItem) {
		if (item.type == '服务者') {
			openProviderDetail(item.id.replace('search-provider-', 'provider-'))
			return
		}
		uni.showToast({
			title: item.secondaryAction + '将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openProviderDetail(providerId: string) {
		uni.navigateTo({
			url: '/pages/provider/detail?providerId=' + encodeURIComponent(providerId)
		})
	}

	function openServiceDetail(serviceId: string) {
		uni.navigateTo({
			url: '/pages/service/detail?serviceId=' + encodeURIComponent(serviceId)
		})
	}

	function openMomentDetail(momentId: string) {
		uni.navigateTo({
			url: '/pages/moment/detail?momentId=' + encodeURIComponent(momentId)
		})
	}
</script>

