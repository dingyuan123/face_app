<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="search-header">
				<view class="back-button" @click="goBack">
					<image class="back-icon" src="/static/search/back.png" mode="aspectFit"></image>
				</view>
				<view class="search-box">
					<image class="search-icon" src="/static/search/search.png" mode="aspectFit"></image>
					<input
						class="search-input"
						:value="query"
						confirm-type="search"
						placeholder="搜一搜你想体验的陪伴"
						placeholder-class="search-placeholder"
						@input="onQueryInput"
						@confirm="submitSearch"
					/>
					<view class="voice-button" @click="startVoiceSearch">
						<image class="voice-icon" src="/static/search/microphone.png" mode="aspectFit"></image>
					</view>
				</view>
			</view>

			<view class="section history-section">
				<view class="section-head">
					<text class="section-title">搜索历史</text>
					<view v-if="historyKeywords.length > 0" class="clear-button" @click="clearHistory">
						<image class="clear-icon" src="/static/search/trash.png" mode="aspectFit"></image>
					</view>
				</view>

				<view v-if="historyKeywords.length > 0" class="keyword-wrap">
					<view
						v-for="(keyword, index) in historyKeywords"
						:key="keyword"
						class="keyword-pill"
						:class="index == 0 ? 'keyword-pill-light' : ''"
						@click="chooseKeyword(keyword)"
					>
						<text class="keyword-text" :class="index == 0 ? 'keyword-text-light' : ''">{{ keyword }}</text>
					</view>
				</view>

				<view v-else class="history-empty">
					<text class="history-empty-text">暂无搜索历史</text>
				</view>
			</view>

			<view class="hot-section">
				<view class="hot-title-row">
					<text class="hot-title">大家都在搜</text>
					<image class="sparkle-icon" src="/static/search/sparkle.png" mode="aspectFit"></image>
				</view>
				<view class="keyword-wrap hot-keywords">
					<view
						v-for="keyword in hotKeywords"
						:key="keyword"
						class="keyword-pill keyword-pill-hot"
						@click="chooseKeyword(keyword)"
					>
						<text class="keyword-text">{{ keyword }}</text>
					</view>
				</view>
			</view>

			<view class="discovery-card" @click="openDiscovery">
				<view class="discovery-title-row">
					<image class="location-icon" src="/static/search/location.png" mode="aspectFit"></image>
					<text class="discovery-title">发现泸州附近的陪伴</text>
				</view>
				<text class="discovery-desc">从兴趣出发，找个合拍的玩伴</text>
				<view class="safety-row">
					<image class="shield-icon" src="/static/search/shield.png" mode="aspectFit"></image>
					<text class="safety-text">实名认证 · 见面更安心</text>
				</view>
			</view>

			<view class="brand-footer">
				<image class="wordmark" src="/static/brand/facetof-wordmark.png" mode="aspectFit"></image>
				<text class="slogan">见面聊，安心见</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	const query = ref('')
	const historyKeywords = ref<string[]>([
		'台球助教',
		'咖啡陪伴',
		'桌游陪玩',
		'羽毛球搭子',
		'周末徒步',
		'看展搭子'
	])
	const hotKeywords = ['台球助教', '咖啡陪伴', '桌游陪玩', '城市漫步', '健身搭子']

	function onQueryInput(event: InputEvent) {
		query.value = event.detail.value
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/index/index'
				})
			}
		})
	}

	function chooseKeyword(keyword: string) {
		query.value = keyword
		submitSearch()
	}

	function submitSearch() {
		const value = query.value.trim()
		if (value.length == 0) {
			uni.showToast({
				title: '请输入搜索内容',
				position: 'bottom',
				icon: 'none'
			})
			return
		}
		uni.navigateTo({
			url: '/pages/search/results?query=' + encodeURIComponent(value)
		})
	}

	function clearHistory() {
		historyKeywords.value = []
		uni.showToast({
			title: '搜索历史已清空',
			position: 'bottom',
			icon: 'success'
		})
	}

	function startVoiceSearch() {
		uni.showToast({
			title: '语音搜索需完成平台能力接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openDiscovery() {
		uni.showToast({
			title: '附近陪伴入口将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}
</script>

