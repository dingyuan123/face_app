<template>
	<view class="page">
		<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">支付结果</text>
				<view class="nav-button" @click="openService">
					<text class="nav-icon">♧</text>
				</view>
			</view>

			<view class="result-area">
				<image class="result-icon" :src="isSuccess ? '/static/payment/check.png' : '/static/payment/close.png'" mode="aspectFit"></image>
				<text class="result-title" :class="isSuccess ? 'success-title' : 'failed-title'">{{ isSuccess ? '支付成功' : '支付失败' }}</text>
				<text class="result-desc">{{ isSuccess ? '订单已支付，请按预约时间到店' : '本次支付未成功，订单仍待支付' }}</text>
				<text class="result-subdesc">{{ isSuccess ? '期待与你安心见面' : '可前往订单详情重新支付' }}</text>
			</view>

			<view class="order-card">
				<view class="order-head">
					<image class="order-image" :src="order.providerAvatar" mode="aspectFill"></image>
					<view class="order-main">
						<text class="order-title">{{ order.serviceTitle }}</text>
						<text class="order-meta">{{ order.providerName }} · 泸州江阳区 · {{ order.duration }}</text>
						<text class="order-time">10月{{ order.dateValue }}日（周六）{{ order.timeRange }}</text>
					</view>
				</view>
				<view class="order-divider"></view>
				<view class="order-row">
					<text class="order-label">订单号</text>
					<text class="order-value">{{ order.orderId }}</text>
				</view>
				<view class="order-row">
					<text class="order-label">{{ isSuccess ? '实付金额' : '应付金额' }}</text>
					<view class="amount-wrap">
						<text class="amount-symbol">¥</text>
						<text class="amount-value">{{ order.totalAmount }}.00</text>
					</view>
				</view>
				<view class="order-row">
					<text class="order-label">{{ paymentMethod }} · 含平台服务费 ¥{{ order.platformFee }}.00</text>
					<text class="order-status" :class="isSuccess ? 'status-success' : 'status-failed'">{{ isSuccess ? '已支付' : '待支付' }}</text>
				</view>
			</view>

			<view class="trust-row">
				<text class="trust-icon">♢</text>
				<text class="trust-text">{{ isSuccess ? '平台担保交易 · 请勿私下转账' : '完成支付后，预约才会生效' }}</text>
			</view>

			<view class="bottom-space"></view>
		</view>
		</scroll-view>

		<view class="action-area">
			<view class="primary-action" @click="openOrderDetail">
				<text class="primary-action-text">查看订单详情</text>
			</view>
			<view class="secondary-action" @click="continueBrowse">
				<text class="secondary-action-text">继续浏览</text>
			</view>
			<text class="footer-brand">FaceTo · 见面聊，安心见</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { getOrderDraft } from '../../services/service-container.uts'
	import type { OrderDraft } from '../../types/models.uts'

	const order = ref<OrderDraft>(getOrderDraft('service-billiards-001'))
	const isSuccess = ref(true)
	const paymentMethod = ref('微信支付')

	onLoad((options) => {
		const orderId = options['orderId'] as string
		const status = options['status'] as string
		const method = options['method'] as string
		order.value = getOrderDraft('service-billiards-001')
		if (orderId != null && orderId.length > 0) {
			order.value.orderId = decodeURIComponent(orderId)
		}
		isSuccess.value = status != 'failed'
		if (method != null && method.length > 0) {
			paymentMethod.value = decodeURIComponent(method)
		}
	})

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/index/index'
				})
			}
		})
	}

	function openService() {
		uni.showToast({
			title: '客服能力将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openOrderDetail() {
		uni.navigateTo({
			url: '/pages/order/detail?orderId=' + encodeURIComponent(order.value.orderId)
		})
	}

	function continueBrowse() {
		uni.reLaunch({
			url: '/pages/index/index'
		})
	}
</script>

