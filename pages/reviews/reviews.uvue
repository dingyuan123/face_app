<template>
	<scroll-view class="page" direction="vertical" :show-scrollbar="false">
		<view class="page-content">
			<view class="nav-bar">
				<view class="nav-button" @click="goBack">
					<text class="nav-icon">‹</text>
				</view>
				<text class="nav-title">我的评价</text>
				<view class="nav-placeholder"></view>
			</view>

			<view class="tabs">
				<view class="tab-item" :class="activeTab == '我评价的' ? 'tab-active' : ''" @click="changeTab('我评价的')">
					<text class="tab-text" :class="activeTab == '我评价的' ? 'tab-text-active' : ''">我评价的</text>
					<view v-if="activeTab == '我评价的'" class="tab-indicator"></view>
				</view>
				<view class="tab-item" :class="activeTab == '我收到的' ? 'tab-active' : ''" @click="changeTab('我收到的')">
					<text class="tab-text" :class="activeTab == '我收到的' ? 'tab-text-active' : ''">我收到的</text>
					<view v-if="activeTab == '我收到的'" class="tab-indicator"></view>
				</view>
			</view>

			<view class="list-head">
				<text class="list-title">{{ activeTab == '我评价的' ? '我对服务者的评价' : '服务者对我的评价' }}</text>
				<text class="list-count">共 {{ reviews.length }} 条</text>
			</view>

			<view class="review-list">
				<view v-for="review in reviews" :key="review.id" class="review-card">
					<view class="review-head">
						<image class="review-avatar" :src="review.avatar" mode="aspectFill"></image>
						<view class="review-main">
							<view class="review-name-row">
								<text class="review-name">{{ review.reviewerName }}</text>
								<view class="role-pill">
									<text class="role-text">{{ review.roleLabel }}</text>
								</view>
							</view>
							<text class="review-meta">{{ review.serviceMeta }}</text>
						</view>
					</view>

					<view class="rating-row">
						<text class="rating-label">{{ activeTab == '我评价的' ? '我的评分' : '给我的评分' }}</text>
						<view class="star-list">
							<text v-for="star in 5" :key="star" class="star" :class="star <= review.rating ? 'star-active' : ''">★</text>
						</view>
						<text class="rating-value">{{ review.rating.toFixed(1) }}</text>
						<text class="review-date">{{ review.date }}</text>
					</view>

					<text class="review-content">{{ review.content }}</text>

					<view class="tag-row">
						<view v-for="tag in review.tags" :key="tag" class="tag-pill">
							<text class="tag-text">{{ tag }}</text>
						</view>
					</view>
				</view>
			</view>

			<text class="brand-footer">FaceTo · 见面聊，安心见</text>
			<view class="bottom-space"></view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getMyReviewItems, getReceivedReviewItems } from '../../services/service-container.uts'
	import type { ReviewListItem } from '../../types/models.uts'

	const activeTab = ref('我评价的')
	const reviews = ref<ReviewListItem[]>(getMyReviewItems())

	function changeTab(tab: string) {
		activeTab.value = tab
		reviews.value = tab == '我评价的' ? getMyReviewItems() : getReceivedReviewItems()
	}

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}
</script>

