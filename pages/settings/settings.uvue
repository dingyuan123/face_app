<script setup lang="uts">
	import { logout as logoutSession } from '../../state/session-state.uts'

	const orderNotice = ref(true)
	const interactionNotice = ref(false)
	const autoplay = ref(true)

	function goBack() {
		uni.navigateBack({
			delta: 1,
			fail: () => {
				uni.reLaunch({
					url: '/pages/profile/profile'
				})
			}
		})
	}

	function clearCache() {
		uni.showToast({
			title: '缓存已清理（开发 Mock）',
			position: 'bottom',
			icon: 'success'
		})
	}

	function chooseLanguage() {
		uni.showToast({
			title: '语言选择将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function openAbout(name: string) {
		uni.showToast({
			title: name + '将在后续阶段接入',
			position: 'bottom',
			icon: 'none'
		})
	}

	function logout() {
		logoutSession()
		uni.reLaunch({
			url: '/pages/login/login'
		})
	}
</script>

