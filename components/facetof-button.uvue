<template>
	<view
		class="facetof-button"
		:class="[toneClass, disabled ? 'is-disabled' : '']"
		@click="handlePress"
	>
		<text class="facetof-button-label">{{ label }}</text>
	</view>
</template>

<script setup lang="uts">
	const props = defineProps({
		label: {
			type: String,
			default: '按钮'
		},
		tone: {
			type: String,
			default: 'primary'
		},
		disabled: {
			type: Boolean,
			default: false
		}
	})

	const emit = defineEmits(['press'])

	const toneClass = computed(() : string => {
		return 'tone-' + props.tone
	})

	function handlePress() {
		if (props.disabled) {
			return
		}
		emit('press')
	}
</script>

<style>
	.facetof-button {
		height: 48px;
		border-radius: 12px;
		align-items: center;
		justify-content: center;
	}

	.facetof-button-label {
		font-size: 16px;
		font-weight: 600;
	}

	.tone-primary {
		background-color: #FD5A6B;
		color: #FFFFFF;
	}

	.tone-gradient {
		background-image: linear-gradient(to bottom right, #FD5A6B 0%, #FD955E 52%, #FCAE59 100%);
		color: #FFFFFF;
	}

	.tone-secondary {
		background-color: #FFF7F3;
		border: 1px solid #F5DED5;
		color: #1F1A17;
	}

	.tone-ghost {
		background-color: #FFFFFF;
		border: 1px solid #F5DED5;
		color: #FD5A6B;
	}

	.is-disabled {
		opacity: 0.45;
	}
</style>
