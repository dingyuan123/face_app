import { PendingIntent } from '../types/models.uts'
import {
  clearPendingIntent,
  sessionState,
  setPendingIntent
} from '../state/session-state.uts'

export const HOME_ROUTE = '/pages/index/index'
export const LOGIN_ROUTE = '/pages/login/login'
export const IDENTITY_ROUTE = '/pages/identity/identity'
export const PROVIDER_APPLY_ROUTE = '/pages/provider/apply'
export const SEARCH_ROUTE = '/pages/search/search'
export const SEARCH_RESULTS_ROUTE = '/pages/search/results'
export const MOMENTS_ROUTE = '/pages/moments/moments'
export const NEWS_ROUTE = '/pages/news/news'
export const MESSAGES_ROUTE = '/pages/messages/messages'
export const PROFILE_ROUTE = '/pages/profile/profile'
export const PROVIDER_DETAIL_ROUTE = '/pages/provider/detail'
export const SERVICE_DETAIL_ROUTE = '/pages/service/detail'
export const MOMENT_DETAIL_ROUTE = '/pages/moment/detail'
export const ORDER_CONFIRM_ROUTE = '/pages/order/confirm'
export const PAYMENT_RESULT_ROUTE = '/pages/payment/result'
export const ORDER_LIST_ROUTE = '/pages/order/list'
export const ORDER_DETAIL_ROUTE = '/pages/order/detail'
export const FAVORITES_ROUTE = '/pages/favorites/list'
export const FOLLOWING_ROUTE = '/pages/following/list'
export const SETTINGS_ROUTE = '/pages/settings/settings'
export const MY_MOMENTS_ROUTE = '/pages/moments/mine'
export const WALLET_ROUTE = '/pages/wallet/wallet'
export const COUPONS_ROUTE = '/pages/coupons/coupons'
export const MEMBERSHIP_ROUTE = '/pages/membership/membership'
export const ID_VERIFY_ROUTE = '/pages/verification/id-verify'
export const CHAT_DETAIL_ROUTE = '/pages/chat/detail'
export const NEWS_DETAIL_ROUTE = '/pages/news/detail'
export const REVIEW_ROUTE = '/pages/review/review'
export const PROFILE_EDIT_ROUTE = '/pages/profile/edit'
export const MY_REVIEWS_ROUTE = '/pages/reviews/reviews'
export const ABOUT_ROUTE = '/pages/about/about'
export const HELP_ROUTE = '/pages/help/help'
export const MOMENT_PUBLISH_ROUTE = '/pages/moment/publish'

export function saveIntent(action: string, route: string, payload: string) {
  const intent: PendingIntent = {
    action: action,
    route: route,
    payload: payload
  }
  setPendingIntent(intent)
}

export function openLogin(action: string, route: string, payload: string) {
  saveIntent(action, route, payload)
  uni.navigateTo({
    url: LOGIN_ROUTE + '?source=' + encodeURIComponent(route)
  })
}

export function openIdentity() {
  uni.navigateTo({
    url: IDENTITY_ROUTE
  })
}

export function openProviderApply() {
  uni.navigateTo({
    url: PROVIDER_APPLY_ROUTE
  })
}

export function finishAuthenticatedNavigation(resumeMessage: string) {
  if (sessionState.identity == 'unset') {
    uni.reLaunch({
      url: IDENTITY_ROUTE
    })
    return
  }

  const action = sessionState.pendingAction
  const route = sessionState.pendingRoute
  const payload = sessionState.pendingPayload
  clearPendingIntent()

  let url = HOME_ROUTE
  if (route == PROVIDER_APPLY_ROUTE) {
    url = PROVIDER_APPLY_ROUTE
  } else if (route.length > 0 && route != LOGIN_ROUTE && route != HOME_ROUTE) {
    url = route
  } else if (action.length > 0) {
    url = HOME_ROUTE + '?resumeAction=' + encodeURIComponent(action) + '&resumePayload=' + encodeURIComponent(payload)
  }
  uni.reLaunch({
    url: url,
    complete: () => {
      if (resumeMessage.length > 0) {
        uni.showToast({
          title: resumeMessage,
          position: 'bottom'
        })
      }
    }
  })
}

export function requireAccount(action: string, route: string, payload: string): boolean {
  if (sessionState.loggedIn) {
    return true
  }
  openLogin(action, route, payload)
  return false
}
