export function getNewsFeed(tab: string): Array<NewsArticle> {
  const all: Array<NewsArticle> = [
    {
      id: 'news-001',
      title: '泸州周末好去处：适合轻松见面的公共文化空间',
      summary: '整理适合朋友见面、轻运动和休闲交流的公共场所。',
      category: '同城',
      coverImage: '/static/content/city.png',
      readCount: 2380,
      publishedAt: '今天 10:20',
      isVideo: false
    },
    {
      id: 'news-002',
      title: '公共场所见面安全指南：第一次见面要注意什么',
      summary: '从行程告知、地点选择到费用确认，提前做好安心准备。',
      category: '安全',
      coverImage: '/static/content/bookstore.png',
      readCount: 4560,
      publishedAt: '昨天 18:30',
      isVideo: true
    },
    {
      id: 'news-003',
      title: '平台服务规范更新：让每一次陪伴都更真实可信',
      summary: '了解服务者资料审核、行为规范和用户反馈机制。',
      category: '公告',
      coverImage: '/static/content/boardgames.png',
      readCount: 1860,
      publishedAt: '10-21',
      isVideo: false
    },
    {
      id: 'news-004',
      title: '城市运动体验活动开放报名',
      summary: '台球、羽毛球和桌游主题活动，欢迎在公共场所参与。',
      category: '活动',
      coverImage: '/static/content/badminton.png',
      readCount: 980,
      publishedAt: '10-20',
      isVideo: false
    }
  ]

  if (tab == '同城') {
    return all.filter((article: NewsArticle) : boolean => article.category == '同城')
  }
  if (tab == '安全') {
    return all.filter((article: NewsArticle) : boolean => article.category == '安全')
  }
  if (tab == '活动') {
    return all.filter((article: NewsArticle) : boolean => article.category == '活动' || article.category == '公告')
  }
  return all
}
