import { ActionOutcome, ProviderManageServiceItem } from '../types/models.uts'

let services: Array<ProviderManageServiceItem> = [
  {
    id: 'provider-service-001',
    title: '台球助教 · 新手体验',
    coverImage: '/static/following/moment-billiards.png',
    price: '¥68/小时',
    duration: '60 分钟',
    status: '上架',
    soldCount: 128
  },
  {
    id: 'provider-service-002',
    title: '咖啡陪伴 · 轻松交流',
    coverImage: '/static/following/moment-coffee.png',
    price: '¥55/小时',
    duration: '60 分钟',
    status: '审核中',
    soldCount: 86
  },
  {
    id: 'provider-service-003',
    title: '桌游陪玩 · 欢乐组局',
    coverImage: '/static/following/moment-city.png',
    price: '¥45/小时',
    duration: '120 分钟',
    status: '下架',
    soldCount: 67
  }
]

export function getProviderManageServices(): Array<ProviderManageServiceItem> {
  return services.slice()
}

export function getProviderManageService(id: string): ProviderManageServiceItem {
  for (let i = 0; i < services.length; i++) {
    if (services[i].id == id) {
      return services[i]
    }
  }
  return services[0]
}

export function toggleProviderService(id: string): ActionOutcome {
  const next: Array<ProviderManageServiceItem> = []
  for (let i = 0; i < services.length; i++) {
    const item = services[i]
    if (item.id == id) {
      const status = item.status == '上架' ? '下架' : '上架'
      next.push({
        id: item.id,
        title: item.title,
        coverImage: item.coverImage,
        price: item.price,
        duration: item.duration,
        status: status,
        soldCount: item.soldCount
      })
    } else {
      next.push(item)
    }
  }
  services = next
  return {
    ok: true,
    code: 'SERVICE_STATUS_CHANGED',
    message: '服务状态已更新（开发 Mock）'
  }
}
