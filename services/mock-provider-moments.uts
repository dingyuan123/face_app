export function getProviderMomentItems(): Array<ProviderMomentManageItem> {
  return items.slice()
}

export function removeProviderMoment(id: string): ActionOutcome {
  const next: Array<ProviderMomentManageItem> = []
  for (let i = 0; i < items.length; i++) {
    if (items[i].id != id) {
      next.push(items[i])
    }
  }
  items = next
  return {
    ok: true,
    code: 'MOMENT_REMOVED',
    message: '动态已删除（开发 Mock）'
  }
}
