import { ActionOutcome, ProviderMomentManageItem } from '../types/models.uts'

let items: Array<ProviderMomentManageItem> = [
  {
    id: 'provider-moment-001',
    title: '在泸州，练好第一杆',
    coverImage: '/static/following/moment-billiards.png',
    publishedAt: '今天 12:10',
    viewCount: 128,
