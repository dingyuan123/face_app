function cloneItem(item: ProviderMomentManageItem): ProviderMomentManageItem {
  return {
    id: item.id,
    title: item.title,
    content: item.content,
    coverImage: item.coverImage,
    mediaUrls: item.mediaUrls.slice(),
    mediaIds: item.mediaIds.slice(),
    publishedAt: item.publishedAt,
    updatedAt: item.updatedAt,
    viewCount: item.viewCount,
    likeCount: item.likeCount,
    commentCount: item.commentCount,
    shareCount: item.shareCount,
    status: item.status,
    statusCode: item.statusCode,
    rejectReason: item.rejectReason,
    version: item.version,
    visibility: item.visibility,
    allowRecommend: item.allowRecommend,
    attachedServiceId: item.attachedServiceId,
    attachedServiceTitle: item.attachedServiceTitle
  }
}

function findIndex(id: string): number {
  for (let i = 0; i < items.length; i++) {
    if (items[i].id == id) {
      return i
    }
  }
  return -1
}

function titleFromContent(content: string): string {
  let firstLine = ''
  for (let i = 0; i < content.length; i++) {
    if (content[i] == '\n') {
      break
    }
    firstLine += content[i]
  }
  const text = firstLine.trim().length > 0 ? firstLine.trim() : content.trim()
  return text.length > 30 ? text.substring(0, 30) + '…' : text
}

export function listProviderMomentItems(status: string, page: number, pageSize: number): ProviderMomentListResult {
  const result: Array<ProviderMomentManageItem> = []
  for (let i = 0; i < items.length; i++) {
    if (status.length == 0 || items[i].statusCode == status) {
      result.push(cloneItem(items[i]))
    }
  }
  return {
    ok: true,
    code: 'MOMENT_LIST_LOADED',
    message: '动态列表已加载（开发 Mock）',
    items: result,
    total: result.length
  }
}

export function getProviderMomentItem(id: string): ProviderMomentResult {
  const index = findIndex(id)
  if (index < 0) {
    return { ok: false, code: 'MOMENT_LOAD_FAILED', message: '动态不存在（开发 Mock）', moment: null }
  }
  return { ok: true, code: 'MOMENT_LOADED', message: '动态已加载（开发 Mock）', moment: cloneItem(items[index]) }
}

export function saveProviderMoment(draft: ProviderMomentDraftInput, publishAfter: boolean): ProviderMomentResult {
  if (draft.content.trim().length == 0 && draft.mediaPaths.length == 0) {
    return { ok: false, code: 'MOMENT_CONTENT_REQUIRED', message: '请先添加图片或文字', moment: null }
  }
  const status = publishAfter ? 'PUBLISHED' : 'DRAFT'
  const statusText = publishAfter ? '已发布' : '草稿'
  const index = findIndex(draft.id)
  const next: ProviderMomentManageItem = {
    id: index >= 0 ? items[index].id : 'provider-moment-' + Date.now().toString(),
    title: titleFromContent(draft.content),
    content: draft.content,
    coverImage: draft.mediaPaths.length > 0 ? draft.mediaPaths[0] : '',
    mediaUrls: draft.mediaPaths.slice(),
    mediaIds: draft.mediaPaths.slice(),
    publishedAt: publishAfter ? '刚刚' : '',
    updatedAt: '刚刚',
    viewCount: index >= 0 ? items[index].viewCount : 0,
    likeCount: index >= 0 ? items[index].likeCount : 0,
    commentCount: index >= 0 ? items[index].commentCount : 0,
    shareCount: index >= 0 ? items[index].shareCount : 0,
    status: statusText,
    statusCode: status,
    rejectReason: '',
    version: index >= 0 ? items[index].version + 1 : 1,
    visibility: 'PUBLIC',
    allowRecommend: draft.allowRecommend,
    attachedServiceId: draft.attachedServiceId,
    attachedServiceTitle: ''
  }
  if (index >= 0) {
    items[index] = next
  } else {
    // 用显式数组拼接，保持 UTS 跨平台兼容。
    const merged: Array<ProviderMomentManageItem> = [next]
    for (let i = 0; i < items.length; i++) {
      merged.push(items[i])
    }
    items = merged
  }
  return {
    ok: true,
    code: publishAfter ? 'MOMENT_PUBLISHED' : 'MOMENT_SAVED',
    message: publishAfter ? '动态已发布（开发 Mock）' : '动态已保存为草稿（开发 Mock）',
    moment: cloneItem(next)
  }
}

export function publishProviderMoment(id: string, expectedVersion: number): ProviderMomentResult {
  const index = findIndex(id)
  if (index < 0) {
    return { ok: false, code: 'MOMENT_PUBLISH_FAILED', message: '动态不存在（开发 Mock）', moment: null }
  }
  const current = items[index]
  const next = cloneItem(current)
  next.statusCode = 'PUBLISHED'
  next.status = '已发布'
  next.publishedAt = '刚刚'
  next.version = current.version + 1
  items[index] = next
  return { ok: true, code: 'MOMENT_PUBLISHED', message: '动态已发布（开发 Mock）', moment: cloneItem(next) }
}

export function removeProviderMoment(id: string): ActionOutcome {
  const next: Array<ProviderMomentManageItem> = []
  for (let i = 0; i < items.length; i++) {
    if (items[i].id != id) {
      next.push(items[i])
    }
  }
  items = next
  return {
    ok: true,
    code: 'MOMENT_DELETED',
    message: '动态已删除（开发 Mock）'
  }
}

