import {
  LegalDocument,
  LegalDocumentSection
} from '../types/models.uts'

function userAgreementSections(): Array<LegalDocumentSection> {
  return [
    {
      title: '一、协议范围',
      paragraphs: [
        '本模板用于说明见面聊平台与用户之间关于账号使用、服务浏览、预约沟通和平台规则的基本约定。',
        '正式发布前，本页面内容将由项目方整理的用户协议全文替换。'
      ]
    },
    {
      title: '二、账号与身份',
      paragraphs: [
        '用户应使用真实、准确、合法的信息注册和使用账号，并妥善保管账号凭证。',
        '身份选择、登录状态、服务者申请状态和实际服务权限分别管理。'
      ]
    },
    {
      title: '三、平台服务内容',
      paragraphs: [
        '见面聊为用户提供服务者展示、信息沟通、预约组织和相关平台功能。具体服务内容以页面实际展示和后续正式规则为准。'
      ]
    },
    {
      title: '四、用户行为规范',
      paragraphs: [
        '用户不得发布虚假、违法、侵权或危害他人安全的内容，不得利用平台实施欺诈、骚扰或其他违规行为。',
        '线下见面应优先选择正规公共场所，并遵守法律法规和平台安全提示。'
      ]
    },
    {
      title: '五、预约与交易',
      paragraphs: [
        '预约、取消、改期、退款和服务完成等交易规则将在正式协议中进一步明确。',
        '当前项目中的支付、订单和提现功能仍处于开发 Mock 阶段，不构成真实交易。'
      ]
    },
    {
      title: '六、知识产权',
      paragraphs: [
        '平台软件、品牌标识、页面设计和相关内容的知识产权归权利人所有。用户发布内容的权属和授权范围以正式协议为准。'
      ]
    },
    {
      title: '七、责任与限制',
      paragraphs: [
        '本模板不构成正式法律条款。正式协议将根据业务模式、平台责任和适用法律进一步完善。'
      ]
    },
    {
      title: '八、协议变更与联系',
      paragraphs: [
        '协议更新后将通过平台页面或其他合理方式向用户展示。',
        '如对协议内容有疑问，可通过“关于我们—联系方式”或客服帮助页面联系平台。'
      ]
    }
  ]
}

function privacyPolicySections(): Array<LegalDocumentSection> {
  return [
    {
      title: '一、政策说明',
      paragraphs: [
        '本模板用于说明见面聊平台在提供服务过程中可能处理个人信息的目的、方式和用户权利。',
        '正式发布前，本页面内容将由项目方整理的隐私政策全文替换。'
      ]
    },
    {
      title: '二、收集的信息',
      paragraphs: [
        '根据功能需要，平台可能处理账号信息、身份认证信息、联系方式、服务者申请资料、预约与订单信息、消息内容以及设备和日志信息。',
        '身份证、头像、生活照等敏感个人信息仅应在明确、必要且具备合法处理依据的情况下收集。'
      ]
    },
    {
      title: '三、使用目的',
      paragraphs: [
        '个人信息将用于账号登录、身份核验、服务展示、预约沟通、交易管理、安全风控、客户服务和法律法规要求的其他用途。'
      ]
    },
    {
      title: '四、权限与设备信息',
      paragraphs: [
        '相机、相册、麦克风、位置等系统权限只会在对应功能需要时申请，并应向用户说明用途。',
        '不同平台的权限申请方式和可用能力需分别验证。'
      ]
    },
    {
      title: '五、信息共享与提供',
      paragraphs: [
        '平台不会在未取得合法依据的情况下向第三方出售个人信息。确需共享或委托处理时，应明确接收方、目的、范围和保护措施。'
      ]
    },
    {
      title: '六、存储与安全',
      paragraphs: [
        '平台应采取访问控制、加密、脱敏、日志审计和最小权限等措施保护个人信息，并根据业务和法律要求确定保存期限。'
      ]
    },
    {
      title: '七、用户权利',
      paragraphs: [
        '用户可依法申请访问、更正、删除个人信息，撤回授权或注销账号。具体操作入口和处理流程将在正式政策中进一步明确。'
      ]
    },
    {
      title: '八、未成年人保护',
      paragraphs: [
        '平台应按照适用法律保护未成年人信息。涉及未成年人使用的功能和服务规则需进一步完善。'
      ]
    },
    {
      title: '九、更新与联系',
      paragraphs: [
        '隐私政策发生重要变化时，平台应以显著方式提示用户。',
        '如对个人信息处理有疑问，可通过“关于我们—联系方式”或客服帮助页面联系平台。'
      ]
    }
  ]
}

export function getLegalDocument(type: string): LegalDocument {
  if (type == 'privacy-policy') {
    return {
      type: 'privacy-policy',
      title: '隐私政策',
      updatedAt: '更新时间：待定',
      summary: '本页面为隐私政策内容模板，正式文案整理完成后将整体替换。',
      sections: privacyPolicySections()
    }
  }
  return {
    type: 'user-agreement',
    title: '用户协议',
    updatedAt: '更新时间：待定',
    summary: '本页面为用户协议内容模板，正式文案整理完成后将整体替换。',
    sections: userAgreementSections()
  }
}
