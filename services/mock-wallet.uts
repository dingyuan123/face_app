export function getWalletTransactions(tab: string): Array<WalletTransaction> {
  const all = getWalletSummary().transactions
  if (tab == '全部') {
    return all
  }
  if (tab == '收入') {
    return all.filter((item: WalletTransaction) : boolean => item.type == '收入' || item.type == '充值')
  }
  if (tab == '支出') {
    return all.filter((item: WalletTransaction) : boolean => item.type == '支出')
  }
  return all.filter((item: WalletTransaction) : boolean => item.type == '提现' || item.type == '充值')
}
