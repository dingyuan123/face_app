}

export function requestAppleLogin(): ActionOutcome {
  return mockAuth.requestAppleLogin()
}

export function loginWithTestAccount(kind: string): ActionOutcome {
  return mockAuth.loginWithTestAccount(kind)
}

export function getHomeFeed(): Array<HomeFeedItem> {
