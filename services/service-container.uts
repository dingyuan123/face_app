  return mockAuth.loginWithTestAccount(kind)
}

// 真实账号走后端身份接口，开发测试账号继续使用本地 Mock 流程。
export function selectInitialRole(role: string): Promise<InitialRoleResult> {
  if (sessionState.userId.startsWith('test-') || sessionState.userId.startsWith('mock-')) {
    return new Promise<InitialRoleResult>((resolve) => {
      setInitialRoleState(role, role == 'provider' ? 'PROVIDER' : 'USER', role == 'provider' ? 'provider' : 'user', sessionState.applicationStatus, false)
      resolve({
        ok: true,
        code: 'TEST_INITIAL_ROLE_SELECTED',
        message: '测试身份已选择',
        primaryRole: role == 'provider' ? 'PROVIDER' : 'USER',
        defaultWorkspace: role == 'provider' ? 'provider' : 'user',
        nextRoute: '',
        requiresIdentitySelection: false,
        providerStatus: sessionState.applicationStatus
      })
    })
  }
  return providerApi.selectInitialRole(role)
}

export function getProviderApplication(): Promise<ProviderApplicationLoadResult> {
  if (sessionState.userId.startsWith('test-') || sessionState.userId.startsWith('mock-')) {
    return new Promise<ProviderApplicationLoadResult>((resolve) => {
      resolve({
        ok: true,
        code: 'TEST_APPLICATION_LOADED',
        message: '测试申请状态已加载',
        record: mockProvider.getLatestApplication()
      })
    })
  }
  return providerApi.getProviderApplication()
}

export function submitProviderApplicationApi(draft: ProviderApplicationDraft): Promise<ProviderSubmitResult> {
  if (sessionState.userId.startsWith('test-') || sessionState.userId.startsWith('mock-')) {
    return new Promise<ProviderSubmitResult>((resolve) => {
      resolve(mockProvider.submitProviderApplication(draft))
    })
  }
  return providerApi.submitProviderApplicationApi(draft)
}

export function updateProviderApplicationApi(
  draft: ProviderApplicationDraft,
  previous: ProviderApplicationRecord,
  expectedVersion: number
): Promise<ProviderSubmitResult> {
  if (sessionState.userId.startsWith('test-') || sessionState.userId.startsWith('mock-')) {
    return new Promise<ProviderSubmitResult>((resolve) => {
      resolve(mockProvider.submitProviderApplication(draft))
    })
  }
  return providerApi.updateProviderApplicationApi(draft, previous, expectedVersion)
}

