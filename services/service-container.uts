export function performAccountAction(action: string, targetId: string): ActionOutcome {
  if (action == 'favorite') {
    return { ok: true, code: 'MOCK_FAVORITE_ADDED', message: '已收藏（开发 Mock）' }
  }
  if (action == 'chat') {
    return { ok: true, code: 'MOCK_CHAT_READY', message: '已进入会话准备状态（开发 Mock）' }
  }
  if (action == 'booking') {
    return { ok: true, code: 'MOCK_BOOKING_READY', message: '已进入预约准备状态（开发 Mock）' }
  }
  return { ok: false, code: 'UNKNOWN_ACTION', message: '暂不支持该操作' }
}
