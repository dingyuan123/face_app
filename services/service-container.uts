}

export function getProfileSummary(): ProfileSummary | null {
  return mockProfile.getProfileSummary()
}

export function getSearchResults(query: string, tab: string): Array<SearchResultItem> {
  return mockSearch.getSearchResults(query, tab)
}

export function getProviderDetail(providerId: string): ProviderDetail {
