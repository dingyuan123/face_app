// 退出登录接口与本地状态清理保持原子化；开发测试账号只清理本地 Mock 状态。
export function logoutFromApi(): Promise<ActionOutcome> {
  if (sessionState.userId.startsWith('test-') || sessionState.userId.startsWith('mock-')) {
    clearSessionState()
    return new Promise<ActionOutcome>((resolve) => {
      resolve({
        ok: true,
        code: 'TEST_LOGOUT_SUCCESS',
        message: '已退出登录，身份和申请状态已清理'
      })
    })
  }
  return authApi.logout()
}

export function requestWechatLogin(): ActionOutcome {
  return mockAuth.requestWechatLogin()
}

