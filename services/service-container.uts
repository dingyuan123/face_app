/**
 * 页面只依赖本文件中的业务服务。
 * 后续接入真实 API 时，只替换这里的实现，不让页面直接导入 Mock。
 */
export function sendSmsCode(phone: string): ActionOutcome {
  return mockAuth.sendSmsCode(phone)
}

export function loginWithPhone(phone: string, code: string): ActionOutcome {
  return mockAuth.loginWithPhone(phone, code)
}

