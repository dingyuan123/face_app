export function getServiceDetail(id: string): ServiceDetail {
  let service = serviceBilliards()
  if (id == 'service-coffee-001') {
    service = serviceCoffee()
  } else if (id == 'service-boardgames-001') {
    service = serviceBoardGames()
  }
  return {
    id: service.id,
    providerId: 'provider-001',
    providerName: '明仔教练',
    providerAvatar: '/static/avatars/linxiao.png',
    title: service.title,
    subtitle: service.description,
    coverImage: service.coverImage,
    galleryImages: [service.coverImage, '/static/content/city.png', '/static/content/badminton.png'],
    tag: service.tag,
    duration: service.duration,
    format: service.format,
    price: service.price.replace('/小时', ''),
    priceUnit: '/小时',
    contentLines: service.contentLines,
    locationType: service.locationType,
    locationText: service.locationText,
    rating: service.rating,
    reviewCount: service.reviewCount,
    reviews: service.reviews
  }
}

