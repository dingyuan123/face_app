export function getOrderDetail(orderId: string): OrderDetail {
  let status = '待接单'
  let statusDescription = '已提交预约，等待服务者确认'
  if (orderId == 'order-001') {
    status = '待支付'
    statusDescription = '订单尚未支付，完成支付后预约才会生效'
  } else if (orderId == 'order-003') {
    status = '已完成'
    statusDescription = '本次服务已完成，感谢你的信任'
  } else if (orderId == 'order-004') {
    status = '进行中'
    statusDescription = '服务进行中，请按预约安排见面'
  } else if (orderId == 'order-005') {
    status = '待履约'
    statusDescription = '服务者已接单，等待按预约时间履约'
  }

  return {
    id: orderId,
    status: status,
    statusDescription: statusDescription,
    serviceTitle: '台球助教 · 新手体验',
    serviceLocation: '泸州 · 江阳区',
    serviceDuration: '服务时长 60 分钟',
    servicePrice: '¥68',
    appointmentDate: '10月18日 周日 · 15:30',
    appointmentTime: '预计服务时长 60 分钟',
    locationName: '万达广场 · 星轶影城旁',
    locationAddress: '泸州市江阳区康城路一段',
    providerName: '阿哲',
    providerAvatar: '/static/avatars/achuan.png',
    providerRating: '评分 4.9 · 已完成 126 单',
    providerCompleted: '已认证',
    customerName: '林先生',
    customerPhone: '138****2048',
    platformFee: '¥3.00',
    totalAmount: '¥71.00',
    timeline: [
      {
        title: '订单已提交',
        description: '预约信息已发送',
        time: '10月16日 09:20',
        state: 'done'
      },
      {
        title: '等待服务者接单',
        description: '确认后将通知你',
        time: '',
        state: 'current'
      },
      {
        title: '服务开始 / 完成',
        description: '到店后按流程确认',
        time: '',
        state: 'future'
      }
    ]
  }
}
