import {
  ProviderAnalyticsSummary,
  ProviderAnalyticsMetric,
  ProviderFunnelItem,
  ProviderTrendPoint
} from '../types/models.uts'

function metrics(): Array<ProviderAnalyticsMetric> {
  return [
    { label: '浏览量', value: '12,860', delta: '+12.6%' },
    { label: '访客数', value: '4,286', delta: '+8.4%' },
    { label: '订单量', value: '186', delta: '+16.2%' },
    { label: '转化率', value: '4.3%', delta: '+0.6%' },
    { label: '收入', value: '¥12,860', delta: '+18.9%' }
  ]
}

function trend(): Array<ProviderTrendPoint> {
  return [
    { label: '周一', value: '¥1,260', level: 3 },
    { label: '周二', value: '¥1,580', level: 4 },
    { label: '周三', value: '¥1,120', level: 2 },
    { label: '周四', value: '¥1,860', level: 5 },
    { label: '周五', value: '¥1,720', level: 4 },
    { label: '周六', value: '¥2,380', level: 6 },
    { label: '周日', value: '¥2,940', level: 7 }
  ]
}

function funnel(): Array<ProviderFunnelItem> {
  return [
    { label: '看到主页', value: '12,860', ratio: 100 },
    { label: '查看服务', value: '6,420', ratio: 82 },
    { label: '发起预约', value: '826', ratio: 58 },
    { label: '完成支付', value: '642', ratio: 44 },
    { label: '完成订单', value: '538', ratio: 36 }
  ]
}

export function getProviderAnalytics(): ProviderAnalyticsSummary {
  return {
    metrics: metrics(),
    trend: trend(),
    funnel: funnel()
  }
}
