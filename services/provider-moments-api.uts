import {
  ActionOutcome,
  MomentMediaUploadResult,
  MomentMountableServiceItem,
  MomentMountableServiceListResult,
  ProviderMomentDraftInput,
  ProviderMomentListResult,
  ProviderMomentManageItem,
  ProviderMomentResult
} from '../types/models.uts'
import {
  businessCode,
  businessMessage,
  numberValue,
  payload,
  requestDelete,
  requestGet,
  requestPatch,
  requestPost,
  requestUpload,
  stringValue,
  HttpResult
} from './api-client.uts'
import { getAccessToken } from '../state/session-state.uts'
import { API_CONFIG } from './api-config.uts'

// 服务者动态管理接口：列表、详情、创建、修改、发布、删除和可挂载服务。
// 图片先通过 /media/uploads/（purpose=MOMENT_IMAGE）上传取得 media_id，再提交动态。

type MomentMediaIdsResult = {
  ok: boolean,
  message: string,
  mediaIds: string[]
}

function apiGet(path: string): Promise<HttpResult> {
  return requestGet(path, getAccessToken())
}

function apiPost(path: string, data: any, idempotencyKey: string): Promise<HttpResult> {
  return requestPost(path, data, idempotencyKey, getAccessToken())
}

function apiPatch(path: string, data: any, idempotencyKey: string): Promise<HttpResult> {
  return requestPatch(path, data, idempotencyKey, getAccessToken())
}

function apiDelete(path: string): Promise<HttpResult> {
  return requestDelete(path, getAccessToken())
}

function apiUpload(path: string, filePath: string, formData: any, idempotencyKey: string): Promise<HttpResult> {
  return requestUpload(path, filePath, 'file', formData, idempotencyKey, getAccessToken())
}

function absoluteUrl(url: string): string {
  if (url.length == 0) {
    return ''
  }
  if (url.startsWith('http://') || url.startsWith('https://')) {
    return url
  }
  return API_CONFIG.origin + url
}

// 媒体优先使用短期签名 display_url，缺失时回退 content_url。
function mediaUrl(media: any): string {
  if (media == null) {
    return ''
  }
  const display = stringValue(media, 'display_url')
  const value = display.length > 0 ? display : stringValue(media, 'content_url')
  return absoluteUrl(value)
}

function mediaId(media: any): string {
  return media == null ? '' : stringValue(media, 'media_id')
}

// 接口状态码转中文展示文案。
function statusLabel(status: string): string {
  if (status == 'DRAFT') {
    return '草稿'
  }
  if (status == 'PENDING') {
    return '审核中'
  }
  if (status == 'PUBLISHED') {
    return '已发布'
  }
  if (status == 'REJECTED') {
    return '已拒绝'
  }
  return status
}

function momentTitle(content: string): string {
  let firstLine = ''
  for (let i = 0; i < content.length; i++) {
    const ch = content[i]
    if (ch == '\n') {
      break
    }
    firstLine += ch
  }
  const text = firstLine.trim().length > 0 ? firstLine.trim() : content.trim()
  if (text.length > 30) {
    return text.substring(0, 30) + '…'
  }
  return text
}

function mapMoment(data: any): ProviderMomentManageItem {
  const media = data['media']
  const mediaUrls: string[] = []
  const mediaIds: string[] = []
  if (media != null) {
    for (let i = 0; i < media.length; i++) {
      const url = mediaUrl(media[i])
      if (url.length > 0) {
        mediaUrls.push(url)
        mediaIds.push(mediaId(media[i]))
      }
    }
  }
  const cover = data['cover_media']
  let coverImage = mediaUrl(cover)
  if (coverImage.length == 0 && mediaUrls.length > 0) {
    coverImage = mediaUrls[0]
  }
  const attached = data['attached_service']
  const content = stringValue(data, 'content')
  return {
    id: stringValue(data, 'id'),
    title: momentTitle(content),
    content: content,
    coverImage: coverImage,
    mediaUrls: mediaUrls,
    mediaIds: mediaIds,
    publishedAt: stringValue(data, 'published_at'),
    updatedAt: stringValue(data, 'updated_at'),
    viewCount: numberValue(data, 'view_count'),
    likeCount: numberValue(data, 'like_count'),
    commentCount: numberValue(data, 'comment_count'),
    shareCount: numberValue(data, 'share_count'),
    status: statusLabel(stringValue(data, 'status')),
    statusCode: stringValue(data, 'status'),
    rejectReason: stringValue(data, 'reject_reason'),
    version: numberValue(data, 'version'),
    visibility: stringValue(data, 'visibility'),
    allowRecommend: data['allow_recommend'] == true,
    attachedServiceId: stringValue(attached, 'id'),
    attachedServiceTitle: stringValue(attached, 'title')
  }
}

// 上传单张动态图片，返回媒体 ID 与可直接显示的地址。
export function uploadMomentMedia(filePath: string): Promise<MomentMediaUploadResult> {
  return apiUpload('/media/uploads/', filePath, {
    purpose: 'MOMENT_IMAGE'
  }, 'faceto-moment-media-' + Date.now().toString()).then((result: HttpResult) => {
    if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
      return {
        ok: false,
        code: 'MOMENT_MEDIA_UPLOAD_FAILED',
        message: businessMessage(result),
        mediaId: '',
        displayUrl: ''
      }
    }
    const data = payload(result.body)
    return {
      ok: true,
      code: 'MOMENT_MEDIA_UPLOADED',
      message: '图片已上传',
      mediaId: stringValue(data, 'media_id'),
      displayUrl: mediaUrl(data)
    }
  })
}

// 依次上传未上传的图片；已有的 http(s) 地址直接复用原 media_id。
function uploadMomentMediaIds(
  paths: string[],
  mediaIds: string[],
  index: number,
  collected: string[]
): Promise<MomentMediaIdsResult> {
  if (index >= paths.length) {
    return new Promise<MomentMediaIdsResult>((resolve) => {
      resolve({ ok: true, message: '', mediaIds: collected })
    })
  }
  const path = paths[index]
  const previousId = index < mediaIds.length ? mediaIds[index] : ''
  if (path.startsWith('http://') || path.startsWith('https://')) {
    if (previousId.length == 0) {
      return new Promise<MomentMediaIdsResult>((resolve) => {
        resolve({ ok: false, message: '动态图片信息已失效，请重新添加', mediaIds: [] })
      })
    }
    const next: string[] = []
    for (let i = 0; i < collected.length; i++) {
      next.push(collected[i])
    }
    next.push(previousId)
    return uploadMomentMediaIds(paths, mediaIds, index + 1, next)
  }
  return uploadMomentMedia(path).then((media: MomentMediaUploadResult) => {
    if (!media.ok) {
      return { ok: false, message: media.message, mediaIds: [] }
    }
    const next: string[] = []
    for (let i = 0; i < collected.length; i++) {
      next.push(collected[i])
    }
    next.push(media.mediaId)
    return uploadMomentMediaIds(paths, mediaIds, index + 1, next)
  })
}

// 创建或修改动态；成功后按 publishAfter 决定是否立即发布。
export function saveProviderMoment(draft: ProviderMomentDraftInput, publishAfter: boolean): Promise<ProviderMomentResult> {
  return uploadMomentMediaIds(draft.mediaPaths, draft.mediaIds, 0, []).then((uploaded: MomentMediaIdsResult) => {
    if (!uploaded.ok) {
      return {
        ok: false,
        code: 'MOMENT_MEDIA_UPLOAD_FAILED',
        message: uploaded.message,
        moment: null
      }
    }
    const body: any = {
      type: 'IMAGE_TEXT',
      content: draft.content,
      media_ids: uploaded.mediaIds,
      cover_media_id: uploaded.mediaIds.length > 0 ? uploaded.mediaIds[0] : null,
      visibility: draft.visibility.length > 0 ? draft.visibility : 'PUBLIC',
      allow_recommend: draft.allowRecommend,
      attached_service_id: draft.attachedServiceId.length > 0 ? draft.attachedServiceId : null,
      tag_codes: []
    }
    if (draft.id.length == 0) {
      return apiPost('/provider-moments/', body, 'faceto-moment-create-' + Date.now().toString()).then((result: HttpResult) => {
        if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
          return {
            ok: false,
            code: 'MOMENT_CREATE_FAILED',
            message: businessMessage(result),
            moment: null
          }
        }
        const created = mapMoment(payload(result.body))
        if (!publishAfter) {
          return {
            ok: true,
            code: 'MOMENT_CREATED',
            message: '动态已保存为草稿',
            moment: created
          }
        }
        return publishProviderMoment(created.id, created.version)
      })
    }
    body['expected_version'] = draft.expectedVersion
    return apiPatch('/provider-moments/' + encodeURIComponent(draft.id) + '/', body, 'faceto-moment-update-' + Date.now().toString()).then((result: HttpResult) => {
      if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
        return {
          ok: false,
          code: 'MOMENT_UPDATE_FAILED',
          message: businessMessage(result),
          moment: null
        }
      }
      const updated = mapMoment(payload(result.body))
      if (!publishAfter) {
        return {
          ok: true,
          code: 'MOMENT_UPDATED',
          message: '动态已保存',
          moment: updated
        }
      }
      return publishProviderMoment(updated.id, updated.version)
    })
  })
}

// 发布动态；携带版本号防止并发覆盖。
export function publishProviderMoment(id: string, expectedVersion: number): Promise<ProviderMomentResult> {
  return apiPost('/provider-moments/' + encodeURIComponent(id) + '/publish/', {
    expected_version: expectedVersion
  }, 'faceto-moment-publish-' + Date.now().toString()).then((result: HttpResult) => {
    if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
      return {
        ok: false,
        code: 'MOMENT_PUBLISH_FAILED',
        message: businessMessage(result),
        moment: null
      }
    }
    return {
      ok: true,
      code: 'MOMENT_PUBLISHED',
      message: '动态已发布',
      moment: mapMoment(payload(result.body))
    }
  })
}

export function deleteProviderMoment(id: string): Promise<ActionOutcome> {
  return apiDelete('/provider-moments/' + encodeURIComponent(id) + '/').then((result: HttpResult) => {
    if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
      return {
        ok: false,
        code: 'MOMENT_DELETE_FAILED',
        message: businessMessage(result)
      }
    }
    return {
      ok: true,
      code: 'MOMENT_DELETED',
      message: '动态已删除'
    }
  })
}

export function getProviderMomentItem(id: string): Promise<ProviderMomentResult> {
  return apiGet('/provider-moments/' + encodeURIComponent(id) + '/').then((result: HttpResult) => {
    if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
      return {
        ok: false,
        code: 'MOMENT_LOAD_FAILED',
        message: businessMessage(result),
        moment: null
      }
    }
    return {
      ok: true,
      code: 'MOMENT_LOADED',
      message: '动态已加载',
      moment: mapMoment(payload(result.body))
    }
  })
}

// 动态管理列表，支持状态筛选和分页。
export function listProviderMoments(status: string, page: number, pageSize: number): Promise<ProviderMomentListResult> {
  let path = '/provider-moments/?page=' + page.toString() + '&page_size=' + pageSize.toString()
  if (status.length > 0) {
    path += '&status=' + encodeURIComponent(status)
  }
  return apiGet(path).then((result: HttpResult) => {
    if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
      return {
        ok: false,
        code: 'MOMENT_LIST_FAILED',
        message: businessMessage(result),
        items: [],
        total: 0
      }
    }
    const data = payload(result.body)
    // 兼容 { items: [...] } 与直接返回数组两种结构。
    let source = data['items']
    if (source == null) {
      source = data
    }
    const items: ProviderMomentManageItem[] = []
    if (source != null) {
      for (let i = 0; i < source.length; i++) {
        items.push(mapMoment(source[i]))
      }
    }
    return {
      ok: true,
      code: 'MOMENT_LIST_LOADED',
      message: '动态列表已加载',
      items: items,
      total: numberValue(data, 'total')
    }
  })
}

function mapMountable(item: any): MomentMountableServiceItem {
  return {
    id: stringValue(item, 'id'),
    title: stringValue(item, 'title'),
    categoryCode: stringValue(item, 'category_code'),
    priceDisplay: stringValue(item, 'price_display'),
    durationMinutes: numberValue(item, 'duration_minutes'),
    coverUrl: mediaUrl(item['cover_media'])
  }
}

// 返回本人可挂载到动态的已上架服务。
export function getMomentMountableServices(): Promise<MomentMountableServiceListResult> {
  return apiGet('/provider-moments/mountable-services/').then((result: HttpResult) => {
    if (result.statusCode < 200 || result.statusCode >= 300 || businessCode(result.body) != 0) {
      return {
        ok: false,
        code: 'MOMENT_MOUNTABLE_FAILED',
        message: businessMessage(result),
        items: []
      }
    }
    const data = payload(result.body)
    let source = data['items']
    if (source == null) {
      source = data
    }
    const items: MomentMountableServiceItem[] = []
    if (source != null) {
      for (let i = 0; i < source.length; i++) {
        items.push(mapMountable(source[i]))
      }
    }
    return {
      ok: true,
      code: 'MOMENT_MOUNTABLE_LOADED',
      message: '可挂载服务已加载',
      items: items
    }
  })
}
