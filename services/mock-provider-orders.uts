function persistOrders() {
  const next: Array<ProviderOrderItem> = []
  for (let i = 0; i < orders.length; i++) {
    next.push(copyOrder(orders[i]))
  }
  uni.setStorageSync(ORDERS_KEY, JSON.stringify(next))
}

function ensureOrdersLoaded() {
  if (ordersLoaded) {
    return
  }
  ordersLoaded = true
  const raw = uni.getStorageSync(ORDERS_KEY)
  if (typeof raw == 'string' && raw.length > 0) {
    try {
      const saved = JSON.parse(raw) as Array<ProviderOrderItem>
      if (saved.length > 0) {
        orders = saved
        return
      }
    } catch (e) {
      uni.removeStorageSync(ORDERS_KEY)
    }
  }
  orders = createDefaultOrders()
  persistOrders()
}

function findOrderIndex(id: string): number {
  for (let i = 0; i < orders.length; i++) {
    if (orders[i].id == id) {
      return i
    }
  }
  return -1
}

function replaceStatus(id: string, status: string) {
  const next: Array<ProviderOrderItem> = []
  for (let i = 0; i < orders.length; i++) {
    const item = copyOrder(orders[i])
    if (item.id == id) {
      item.status = status
    }
    next.push(item)
  }
  orders = next
  persistOrders()
}

export function getProviderOrderItems(tab: string): Array<ProviderOrderItem> {
  ensureOrdersLoaded()
  const result: Array<ProviderOrderItem> = []
  for (let i = 0; i < orders.length; i++) {
    if (tab == '全部' || orders[i].status == tab) {
      result.push(copyOrder(orders[i]))
    }
  }
  return result
}

export function acceptProviderOrder(id: string): ActionOutcome {
  ensureOrdersLoaded()
  const index = findOrderIndex(id)
  if (index < 0) {
    return {
      ok: false,
      code: 'PROVIDER_ORDER_NOT_FOUND',
      message: '未找到该订单'
    }
  }
  if (orders[index].status != '待接单') {
    return {
      ok: false,
      code: 'PROVIDER_ORDER_INVALID_STATUS',
      message: '当前订单不能接单'
    }
  }
  replaceStatus(id, '待履约')
  return {
    ok: true,
    code: 'PROVIDER_ORDER_ACCEPTED',
    message: '已接单，请按预约时间履约'
  }
}

export function rejectProviderOrder(id: string): ActionOutcome {
  ensureOrdersLoaded()
  const index = findOrderIndex(id)
  if (index < 0) {
    return {
      ok: false,
      code: 'PROVIDER_ORDER_NOT_FOUND',
      message: '未找到该订单'
    }
  }
  if (orders[index].status != '待接单') {
    return {
      ok: false,
      code: 'PROVIDER_ORDER_INVALID_STATUS',
      message: '当前订单不能拒绝'
    }
  }
  replaceStatus(id, '已取消')
  return {
    ok: true,
    code: 'PROVIDER_ORDER_REJECTED',
    message: '已拒绝该订单'
  }
}

export function completeProviderOrder(id: string): ActionOutcome {
  ensureOrdersLoaded()
  const index = findOrderIndex(id)
  if (index < 0) {
    return {
      ok: false,
      code: 'PROVIDER_ORDER_NOT_FOUND',
      message: '未找到该订单'
    }
  }
  if (orders[index].status != '待履约' && orders[index].status != '进行中') {
    return {
      ok: false,
      code: 'PROVIDER_ORDER_INVALID_STATUS',
      message: '当前订单不能确认完成'
    }
  }
  replaceStatus(id, '已完成')
  return {
    ok: true,
    code: 'PROVIDER_ORDER_COMPLETED',
    message: '订单已确认完成'
  }
}

export function getProviderOrderDetail(id: string): ProviderOrderDetail {
  ensureOrdersLoaded()
  let order = copyOrder(orders[0])
  for (let i = 0; i < orders.length; i++) {
    if (orders[i].id == id) {
      order = copyOrder(orders[i])
      break
    }
  }

  const timeline: Array<ProviderOrderTimelineItem> = [
    {
      title: '用户提交预约',
      description: '订单已创建并完成支付',
      time: '10月27日 13:26',
      state: 'done'
    },
    {
      title: '等待服务者接单',
      description: '请确认时间、地点和服务内容',
      time: order.status == '待接单' ? '当前节点' : '10月27日 13:28',
      state: order.status == '待接单' ? 'current' : 'done'
    },
    {
      title: '等待履约',
      description: '按预约时间到达公共经营场所',
      time: order.status == '待接单' ? '' : order.status == '待履约' ? '当前节点' : '10月27日 13:30',
      state: order.status == '待接单' ? 'future' : order.status == '待履约' ? 'current' : 'done'
    },
    {
      title: '服务进行中',
      description: '见面后开始提供服务',
      time: order.status == '进行中' ? '当前节点' : order.status == '已完成' ? '10月27日 15:31' : '',
      state: order.status == '进行中' ? 'current' : order.status == '已完成' ? 'done' : 'future'
    },
    {
      title: '订单完成',
      description: '服务完成并确认订单结果',
      time: order.status == '已完成' ? '已完成' : '',
      state: order.status == '已完成' ? 'done' : 'future'
    }
  ]

  return {
    order: order,
    timeline: timeline
  }
}
